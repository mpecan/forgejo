-- Pull requests ---------------------------------------------------

-- Pending reviews and review-request markers are not announced.
-- from: services/webhook/notifier.go:698
rule ReviewSubmittedRaisesHookEvent {
    when: pulls/ReviewSubmitted(review)
    requires: review.kind in {approve, comment, reject}
    ensures: HookEventRaised(
        kind: if review.kind = approve: pull_request_review_approved
              else: if review.kind = reject: pull_request_review_rejected
              else: pull_request_review_comment,
        action: reviewed, source_repo: review.pull_request.issue.repository, sender: review.reviewer)
}

-- from: services/webhook/notifier.go:742
rule ReviewRequestedRaisesHookEvent {
    when: pulls/ReviewRequested(pr, doer, reviewer)
    ensures: HookEventRaised(kind: pull_request_review_request, action: review_requested, source_repo: pr.issue.repository, sender: doer)
}

-- from: services/webhook/notifier.go:742
rule ReviewRequestRemovedRaisesHookEvent {
    when: pulls/ReviewRequestRemoved(pr, doer, reviewer)
    ensures: HookEventRaised(kind: pull_request_review_request, action: review_request_removed, source_repo: pr.issue.repository, sender: doer)
}

-- New commits on the head branch.
-- from: services/webhook/notifier.go:785
rule SynchronizeRaisesHookEvent {
    when: pulls/PullRequestSynchronized(pr, doer)
    ensures: HookEventRaised(kind: pull_request_sync, action: synchronized, source_repo: pr.issue.repository, sender: doer)
}

