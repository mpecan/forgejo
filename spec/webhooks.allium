-- from: services/webhook/notifier.go:673
rule TargetBranchChangeRaisesHookEvent {
    when: pulls/PullRequestTargetBranchChanged(pr, doer, old_branch)
    ensures: HookEventRaised(kind: pull_request, action: edited, source_repo: pr.issue.repository, sender: doer)
