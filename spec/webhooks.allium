        owner_user: null,
        owner_org: null,
        branch: null,
        commit_count: null,
        sender: doer
    )
}

-- Pull requests ---------------------------------------------------

-- Pending reviews and review-request markers are not announced.
-- decided (webhooks 3): all three kinds are selected by the
-- pull_request_review choice (Forgejo's checker used pull_request_comment
-- for review comments).
-- from: services/webhook/notifier.go:698
rule ReviewSubmittedRaisesHookEvent {
    when: pulls/ReviewSubmitted(review)
    requires: review.status = submitted
    requires: review.kind in {approve, comment, request_changes}
    ensures: HookEventRaised(
        kind: if review.kind = approve: pull_request_review_approved
              else: if review.kind = request_changes: pull_request_review_rejected
              else: pull_request_review_comment,
        action: reviewed,
        source_repo: review.pull_request.issue.repository,
        owner_user: null,
        owner_org: null,
        branch: null,
        commit_count: null,
        sender: review.reviewer
    )
}

-- from: services/webhook/notifier.go:742
rule ReviewRequestedRaisesHookEvent {
    when: pulls/ReviewRequested(pull_request, requester, reviewer)
    ensures: HookEventRaised(kind: pull_request_review_request, action: review_requested, source_repo: pull_request.issue.repository, owner_user: null, owner_org: null, branch: null, commit_count: null, sender: requester)
}

-- from: services/webhook/notifier.go:742
rule ReviewRequestRemovedRaisesHookEvent {
    when: pulls/ReviewRequestRemoved(pull_request, doer, reviewer)
    ensures: HookEventRaised(kind: pull_request_review_request, action: review_request_removed, source_repo: pull_request.issue.repository, owner_user: null, owner_org: null, branch: null, commit_count: null, sender: doer)
}

-- New commits on the head branch.
-- from: services/webhook/notifier.go:785
rule SynchronizeRaisesHookEvent {
    when: pulls/PullRequestSynchronized(pull_request, doer)
    ensures: HookEventRaised(kind: pull_request_sync, action: synchronized, source_repo: pull_request.issue.repository, owner_user: null, owner_org: null, branch: null, commit_count: null, sender: doer)
}

