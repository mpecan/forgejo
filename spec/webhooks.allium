-- A package linked to a repository reaches that repository's hooks too.
-- from: services/webhook/notifier.go:1095
rule PackageVersionCreatedRaisesHookEvent {
    when: packages/PackageVersionCreated(version, doer)
    ensures: HookEventRaised(
