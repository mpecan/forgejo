-- Manual and automatic merges alike; the payload marks the PR merged.
-- from: services/webhook/notifier.go:636
rule MergeRaisesHookEvent {
    when: pulls/PullRequestMerged(pr, merger)
    ensures: HookEventRaised(kind: pull_request, action: closed, source_repo: pr.issue.repository, sender: merger)
