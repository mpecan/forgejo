}

-- decided (releases 2): un-publishing raises a release event; Forgejo had none.
-- With no doer (the tag vanished during a sync) the publisher is the sender.
rule ReleaseUnpublishedRaisesHookEvent {
    when: releases/ReleaseUnpublished(release, doer)
    ensures: HookEventRaised(kind: release, action: unpublished, source_repo: release.repository, owner_user: null, owner_org: null, branch: null, commit_count: null, sender: if doer = null: release.publisher else: doer)
