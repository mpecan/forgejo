-- allium: 3
-- webhooks.allium — outbound HTTP notifications of repository, owner and instance events to external services
--
-- Scope: Webhooks at four levels (repository, owner = user or organization,
--   instance-wide "system" hooks, and admin "default" hooks that are copied into
--   every new repository); the target kinds and their per-kind settings; event
--   selection, branch filtering, secrets/HMAC signatures and Authorization
--   headers; turning domain events from other modules into deliveries; the
--   delivery pipeline (queue, attempts with automatic retry and backoff,
--   timeout, SSRF host allow-list, proxy, TLS); delivery history, the
--   instance-wide delivery log, manual redelivery and test deliveries; the
--   nightly cleanup of delivery history; who may manage which webhooks.
-- Includes: Webhook, HookDelivery, HookEventKind, HookEventChoice, HookKind,
--   WebhookConfig, HookTargetSettings, HookRequest, HookResponse.
-- Excludes:
--   - Server-side git hooks (pre-receive/update/post-receive scripts edited in
--     repo settings "Git hooks"): owned by code.allium.
--   - The exact JSON/form payload schemas per event and the per-kind message
--     formatting (Slack/Discord/MS Teams/... text, colours, links): treated as a
--     black box render_request(); payload schema belongs to the API contract,
--     not to behaviour.
--   - Legacy "payload version 1" deliveries (stored pre-rendered bodies) and the
--     Gitea short-ref substitution quirk: data-migration concerns only.
--   - Duplicate compatibility headers X-Gitea-*, X-Gogs-*, X-GitHub-*: only the
--     canonical X-Forgejo-* and the de-facto standard X-Hub-Signature(-256)
--     headers are specified (see contract SignedDelivery).
--   - Deprecated action_run_success / action_run_failure events (marked "can be
--     removed after Forgejo 19"); superseded by workflow_run_* events.
--   - API "config" map on hook objects (documented as deprecated, kept only for
--     compatibility).
--   - Worker-queue sizing (QUEUE_LENGTH) and in-process de-duplication of queue
--     items: infrastructure.
--   - Mapping stored Forgejo `gitea` / `gogs` hooks onto the native kind when
--     importing an existing instance: the import addon (decided: webhooks 10).
--
-- Emits: (internal only — nothing outside this module reacts to them)
--   HookEventRaised(kind, action, source_repo?, owner_user?, owner_org?, branch?, commit_count?, sender?)
--   HookEventMatched(webhook, kind, action, branch?, commit_count?)
--   HookDeliveryQueued(delivery)
--   HookDeliveryCompleted(delivery)      -- succeeded, failed or skipped
--
-- Reacts to:
--   code/PushReceived(push)                               -> push (one per pushed branch or tag)
--   code/RefCreated(repository, pusher, ref_kind, ref_name, commit_sha)  -> create
--   code/RefDeleted(repository, pusher, ref_kind, ref_name)              -> delete
--   repositories/MirrorSyncPushed(repository, ref_name, commits)          -> push (pull-mirror sync, sender: owner)
--   repositories/MirrorRefCreated(repository, ref_name)                   -> create (pull-mirror sync, sender: owner)
--   repositories/MirrorRefDeleted(repository, ref_name)                   -> delete (pull-mirror sync, sender: owner)
--   repositories/RepositoryCreated(repository, doer)      -> repository/created (not for an import's reserved record)
--   migrations/RepositoryMigrated(repository)             -> repository/created (sender: the migration's doer)
--   repositories/RepositoryForked(source, fork, doer)     -> fork (+ repository/created for org forks)
--   repositories/RepositoryDeletionAnnounced(repository, doer, owner_user, owner_org) -> repository/deleted
--       (owner and system hooks; the owner the repository had)
--   repositories/RepositoryDeleted(repository, doer)      -> removes repo webhooks
--   repositories/Repository.created                       -> copy default webhooks
--   repositories/RepositoryGeneratedFromTemplate(template, repository, doer, git_content, topics,
--       git_hooks, webhooks, avatar, labels, protected_branches)  -> copy template webhooks when `webhooks`
--   issues/IssueOpened(issue, mentions)                   -> issues/opened
--   issues/IssueTitleChanged(issue, doer, old_title)      -> issues|pull_request/edited
--   issues/IssueContentChanged(issue, doer, old_content)  -> issues|pull_request/edited
--   issues/IssueClosed(issue, doer, comment), issues/IssueReopened(issue, doer, comment)  -> issues
--   pulls/PullRequestClosed(pull_request, doer), pulls/PullRequestReopened(pull_request, doer)  -> pull_request
--   issues/IssueAssigneeChanged(issue, doer, assignee, removed, comment)  -> assigned / unassigned
--   issues/IssueLabelsChanged(issue, doer, added, removed), issues/IssueLabelsCleared(issue, doer)
--   issues/IssueMilestoneChanged(issue, doer, old_milestone)
--   issues/IssueCommentCreated(issue, comment, doer, mentions), issues/IssueCommentEdited(comment, doer, old_content),
--   issues/IssueCommentDeleted(comment, doer)
--   pulls/PullRequestOpened(pull_request), pulls/PullRequestMerged(pull_request, merger) (also emitted for auto-merges),
--   pulls/PullRequestTargetBranchChanged(pull_request, doer, old_base_branch),
--   pulls/PullRequestSynchronized(pull_request, doer), pulls/ReviewSubmitted(review),
--   pulls/ReviewRequested(pull_request, requester, reviewer), pulls/ReviewRequestRemoved(pull_request, doer, reviewer)
--   wiki/WikiPageCreated(repository, doer, page), wiki/WikiPageEdited(...), wiki/WikiPageDeleted(...)
--   releases/ReleasePublished(release), releases/ReleaseUpdated(release, doer), releases/ReleaseDeleted(release, doer),
--   releases/ReleaseUnpublished(release, doer)
--   packages/PackageVersionCreated(version, publisher), packages/PackageVersionDeleted(version, package, doer)
--   actions/WorkflowRunStatusChanged(run, prior_status), actions/WorkflowRunCompleted(run, prior_status),
--   actions/WorkflowJobStatusChanged(job, prior_status), actions/WorkflowJobCompleted(job, prior_status),
--   actions/WorkflowRunAttemptStarted(run), actions/WorkflowJobAttemptStarted(job)  -> the new attempt's status
--   accounts/UserAccountDeleted(user, kind, purge, delete_contributions), organizations/OrganizationDeleted(organization)
--   administration/HookDeliveryCleanupDue(cleanup_type, older_than, number_to_keep)  -> history cleanup "run now"
--
-- Black-box predicates (each the local name of another module's contract):
--   is_repo_admin(user, repository)    = access/is_repo_admin(user, repository)
--   is_org_owner(organization, user)   = organizations/is_org_owner(organization, user)
--   is_branch_ref(ref_name), branch_of_ref(ref_name) = code: refs/heads/<name> and its <name>
--   mirror_pusher(repository)          = repositories/mirror_pusher(repository): the owning user
--                                        or organisation account mirror updates are attributed to
--
-- Read-only mode: creating, editing, deleting, testing and redelivering a
-- repository, organisation or user webhook is refused while
-- access/InstanceWriteGate.read_only; system and default webhooks live in the
-- site administration console, which stays writable (decided: administration
-- 3). Deliveries of events keep flowing: they are not people's writes.
--
-- Deploy-key pushes (decided: code 4): code reports pusher = null and names
-- the key in push.deploy_key; the push / create / delete payload's sender is
-- then the deploy key (its name and repository), never the repository owner.

use "./accounts.allium" as accounts
use "./organizations.allium" as organizations
use "./repositories.allium" as repositories
use "./access.allium" as access
use "./code.allium" as code
use "./issues.allium" as issues
use "./pulls.allium" as pulls
use "./wiki.allium" as wiki
use "./releases.allium" as releases
use "./packages.allium" as packages
use "./actions.allium" as actions
use "./migrations.allium" as migrations
use "./administration.allium" as administration

------------------------------------------------------------
-- External Entities
------------------------------------------------------------

-- The HTTP endpoint on the other side of a delivery. It is not a user of the
-- forge; it only answers requests.
-- from: services/webhook/deliver.go:112
external entity ReceivingService {
    base_url: String
}

------------------------------------------------------------
-- Value Types
------------------------------------------------------------

value HookHeader {
    name: String
    value: String
}

-- What was sent. Recorded on the delivery for the history view. The
-- Authorization header value is redacted to "******" (keeping a "Bearer " or
-- "Basic " prefix) before it is recorded.
-- from: models/webhook/hooktask.go:30
value HookRequest {
    url: String
    method: HookHttpMethod
    headers: Set<HookHeader>
    body: String
}

-- What came back. On a transport failure (timeout, refused host, TLS error)
-- status_code is absent and body carries the error text.
-- from: models/webhook/hooktask.go:38
value HookResponse {
    status_code: Integer?
    headers: Set<HookHeader>
    body: String
}

-- Per-kind settings. Only the group belonging to the webhook's kind is set
-- (see invariant KindSettingsMatchKind).
-- from: services/webhook/slack.go:32
value HookTargetSettings {
    -- slack: channel must match ^#?[a-z0-9_-]{1,80}$
    slack_channel: String?
    slack_username: String?
    slack_icon_url: String?
    slack_color: String?
    -- discord: username required, max 80 characters; icon URL max 2048 characters
    discord_username: String?
    discord_icon_url: String?
    -- telegram: target URL is derived from bot token, chat id and optional thread id
    telegram_bot_token: String?
    telegram_chat_id: String?
    telegram_thread_id: String?
    -- matrix: target URL is derived from homeserver and room; access token becomes
    -- "Authorization: Bearer <token>"
    matrix_homeserver_url: String?
    matrix_room_id: String?
    matrix_message_type: MatrixMessageType?
    -- packagist: target URL derived from username + API token; package_url is the payload
    packagist_username: String?
    packagist_api_token: String?
    packagist_package_url: String?
    -- sourcehut builds: manifest submitted as a GraphQL job; access token becomes
    -- "Authorization: Bearer <token>"
    sourcehut_manifest_path: String?
    sourcehut_visibility: SourcehutVisibility?
    sourcehut_secrets: Boolean?
}


------------------------------------------------------------
-- Contracts
------------------------------------------------------------

-- What every receiver of a native (forgejo) delivery can rely on,
-- and what chat-style kinds (slack, discord, dingtalk, telegram, msteams,
-- feishu, matrix, wechatwork) also carry. packagist and sourcehut_builds send
-- only their service-specific request.
-- from: services/webhook/shared/payloader.go:140
contract SignedDelivery {
    deliver: (request: HookRequest) -> HookResponse

    @invariant IdentifyingHeaders
        -- X-Forgejo-Delivery: the delivery's unique id (stable across the
        -- delivery's automatic retries, new on redelivery); X-Forgejo-Event: the coarse event name
        -- (e.g. issue_assign -> "issues", pull_request_sync -> "pull_request",
        -- pull_request_comment -> "issue_comment", review approved ->
        -- "pull_request_approved"); X-Forgejo-Event-Type: the precise
        -- HookEventKind.

    @invariant HmacSignature
        -- When the webhook has a secret, X-Forgejo-Signature and
        -- X-Hub-Signature-256 ("sha256=" prefix) carry the hex HMAC-SHA256 of
        -- the exact request body keyed by the secret; X-Hub-Signature
        -- ("sha1=" prefix) carries HMAC-SHA1. Without a secret the signature
        -- headers are empty.

    @invariant AuthorizationHeader
        -- When an authorization header is configured it is sent verbatim as
        -- the HTTP Authorization header.

    @invariant SuccessIsTwoHundreds
        -- Any 2xx status code counts as success; everything else, including
        -- redirects that are not followed to a 2xx, is a failure.
}

-- How the body is shaped from the stored event for each kind.
-- from: services/webhook/default.go:67
contract HookRequestRendering {
    render: (webhook: Webhook, delivery: HookDelivery) -> HookRequest

    @invariant GenericBodies
        -- forgejo: the event JSON; content_type json sends it as
        -- the body, form sends it url-encoded as field "payload"; method GET
        -- sends it as query parameter "payload" with no body.

    @invariant ChatKinds
        -- slack, discord, dingtalk, telegram, msteams, feishu, matrix,
        -- wechatwork: a human-readable message built from the event, JSON
        -- body. matrix uses PUT to the room send endpoint with a per-delivery
        -- transaction id; message type m.notice or m.text.

    @invariant ServiceKinds
        -- packagist: {"repository":{"url": package_url}} for every event.
        -- sourcehut_builds: reads the manifest at manifest_path from the
        -- pushed commit (push and create events only) and submits it as a
        -- GraphQL job with the configured visibility and secrets flag.

    @invariant UnsupportedEvents
        -- decided (webhooks 2): kinds that cannot express an event (e.g.
        -- sourcehut_builds for anything but push/create) produce no delivery
        -- for it: the event is dropped at queue time (kind_supports), and the
        -- hook form offers only the events the kind supports
        -- (kind_supports_choice). Forgejo created a delivery that stayed
        -- undelivered for ever.
}

------------------------------------------------------------
-- Enumerations
------------------------------------------------------------

-- decided (webhooks 10): one native kind (forgejo) plus the chat/CI
-- integrations; Forgejo's gitea and gogs dialect kinds are dropped.
-- from: modules/webhook/type.go:126
enum HookKind {
    forgejo | slack | discord | dingtalk | telegram | msteams
    | feishu | matrix | wechatwork | packagist | sourcehut_builds
}

-- from: models/webhook/webhook.go:67
enum HookContentType { json | form }

enum HookHttpMethod { post | get | put }

-- from: modules/webhook/structs.go:47
enum HookEventMode { push_only | send_everything | choose_events }

-- Where the webhook lives.
-- from: models/webhook/webhook.go:124
enum WebhookScope { per_repository | per_owner | system | default }

-- Last delivery outcome shown in lists.
-- from: modules/webhook/type.go:146
enum HookLastStatus { none | succeeded | failed }

enum MatrixMessageType { notice | text }

enum SourcehutVisibility { public | unlisted | private }

-- The precise kind of event a delivery carries (X-Forgejo-Event-Type).
-- from: modules/webhook/type.go:12
enum HookEventKind {
    create | delete | fork | push
    | issues | issue_assign | issue_label | issue_milestone | issue_comment
    | pull_request | pull_request_assign | pull_request_label | pull_request_milestone
    | pull_request_comment | pull_request_review_approved | pull_request_review_rejected
    | pull_request_review_comment | pull_request_sync | pull_request_review_request
    | wiki | repository | release | package
    | workflow_run_blocked | workflow_run_cancelled | workflow_run_failure | workflow_run_running
    | workflow_run_skipped | workflow_run_success | workflow_run_waiting
    | workflow_job_blocked | workflow_job_cancelled | workflow_job_failure | workflow_job_running
    | workflow_job_skipped | workflow_job_success | workflow_job_waiting
}

-- What a manager can tick in "choose events". Identical to HookEventKind except
-- that the three review outcomes share one choice, pull_request_review.
-- choice_of(kind) maps a kind to its choice.
-- from: modules/webhook/structs.go:7
enum HookEventChoice {
    create | delete | fork | push
    | issues | issue_assign | issue_label | issue_milestone | issue_comment
    | pull_request | pull_request_assign | pull_request_label | pull_request_milestone
    | pull_request_comment | pull_request_review | pull_request_sync | pull_request_review_request
    | wiki | repository | release | package
    | workflow_run_blocked | workflow_run_cancelled | workflow_run_failure | workflow_run_running
    | workflow_run_skipped | workflow_run_success | workflow_run_waiting
    | workflow_job_blocked | workflow_job_cancelled | workflow_job_failure | workflow_job_running
    | workflow_job_skipped | workflow_job_success | workflow_job_waiting
}

-- The "action" field of the payload: what happened within the event kind.
-- from: modules/structs/hook.go (HookIssueAction, HookRepoAction, ...)
enum HookAction {
    opened | edited | closed | reopened | assigned | unassigned
    | label_updated | label_cleared | milestoned | demilestoned
    | synchronized | reviewed | review_requested | review_request_removed
    | created | deleted | published | unpublished | updated | pushed | forked
    | status_changed
}

------------------------------------------------------------
-- Entities and Variants
------------------------------------------------------------

-- Everything a manager sets on a webhook: the submitted form (web) or hook
-- option (API). A webhook holds exactly one; editing replaces it.
-- from: services/forms/repo_form.go:261
entity WebhookConfig {
    kind: HookKind
    target_url: String
    http_method: HookHttpMethod
    content_type: HookContentType
    secret: String?                        -- HMAC key; only forgejo; write-only
    authorization_header: String?          -- sent verbatim as Authorization header; write-only
    event_mode: HookEventMode
    chosen_events: Set<HookEventChoice>    -- meaningful only with choose_events
    branch_filter: String?                 -- glob; empty or "*" means all branches
    settings: HookTargetSettings

    is_generic: kind = forgejo

    -- Validation shared by every create/edit path (web form and API).
    -- decided (webhooks 2): only events the kind supports may be chosen.
    -- from: services/webhook/default.go:46
    is_valid:
        is_valid_http_url(target_url)
        and (branch_filter = null or is_valid_glob(branch_filter))
        and (kind = forgejo implies http_method in {post, get})
        and (kind = matrix implies http_method = put)
        and chosen_events.all(c => kind_supports_choice(kind, c))
        and ((not is_generic and kind != matrix) implies http_method = post)
        and ((not is_generic) implies (content_type = json and secret = null))
        and (kind = slack implies (settings.slack_channel != null and is_valid_slack_channel(settings.slack_channel)))
        and (kind = discord implies (settings.discord_username != null and length(settings.discord_username) <= 80))
        and (kind = discord implies (settings.discord_icon_url = null or length(settings.discord_icon_url) <= 2048))
        and (kind = telegram implies (settings.telegram_bot_token != null and settings.telegram_chat_id != null))
        and (kind = matrix implies (settings.matrix_homeserver_url != null and settings.matrix_room_id != null and authorization_header != null))
        and (kind = packagist implies (settings.packagist_username != null and settings.packagist_api_token != null and settings.packagist_package_url != null))
        and (kind = sourcehut_builds implies (settings.sourcehut_manifest_path != null and is_valid_relative_path(settings.sourcehut_manifest_path) and settings.sourcehut_visibility != null and authorization_header != null))
}

-- from: models/webhook/webhook.go:122
entity Webhook {
    scope: WebhookScope
    repository: repositories/Repository?          -- set iff scope = per_repository
    owner_user: accounts/User?                     -- scope = per_owner, a personal account
    owner_org: organizations/Organization?         -- scope = per_owner, an organization
    config: WebhookConfig
    is_active: Boolean
    -- decided (webhooks 5): set on a copy of a default or template webhook
    -- whose Authorization header was dropped; it does not fire until a
    -- manager edits it (re-authorises it).
    needs_reauthorization: Boolean
    last_status: HookLastStatus
    created_at: Timestamp
    updated_at: Timestamp

    deliveries: HookDelivery with webhook = this
    finished_deliveries: deliveries where status in {succeeded, failed, skipped}

    is_admin_level: scope in {system, default}
    -- Default hooks are templates: they never fire themselves.
    -- from: services/webhook/webhook.go:270
    can_fire: is_active and scope != default and not needs_reauthorization
    history_over_limit: finished_deliveries.count > config.cleanup_keep_count
}

-- One event sent to one webhook ("hook task").
-- decided (webhooks 9): a delivery that meets a network error, a timeout or a
-- 5xx answer is retried automatically with exponential backoff, up to
-- config.max_delivery_attempts attempts in all (Forgejo made one attempt).
-- Manual redelivery still creates a new delivery.
-- from: models/webhook/hooktask.go:45
entity HookDelivery {
    webhook: Webhook
    delivery_id: String              -- unique, sent as X-Forgejo-Delivery
    event: HookEventKind
    action: HookAction?
    payload: String                  -- the event as captured when it happened
    is_test: Boolean
    created_at: Timestamp
    status: queued | sending | retrying | succeeded | failed | skipped
    attempts: Integer                -- attempts made so far
    sent_at: Timestamp?
    next_attempt_at: Timestamp?      -- set while retrying
    finished_at: Timestamp?
    request: HookRequest?
    response: HookResponse?

    transitions status {
        queued -> sending
        queued -> skipped
        queued -> failed
        sending -> succeeded
        sending -> failed
        sending -> retrying
        retrying -> queued
        terminal: succeeded, failed, skipped
    }

    is_finished: status in {succeeded, failed, skipped}
    -- another attempt is allowed after this one fails
    may_retry: attempts < config.max_delivery_attempts
    -- from: services/webhook/deliver.go:499
    is_overdue: if status = sending: sent_at + config.deliver_timeout <= now else: false
    is_retry_due: if status = retrying: next_attempt_at <= now else: false
    -- from: models/webhook/hooktask.go:205
    is_expired: if is_finished: finished_at + config.cleanup_older_than <= now else: false
}

------------------------------------------------------------
-- Config
------------------------------------------------------------

config {
    -- [security] DISABLE_WEBHOOKS: hides all webhook management and stops
    -- creating and sending deliveries.
    -- from: modules/setting/security.go:508
    disable_webhooks: Boolean = false
    -- [webhook] DELIVER_TIMEOUT (seconds)
    -- from: modules/setting/webhook.go:24
    deliver_timeout: Duration = 5.seconds
    -- decided (webhooks 9): attempts per delivery (first one included) and
    -- the wait before the second attempt; each further wait doubles.
    max_delivery_attempts: Integer = 3
    retry_backoff_base: Duration = 10.seconds
    -- [webhook] SKIP_TLS_VERIFY
    skip_tls_verify: Boolean = false
    -- [webhook] ALLOWED_HOST_LIST: comma list of "loopback", "private",
    -- "external", "*", CIDRs and host globs. Empty means "external" (only
    -- public, non-private, non-loopback addresses).
    -- from: services/webhook/deliver.go:173
    allowed_host_list: String = "external"
    -- [webhook] PAGING_NUM: deliveries per history page
    history_page_size: Integer = 10
    -- [webhook] PROXY_URL / PROXY_HOSTS: deliveries to hosts matching one of
    -- the PROXY_HOSTS globs go through PROXY_URL; others use the environment proxy.
    proxy_url: String = ""
    proxy_hosts: String = ""
    -- [webhook] PAYLOAD_COMMIT_LIMIT: commits listed in a push payload (the
    -- total count is still reported)
    payload_commit_limit: Integer = 15
    -- [cron.cleanup_hook_task_table]
    -- from: services/cron/tasks_basic.go:129
    cleanup_enabled: Boolean = true
    cleanup_schedule: String = "@midnight"
    cleanup_run_at_start: Boolean = false
    cleanup_type: String = "older_than"         -- "older_than" | "per_webhook" (administration/HookCleanupKind)
    cleanup_older_than: Duration = 7.days
    cleanup_keep_count: Integer = 10
}

------------------------------------------------------------
-- Rules — managing webhooks
------------------------------------------------------------

-- from: routers/web/repo/setting/webhook.go:199
rule RepoAdminCreatesWebhook {
    when: RepoAdminCreatesWebhook(actor, repo, hook_config, is_active)
    requires: not (exists access/InstanceWriteGate{read_only: true})   -- decided: administration 3 (read-only mode refuses every write)
    requires: not config.disable_webhooks
    requires: is_repo_admin(actor, repo)
    requires: hook_config.is_valid
    ensures: Webhook.created(
        scope: per_repository,
        repository: repo,
        config: hook_config,
        is_active: is_active,
        needs_reauthorization: false,
        last_status: none,
        created_at: now,
        updated_at: now
    )
    @guidance
        -- Web: GET/POST {repo}/settings/hooks/{kind}/new.
        -- API: POST /repos/{owner}/{repo}/hooks (token, repo admin).
        -- decided (webhooks 4): the API takes the full WebhookConfig, the
        -- same fields as the web form (method, event mode, every event
        -- choice, branch filter, per-kind settings). Forgejo's API forced
        -- POST and choose_events.
}

-- from: routers/api/v1/utils/hook.go:110
rule OrgOwnerCreatesWebhook {
    when: OrgOwnerCreatesWebhook(actor, organization, hook_config, is_active)
    requires: not (exists access/InstanceWriteGate{read_only: true})   -- decided: administration 3 (read-only mode refuses every write)
    requires: not config.disable_webhooks
    requires: is_org_owner(organization, actor) or actor.is_admin
    requires: hook_config.is_valid
    ensures: Webhook.created(
        scope: per_owner,
        owner_org: organization,
        config: hook_config,
        is_active: is_active,
        needs_reauthorization: false,
        last_status: none,
        created_at: now,
        updated_at: now
    )
    @guidance
        -- Web: {org}/settings/hooks/{kind}/new. API: POST /orgs/{org}/hooks
        -- (token, org owner). Fires for events in every repository of the
        -- organization and for organization-owned packages.
}

-- from: routers/api/v1/user/hook.go:87
rule UserCreatesOwnWebhook {
    when: UserCreatesOwnWebhook(actor, hook_config, is_active)
    requires: not (exists access/InstanceWriteGate{read_only: true})   -- decided: administration 3 (read-only mode refuses every write)
    requires: not config.disable_webhooks
    requires: actor.is_active and not actor.prohibit_login
    requires: hook_config.is_valid
    ensures: Webhook.created(
        scope: per_owner,
        owner_user: actor,
        config: hook_config,
        is_active: is_active,
        needs_reauthorization: false,
        last_status: none,
        created_at: now,
        updated_at: now
    )
    @guidance
        -- Web: /user/settings/hooks/{kind}/new. API: POST /user/hooks.
        -- Fires for events in every repository the user owns and for
        -- user-owned packages.
}

-- System hooks fire for every event on the instance.
-- from: routers/web/repo/setting/webhook.go:103
rule AdminCreatesSystemWebhook {
    when: AdminCreatesSystemWebhook(actor, hook_config, is_active)
    requires: not config.disable_webhooks
    requires: actor.is_admin
    requires: hook_config.is_valid
    ensures: Webhook.created(
        scope: system,
        config: hook_config,
        is_active: is_active,
        needs_reauthorization: false,
        last_status: none,
        created_at: now,
        updated_at: now
    )
    @guidance
        -- Web: /admin/system-hooks/{kind}/new. API: POST /admin/hooks with
        -- config.is_system_webhook = "true".
}

-- Default hooks never fire; they are copied into each new repository.
-- from: routers/web/repo/setting/webhook.go:127
rule AdminCreatesDefaultWebhook {
    when: AdminCreatesDefaultWebhook(actor, hook_config, is_active)
    requires: not config.disable_webhooks
    requires: actor.is_admin
    requires: hook_config.is_valid
    ensures: Webhook.created(
        scope: default,
        config: hook_config,
        is_active: is_active,
        needs_reauthorization: false,
        last_status: none,
        created_at: now,
        updated_at: now
    )
    @guidance
        -- Web: /admin/default-hooks/{kind}/new. API: POST /admin/hooks
        -- without is_system_webhook (or "false").
}

-- decided (webhooks 4): an edit, from the web or the API, changes only the
-- fields given; hook_config is the stored configuration with those fields
-- applied. The secret and the Authorization header can be replaced or
-- cleared but are never read back (decided: webhooks 7). The kind cannot
-- change. Any edit re-authorises a copied webhook (decided: webhooks 5).
-- from: routers/web/repo/setting/webhook.go:282
rule ManagerEditsWebhook {
    when: ManagerEditsWebhook(actor, webhook, hook_config, is_active)
    requires: webhook.is_admin_level or not (exists access/InstanceWriteGate{read_only: true})   -- decided: administration 3 (read-only mode refuses every write)
    requires: not config.disable_webhooks
    let may_manage =
        if webhook.scope = per_repository: is_repo_admin(actor, webhook.repository)
        else: if webhook.scope = per_owner and webhook.owner_user != null: webhook.owner_user = actor
        else: if webhook.scope = per_owner and webhook.owner_org != null: is_org_owner(webhook.owner_org, actor) or actor.is_admin
        else: webhook.is_admin_level and actor.is_admin
    requires: may_manage
    requires: hook_config.kind = webhook.config.kind
    requires: hook_config.is_valid
    ensures: webhook.config = hook_config
    ensures: webhook.is_active = is_active
    ensures: webhook.needs_reauthorization = false
    ensures: webhook.updated_at = now
    @guidance
        -- Web: POST {base}/hooks/{id}. API: PATCH /repos/{o}/{r}/hooks/{id},
        -- /orgs/{org}/hooks/{id}, /user/hooks/{id}, /admin/hooks/{id}.
        -- Site admins pass the repository-admin check for every repository
        -- and may manage any organization's webhooks.
}

-- Deleting a webhook removes its whole delivery history.
-- from: models/webhook/webhook.go:580
rule ManagerDeletesWebhook {
    when: ManagerDeletesWebhook(actor, webhook)
    requires: webhook.is_admin_level or not (exists access/InstanceWriteGate{read_only: true})   -- decided: administration 3 (read-only mode refuses every write)
    requires: not config.disable_webhooks
    let may_manage =
        if webhook.scope = per_repository: is_repo_admin(actor, webhook.repository)
        else: if webhook.scope = per_owner and webhook.owner_user != null: webhook.owner_user = actor
        else: if webhook.scope = per_owner and webhook.owner_org != null: is_org_owner(webhook.owner_org, actor) or actor.is_admin
        else: webhook.is_admin_level and actor.is_admin
    requires: may_manage
    ensures:
        for d in webhook.deliveries:
            not exists d
    ensures: not exists webhook
    @guidance
        -- Web: POST {base}/hooks/delete (id). API: DELETE .../hooks/{id}.
}

-- A synthetic push is queued regardless of the webhook's event selection
-- or branch filter. For a repository webhook it is the default branch head
-- (or a placeholder commit when the repository is empty); for owner and
-- system webhooks it is a placeholder push.
-- decided (webhooks 11): repository, organisation, user and system webhooks
-- can all be tested (Forgejo: repository webhooks only). Default webhooks
-- never fire, so they cannot be tested.
-- decided (webhooks 1): an inactive webhook cannot be tested; no delivery is
-- created (Forgejo recorded a skipped one).
-- from: routers/web/repo/setting/webhook.go:401
rule ManagerTestsWebhook {
    when: ManagerTestsWebhook(actor, webhook)
    requires: webhook.is_admin_level or not (exists access/InstanceWriteGate{read_only: true})   -- decided: administration 3 (read-only mode refuses every write)
    requires: not config.disable_webhooks
    requires: webhook.scope != default
    requires: webhook.can_fire
    let may_manage =
        if webhook.scope = per_repository: is_repo_admin(actor, webhook.repository)
        else: if webhook.scope = per_owner and webhook.owner_user != null: webhook.owner_user = actor
        else: if webhook.scope = per_owner and webhook.owner_org != null: is_org_owner(webhook.owner_org, actor) or actor.is_admin
        else: webhook.is_admin_level and actor.is_admin
    requires: may_manage
    ensures:
        let fresh = HookDelivery.created(
            webhook: webhook,
            delivery_id: new_delivery_id(),
            event: push,
            action: pushed,
            payload: synthetic_push_payload(webhook, actor),
            is_test: true,
            created_at: now,
            status: queued,
            attempts: 0
        )
        HookDeliveryQueued(delivery: fresh)
    @guidance
        -- Web: POST {base}/hooks/{id}/test on every webhook settings page.
        -- API: POST .../hooks/{id}/tests (repos, orgs, user, admin);
        -- for a repository webhook an optional ref overrides the default
        -- branch.
}

-- Redeliver an earlier delivery: a fresh delivery (new id) with the same
-- event and captured payload is queued.
-- decided (webhooks 1): an inactive webhook gets no delivery at all; the
-- redelivery is refused (Forgejo queued one and recorded it as skipped).
-- from: models/webhook/hooktask.go:154
rule ManagerRedeliversDelivery {
    when: ManagerRedeliversDelivery(actor, delivery)
    requires: delivery.webhook.is_admin_level or not (exists access/InstanceWriteGate{read_only: true})   -- decided: administration 3 (read-only mode refuses every write)
    requires: not config.disable_webhooks
    requires: delivery.webhook.can_fire
    let may_manage =
        if delivery.webhook.scope = per_repository: is_repo_admin(actor, delivery.webhook.repository)
        else: if delivery.webhook.scope = per_owner and delivery.webhook.owner_user != null: delivery.webhook.owner_user = actor
        else: if delivery.webhook.scope = per_owner and delivery.webhook.owner_org != null: is_org_owner(delivery.webhook.owner_org, actor) or actor.is_admin
        else: delivery.webhook.is_admin_level and actor.is_admin
    requires: may_manage
    ensures:
        let fresh = HookDelivery.created(
            webhook: delivery.webhook,
            delivery_id: new_delivery_id(),
            event: delivery.event,
            action: delivery.action,
            payload: delivery.payload,
            is_test: delivery.is_test,
            created_at: now,
            status: queued,
            attempts: 0
        )
        HookDeliveryQueued(delivery: fresh)
    @guidance
        -- Web only: POST {base}/hooks/{id}/replay/{delivery_id}. The button
        -- is disabled while the webhook is inactive.
}

------------------------------------------------------------
-- Rules — webhooks following repositories and owners
------------------------------------------------------------

-- Every new repository (created, forked, migrated, generated, adopted) gets
-- its own copy of each default webhook.
-- decided (webhooks 5): the copy drops the Authorization header and must be
-- re-authorised by a manager before it fires; the rest is copied.
-- from: models/webhook/webhook_system.go:71
rule CopyDefaultWebhooksIntoNewRepository {
    when: repository: repositories/Repository.created
    for template in Webhooks where scope = default:
        ensures: Webhook.created(
            scope: per_repository,
            repository: repository,
            config: without_authorization(template.config),
            is_active: template.is_active,
            needs_reauthorization: template.config.authorization_header != null,
            last_status: none,
            created_at: now,
            updated_at: now
        )
}

-- "Generate from template" with the webhooks option copies the template
-- repository's own webhooks.
-- decided (webhooks 5): as for default webhooks, the Authorization header is
-- dropped and the copy must be re-authorised.
-- from: services/repository/hooks.go:49
rule CopyTemplateRepositoryWebhooks {
    when: repositories/RepositoryGeneratedFromTemplate(template, repository, doer, git_content, topics, git_hooks, webhooks, avatar, labels, protected_branches)
    requires: webhooks
    for source in Webhooks where scope = per_repository and repository = template:
        ensures: Webhook.created(
            scope: per_repository,
            repository: repository,
            config: without_authorization(source.config),
            is_active: source.is_active,
            needs_reauthorization: source.config.authorization_header != null,
            last_status: none,
            created_at: now,
            updated_at: now
        )
}

-- from: services/repository/delete.go:199
rule RemoveWebhooksOfDeletedRepository {
    when: repositories/RepositoryDeleted(repository, doer)
    for w in Webhooks where scope = per_repository and w.repository = repository:
        ensures:
            for d in w.deliveries:
                not exists d
        ensures: not exists w
}

-- decided (webhooks 6): a deleted owner's webhooks are removed with their
-- delivery history (Forgejo left them behind).
rule RemoveWebhooksOfDeletedUser {
    when: accounts/UserAccountDeleted(user, kind, purge, delete_contributions)
    for w in Webhooks where scope = per_owner and owner_user = user:
        ensures:
            for d in w.deliveries:
                not exists d
        ensures: not exists w
}

-- decided (webhooks 6): as for users.
rule RemoveWebhooksOfDeletedOrganization {
    when: organizations/OrganizationDeleted(organization)
    for w in Webhooks where scope = per_owner and owner_org = organization:
        ensures:
            for d in w.deliveries:
                not exists d
        ensures: not exists w
}

------------------------------------------------------------
-- Rules — from domain events to deliveries
------------------------------------------------------------

-- Fan-out: an event concerning a repository reaches the repository's active
-- webhooks, the active webhooks of the repository's owner (user or org) and
-- every active system webhook. An event without a repository (an
-- owner-level package) reaches the owner's and the system webhooks.
-- from: services/webhook/webhook.go:239
rule FanOutHookEvent {
    when: HookEventRaised(kind, action, source_repo?, owner_user?, owner_org?, branch?, commit_count?, sender?)
    requires: not config.disable_webhooks
    let o_user = if source_repo != null: source_repo.owner_user else: owner_user
    let o_org = if source_repo != null: source_repo.owner_org else: owner_org
    for w in Webhooks where can_fire and (
            (scope = per_repository and source_repo != null and w.repository = source_repo)
            or (scope = per_owner and o_user != null and owner_user = o_user)
            or (scope = per_owner and o_org != null and owner_org = o_org)
            or scope = system):
        ensures: HookEventMatched(webhook: w, kind: kind, action: action, branch: branch, commit_count: commit_count)
}

-- Per-webhook filtering, then a queued delivery.
-- decided (webhooks 1): inactive webhooks and globally disabled webhooks get
-- no delivery (FanOutHookEvent matches only webhooks that can fire).
-- decided (webhooks 3): pull_request_review gates all three review outcomes
-- (approved, rejected, comment) via choice_of.
-- from: services/webhook/webhook.go:161
rule QueueDeliveryForMatchedEvent {
    when: HookEventMatched(webhook, kind, action, branch?, commit_count?)
    -- event selection
    requires: webhook.config.event_mode = send_everything
        or (webhook.config.event_mode = push_only and kind = push)
        or (webhook.config.event_mode = choose_events and choice_of(kind) in webhook.config.chosen_events)
    -- chat-style kinds are not told about pushes with no new commits
    requires: not (kind = push and commit_count = 0 and not webhook.config.is_generic)
    -- branch filter applies to branch pushes, branch creation and deletion only
    requires: branch = null
        or webhook.config.branch_filter = null
        or webhook.config.branch_filter = "*"
        or glob_matches(webhook.config.branch_filter, branch)
    -- decided (webhooks 2): an event the kind cannot render is dropped here
    requires: kind_supports(webhook.config.kind, kind)
    ensures:
        let fresh = HookDelivery.created(
            webhook: webhook,
            delivery_id: new_delivery_id(),
            event: kind,
            action: action,
            payload: capture_payload(kind, action),
            is_test: false,
            created_at: now,
            status: queued,
            attempts: 0
        )
        HookDeliveryQueued(delivery: fresh)
}

-- Code ------------------------------------------------------------

-- One push event per branch or tag the push created or moved (a deleted
-- ref is announced by RefDeletionRaisesHookEvent instead). Refs updated by
-- a pull-mirror sync are announced by MirrorSyncRaisesPushHookEvent.
-- from: services/webhook/notifier.go:603
rule PushRaisesHookEvent {
    when: code/PushReceived(push)
    ensures:
        for u in push.ref_updates:
            if u.ref_kind in {branch_ref, tag_ref} and not u.is_deletion:
                HookEventRaised(
                    kind: push,
                    action: pushed,
                    source_repo: push.repository,
                    owner_user: null,
                    owner_org: null,
                    branch: if u.ref_kind = branch_ref: u.ref_name else: null,
                    commit_count: pushed_commit_count(u),
                    sender: push.pusher
                )
    @guidance
        -- sender is null for a deploy-key push; the payload then names
        -- push.deploy_key as the sender (decided: code 4).
        -- pushed_commit_count(u) is the number of commits between u.old_sha
        -- and u.new_sha (all reachable commits for a new ref).
        -- The payload lists at most config.payload_commit_limit commits plus
        -- the head commit, and reports the full total_commits.
}

-- A null pusher is a deploy-key push: the payload's sender is that key
-- (decided: code 4), as for RefDeletionRaisesHookEvent.
-- from: services/webhook/notifier.go:770
rule RefCreationRaisesHookEvent {
    when: code/RefCreated(repository, pusher, ref_kind, ref_name, commit_sha)
    ensures: HookEventRaised(
        kind: create,
        action: created,
        source_repo: repository,
        owner_user: null,
        owner_org: null,
        branch: if ref_kind = branch_ref: ref_name else: null,
        commit_count: null,
        sender: pusher
    )
}

-- from: services/webhook/notifier.go:806
rule RefDeletionRaisesHookEvent {
    when: code/RefDeleted(repository, pusher, ref_kind, ref_name)
    ensures: HookEventRaised(
        kind: delete,
        action: deleted,
        source_repo: repository,
        owner_user: null,
        owner_org: null,
        branch: if ref_kind = branch_ref: ref_name else: null,
        commit_count: null,
        sender: pusher
    )
}

-- Pull-mirror syncs raise the same push / create / delete events as user
-- pushes, attributed to the repository owner (pusher and sender alike).
-- from: services/webhook/notifier.go:850
-- from: services/mirror/mirror_pull.go:600
rule MirrorSyncRaisesPushHookEvent {
    when: repositories/MirrorSyncPushed(repository, ref_name, commits)
    ensures: HookEventRaised(
        kind: push,
        action: pushed,
        source_repo: repository,
        owner_user: null,
        owner_org: null,
        branch: if is_branch_ref(ref_name): branch_of_ref(ref_name) else: null,
        commit_count: commits.count,
        sender: mirror_pusher(repository)
    )
    @guidance
        -- Payload as for a user push: at most config.payload_commit_limit
        -- commits, the head commit, and the full total_commits.
}

-- from: services/webhook/notifier.go:878
rule MirrorRefCreationRaisesHookEvent {
    when: repositories/MirrorRefCreated(repository, ref_name)
    ensures: HookEventRaised(
        kind: create,
        action: created,
        source_repo: repository,
        owner_user: null,
        owner_org: null,
        branch: if is_branch_ref(ref_name): branch_of_ref(ref_name) else: null,
        commit_count: null,
        sender: mirror_pusher(repository)
    )
}

-- from: services/webhook/notifier.go:882
rule MirrorRefDeletionRaisesHookEvent {
    when: repositories/MirrorRefDeleted(repository, ref_name)
    ensures: HookEventRaised(
        kind: delete,
        action: deleted,
        source_repo: repository,
        owner_user: null,
        owner_org: null,
        branch: if is_branch_ref(ref_name): branch_of_ref(ref_name) else: null,
        commit_count: null,
        sender: mirror_pusher(repository)
    )
}

-- Repositories ----------------------------------------------------

-- from: services/webhook/notifier.go:110
rule RepositoryCreationRaisesHookEvent {
    when: repositories/RepositoryCreated(repository, doer)
    -- a repository reserved for an import is announced once, on RepositoryMigrated
    requires: repository.status != being_migrated
    ensures: HookEventRaised(kind: repository, action: created, source_repo: repository, owner_user: null, owner_org: null, branch: null, commit_count: null, sender: doer)
}

-- The sender is the user who ran the migration.
-- from: services/webhook/notifier.go:133
rule RepositoryMigrationRaisesHookEvent {
    when: migrations/RepositoryMigrated(repository)
    let migration = migrations/Migration{repository: repository}
    ensures: HookEventRaised(kind: repository, action: created, source_repo: repository, owner_user: null, owner_org: null, branch: null, commit_count: null, sender: migration.doer)
}

-- The fork event goes to the source repository's hooks; a fork into an
-- organization also announces the new repository to the organization.
-- from: services/webhook/notifier.go:82
rule ForkRaisesHookEvents {
    when: repositories/RepositoryForked(source, fork, doer)
    ensures: HookEventRaised(kind: fork, action: forked, source_repo: source, owner_user: null, owner_org: null, branch: null, commit_count: null, sender: doer)
    ensures:
        if fork.owner_org != null:
            HookEventRaised(kind: repository, action: created, source_repo: fork, owner_user: null, owner_org: null, branch: null, commit_count: null, sender: doer)
}

-- Announced before the repository disappears; its own webhooks go with it,
-- so only owner and system webhooks are told.
-- from: services/webhook/notifier.go:122
rule RepositoryDeletionRaisesHookEvent {
    when: repositories/RepositoryDeletionAnnounced(repository, doer, owner_user, owner_org)
    ensures: HookEventRaised(
        kind: repository,
        action: deleted,
        source_repo: null,
        owner_user: owner_user,
        owner_org: owner_org,
        branch: null,
        commit_count: null,
        sender: doer
    )
}

-- Issues and pull-request conversations ---------------------------

-- from: services/webhook/notifier.go:272
rule IssueOpenedRaisesHookEvent {
    when: issues/IssueOpened(issue, mentions)
    requires: not issue.is_pull
    ensures: HookEventRaised(kind: issues, action: opened, source_repo: issue.repository, owner_user: null, owner_org: null, branch: null, commit_count: null, sender: issue.poster)
}

-- from: services/webhook/notifier.go:294
rule PullRequestOpenedRaisesHookEvent {
    when: pulls/PullRequestOpened(pull_request)
    ensures: HookEventRaised(kind: pull_request, action: opened, source_repo: pull_request.issue.repository, owner_user: null, owner_org: null, branch: null, commit_count: null, sender: pull_request.issue.poster)
}

-- from: services/webhook/notifier.go:190
rule TitleChangeRaisesHookEvent {
    when: issues/IssueTitleChanged(issue, doer, old_title)
    ensures: HookEventRaised(
        kind: if issue.is_pull: pull_request else: issues,
        action: edited,
        source_repo: issue.repository,
        owner_user: null,
        owner_org: null,
        branch: null,
        commit_count: null,
        sender: doer
    )
}

-- from: services/webhook/notifier.go:320
rule ContentChangeRaisesHookEvent {
    when: issues/IssueContentChanged(issue, doer, old_content)
    ensures: HookEventRaised(
        kind: if issue.is_pull: pull_request else: issues,
        action: edited,
        source_repo: issue.repository,
        owner_user: null,
        owner_org: null,
        branch: null,
        commit_count: null,
        sender: doer
    )
}

-- from: services/webhook/notifier.go:230
rule CloseRaisesHookEvent {
    when: issues/IssueClosed(issue, doer, comment)
    ensures: HookEventRaised(
        kind: if issue.is_pull: pull_request else: issues,
        action: closed,
        source_repo: issue.repository,
        owner_user: null,
        owner_org: null,
        branch: null,
        commit_count: null,
        sender: doer
    )
}

-- from: services/webhook/notifier.go:230
rule ReopenRaisesHookEvent {
    when: issues/IssueReopened(issue, doer, comment)
    ensures: HookEventRaised(
        kind: if issue.is_pull: pull_request else: issues,
        action: reopened,
        source_repo: issue.repository,
        owner_user: null,
        owner_org: null,
        branch: null,
        commit_count: null,
        sender: doer
    )
}

-- pulls never emits issues/IssueClosed / IssueReopened for a pull request; a
-- PR's close / reopen arrives as pulls/PullRequestClosed / PullRequestReopened
-- (doer null when a repository deletion closed it: the deletion is announced instead).
-- from: services/webhook/notifier.go:230
rule PullRequestCloseRaisesHookEvent {
    when: pulls/PullRequestClosed(pull_request, doer)
    requires: doer != null
    ensures: HookEventRaised(kind: pull_request, action: closed, source_repo: pull_request.issue.repository, owner_user: null, owner_org: null, branch: null, commit_count: null, sender: doer)
}

-- from: services/webhook/notifier.go:230
rule PullRequestReopenRaisesHookEvent {
    when: pulls/PullRequestReopened(pull_request, doer)
    ensures: HookEventRaised(kind: pull_request, action: reopened, source_repo: pull_request.issue.repository, owner_user: null, owner_org: null, branch: null, commit_count: null, sender: doer)
}

-- Manual and automatic merges alike (pulls emits PullRequestMerged for
-- both); the payload marks the PR merged.
-- from: services/webhook/notifier.go:636
rule MergeRaisesHookEvent {
    when: pulls/PullRequestMerged(pull_request, merger)
    ensures: HookEventRaised(kind: pull_request, action: closed, source_repo: pull_request.issue.repository, owner_user: null, owner_org: null, branch: null, commit_count: null, sender: merger)
}

-- from: services/webhook/notifier.go:673
rule TargetBranchChangeRaisesHookEvent {
    when: pulls/PullRequestTargetBranchChanged(pull_request, doer, old_base_branch)
    ensures: HookEventRaised(kind: pull_request, action: edited, source_repo: pull_request.issue.repository, owner_user: null, owner_org: null, branch: null, commit_count: null, sender: doer)
}

-- from: services/webhook/notifier.go:145
rule AssigneeAddedRaisesHookEvent {
    when: issues/IssueAssigneeChanged(issue, doer, assignee, removed, comment)
    requires: not removed
    ensures: HookEventRaised(
        kind: if issue.is_pull: pull_request_assign else: issue_assign,
        action: assigned,
        source_repo: issue.repository,
        owner_user: null,
        owner_org: null,
        branch: null,
        commit_count: null,
        sender: doer
    )
}

-- from: services/webhook/notifier.go:145
rule AssigneeRemovedRaisesHookEvent {
    when: issues/IssueAssigneeChanged(issue, doer, assignee, removed, comment)
    requires: removed
    ensures: HookEventRaised(
        kind: if issue.is_pull: pull_request_assign else: issue_assign,
        action: unassigned,
        source_repo: issue.repository,
        owner_user: null,
        owner_org: null,
        branch: null,
        commit_count: null,
        sender: doer
    )
}

-- from: services/webhook/notifier.go:515
rule LabelsChangedRaisesHookEvent {
    when: issues/IssueLabelsChanged(issue, doer, added, removed)
    ensures: HookEventRaised(
        kind: if issue.is_pull: pull_request_label else: issue_label,
        action: label_updated,
        source_repo: issue.repository,
        owner_user: null,
        owner_org: null,
        branch: null,
        commit_count: null,
        sender: doer
    )
}

-- from: services/webhook/notifier.go:42
rule LabelsClearedRaisesHookEvent {
    when: issues/IssueLabelsCleared(issue, doer)
    ensures: HookEventRaised(
        kind: if issue.is_pull: pull_request_label else: issue_label,
        action: label_cleared,
        source_repo: issue.repository,
        owner_user: null,
        owner_org: null,
        branch: null,
        commit_count: null,
        sender: doer
    )
}

-- from: services/webhook/notifier.go:561
rule MilestoneChangedRaisesHookEvent {
    when: issues/IssueMilestoneChanged(issue, doer, old_milestone)
    ensures: HookEventRaised(
        kind: if issue.is_pull: pull_request_milestone else: issue_milestone,
        action: if issue.milestone != null: milestoned else: demilestoned,
        source_repo: issue.repository,
        owner_user: null,
        owner_org: null,
        branch: null,
        commit_count: null,
        sender: doer
    )
}

-- Only conversation comments (not timeline events) are announced.
-- from: services/webhook/notifier.go:407
rule CommentCreatedRaisesHookEvent {
    when: issues/IssueCommentCreated(issue, comment, doer, mentions)
    requires: comment.kind = comment
    ensures: HookEventRaised(
        kind: if issue.is_pull: pull_request_comment else: issue_comment,
        action: created,
        source_repo: issue.repository,
        owner_user: null,
        owner_org: null,
        branch: null,
        commit_count: null,
        sender: doer
    )
}

-- from: services/webhook/notifier.go:364
rule CommentEditedRaisesHookEvent {
    when: issues/IssueCommentEdited(comment, doer, old_content)
    ensures: HookEventRaised(
        kind: if comment.issue.is_pull: pull_request_comment else: issue_comment,
        action: edited,
        source_repo: comment.issue.repository,
        owner_user: null,
        owner_org: null,
        branch: null,
        commit_count: null,
        sender: doer
    )
}

-- from: services/webhook/notifier.go:437
rule CommentDeletedRaisesHookEvent {
