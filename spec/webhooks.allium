-- Actions ---------------------------------------------------------

-- A run entering blocked, cancelled, failure, running, skipped, success or
-- waiting (including a new attempt and completion) is announced as
-- workflow_run_<status>; other statuses are not announced.
-- from: services/webhook/notifier.go:926
rule WorkflowRunStatusRaisesHookEvent {
    when: actions/WorkflowRunStatusChanged(run, prior_status)
    requires: run.status in {blocked, cancelled, failure, running, skipped, success, waiting}
    ensures: HookEventRaised(
        kind: workflow_run_kind(run.status),
        action: status_changed,
        source_repo: run.repository,
        owner_user: null,
        owner_org: null,
        branch: null,
        commit_count: null,
        sender: run.trigger_user
    )
}

-- from: services/webhook/notifier.go:1023
rule WorkflowJobStatusRaisesHookEvent {
    when: actions/WorkflowJobStatusChanged(job, prior_status)
    requires: job.status in {blocked, cancelled, failure, running, skipped, success, waiting}
    ensures: HookEventRaised(
        kind: workflow_job_kind(job.status),
        action: status_changed,
        source_repo: job.run.repository,
        owner_user: null,
        owner_org: null,
        branch: null,
        commit_count: null,
        sender: job.run.trigger_user
    )
}

-- A run or job reaching its final status (success, failure, cancelled,
-- skipped) is announced the same way; actions emits completion separately
-- from non-final status changes.
-- from: services/webhook/notifier.go:926
rule WorkflowRunCompletionRaisesHookEvent {
    when: actions/WorkflowRunCompleted(run, prior_status)
    -- actions emits WorkflowRunCompleted only when the run reaches cancelled,
    -- failure, skipped or success, so no status guard is needed here.
    ensures: HookEventRaised(
        kind: workflow_run_kind(run.status),
        action: status_changed,
        source_repo: run.repository,
        owner_user: null,
        owner_org: null,
        branch: null,
        commit_count: null,
        sender: run.trigger_user
    )
}

-- from: services/webhook/notifier.go:1023
rule WorkflowJobCompletionRaisesHookEvent {
    when: actions/WorkflowJobCompleted(job, prior_status)
    -- actions emits WorkflowJobCompleted only for final job statuses.
    ensures: HookEventRaised(
        kind: workflow_job_kind(job.status),
        action: status_changed,
        source_repo: job.run.repository,
        owner_user: null,
        owner_org: null,
        branch: null,
        commit_count: null,
        sender: job.run.trigger_user
    )
}

-- A new run attempt (a run created, or re-run) and a new job attempt are
-- announced with the status they start in (waiting or blocked); actions
-- emits these apart from the *StatusChanged / *Completed triggers.
-- from: services/webhook/notifier.go:926
rule WorkflowRunAttemptRaisesHookEvent {
    when: actions/WorkflowRunAttemptStarted(run)
    requires: run.status in {blocked, cancelled, failure, running, skipped, success, waiting}
    ensures: HookEventRaised(
        kind: workflow_run_kind(run.status),
        action: status_changed,
        source_repo: run.repository,
        owner_user: null,
        owner_org: null,
        branch: null,
        commit_count: null,
        sender: run.trigger_user
    )
}

-- from: services/webhook/notifier.go:1023
rule WorkflowJobAttemptRaisesHookEvent {
    when: actions/WorkflowJobAttemptStarted(job)
    requires: job.status in {blocked, cancelled, failure, running, skipped, success, waiting}
    ensures: HookEventRaised(
        kind: workflow_job_kind(job.status),
        action: status_changed,
        source_repo: job.run.repository,
        owner_user: null,
        owner_org: null,
        branch: null,
        commit_count: null,
        sender: job.run.trigger_user
    )
}

------------------------------------------------------------
-- Rules — delivering
------------------------------------------------------------

-- A queued delivery is picked up by the delivery worker. Queued deliveries
-- survive restarts: on start-up every still-queued delivery is re-queued.
-- A delivery already queued when its webhook was deactivated (or webhooks
-- were disabled) is skipped.
-- decided (webhooks 1): skipping leaves the webhook's last_status untouched
-- (Forgejo set it to failed).
-- from: services/webhook/deliver.go:330
rule DispatchQueuedDelivery {
    when: HookDeliveryQueued(delivery)
    requires: delivery.status = queued
    let w = delivery.webhook
    ensures:
        if config.disable_webhooks or not w.is_active:
            delivery.status = skipped
            delivery.finished_at = now
            HookDeliveryCompleted(delivery: delivery)
        else:
            if not host_allowed(config.allowed_host_list, w.config.target_url):
                delivery.status = failed
                delivery.request = render_request(w, delivery)
                delivery.response = denied_response(w.config.target_url)
                delivery.finished_at = now
                w.last_status = failed
                HookDeliveryCompleted(delivery: delivery)
            else:
                delivery.status = sending
                delivery.attempts = delivery.attempts + 1
                delivery.request = render_request(w, delivery)
                delivery.sent_at = now
    @guidance
        -- Deliveries are processed by a persistent work queue; a delivery is
        -- claimed atomically so it is sent at most once even if queued twice.
        -- TLS certificates are verified unless config.skip_tls_verify. The
        -- allow-list is enforced on the resolved IP at connect time (also
        -- through redirects and the proxy), not only on the URL host name.
}

-- A 5xx answer is retried while attempts remain (decided: webhooks 9); any
-- other non-2xx answer fails at once. last_status records only the final
-- outcome.
-- from: services/webhook/deliver.go:447
rule ReceiverAnswers {
    when: ReceiverResponds(delivery, status_code, headers, body)
    requires: delivery.status = sending
    ensures: delivery.response = HookResponse{status_code: status_code, headers: headers, body: body}
    ensures:
        if status_code >= 200 and status_code < 300:
            delivery.status = succeeded
            delivery.finished_at = now
            delivery.webhook.last_status = succeeded
            HookDeliveryCompleted(delivery: delivery)
        else:
            if status_code >= 500 and delivery.may_retry:
                delivery.status = retrying
                delivery.next_attempt_at = now + backoff_delay(config.retry_backoff_base, delivery.attempts)
            else:
                delivery.status = failed
                delivery.finished_at = now
                delivery.webhook.last_status = failed
                HookDeliveryCompleted(delivery: delivery)
}

-- Connection refused, DNS failure, TLS failure, a host refused by the
-- allow-list after resolution, or an unreadable response body. Retried while
-- attempts remain (decided: webhooks 9).
-- from: services/webhook/deliver.go:440
rule DeliveryTransportFails {
    when: DeliveryTransportFailed(delivery, reason)
    requires: delivery.status = sending
    ensures: delivery.response = HookResponse{status_code: null, headers: {}, body: reason}
    ensures:
        if delivery.may_retry:
            delivery.status = retrying
            delivery.next_attempt_at = now + backoff_delay(config.retry_backoff_base, delivery.attempts)
        else:
            delivery.status = failed
            delivery.finished_at = now
            delivery.webhook.last_status = failed
            HookDeliveryCompleted(delivery: delivery)
}

-- A timeout counts as a network error and is retried while attempts remain
-- (decided: webhooks 9).
-- from: services/webhook/deliver.go:499
rule DeliveryTimesOut {
    when: delivery: HookDelivery.is_overdue
    requires: delivery.status = sending
    ensures: delivery.response = HookResponse{status_code: null, headers: {}, body: "timeout"}
    ensures:
        if delivery.may_retry:
            delivery.status = retrying
            delivery.next_attempt_at = now + backoff_delay(config.retry_backoff_base, delivery.attempts)
        else:
            delivery.status = failed
            delivery.finished_at = now
            delivery.webhook.last_status = failed
            HookDeliveryCompleted(delivery: delivery)
}

-- decided (webhooks 9): when the backoff has passed the delivery is queued
-- again under the same delivery id; DispatchQueuedDelivery re-checks the
-- webhook and the host allow-list before the next attempt.
-- backoff_delay(base, n) = base * 2^(n-1): 10s, 20s, ... by default.
rule RetryDeliveryAfterBackoff {
    when: delivery: HookDelivery.is_retry_due
    requires: delivery.status = retrying
    ensures: delivery.status = queued
    ensures: delivery.next_attempt_at = null
    ensures: HookDeliveryQueued(delivery: delivery)
}

------------------------------------------------------------
-- Rules — history cleanup (cron task cleanup_hook_task_table)
------------------------------------------------------------

-- The cron task cleanup_hook_task_table is registered and scheduled by
-- administration (default nightly, also "run now"); each run arrives as
-- administration/HookDeliveryCleanupDue with the configured settings, and
-- this module's cleanup_* config mirrors those settings. The two temporal
-- rules below state the condition every run enforces; the reaction performs
-- the same sweep with the parameters it is given, so both converge on the
-- same history.
-- from: models/webhook/hooktask.go:202
rule CleanupDeliveriesOlderThan {
    when: delivery: HookDelivery.is_expired
    requires: config.cleanup_enabled
    requires: config.cleanup_type = "older_than"
    ensures: not exists delivery
}

-- from: models/webhook/hooktask.go:236
rule CleanupDeliveriesBeyondKeepCount {
    when: webhook: Webhook.history_over_limit
    requires: config.cleanup_enabled
    requires: config.cleanup_type = "per_webhook"
    let excess = oldest_beyond(webhook.finished_deliveries, config.cleanup_keep_count)
    ensures:
        for d in excess:
            not exists d
}

-- One scheduled (or manually started) run of the cleanup task.
-- from: services/cron/tasks_basic.go:130
rule CleanupDeliveryHistoryWhenDue {
    when: administration/HookDeliveryCleanupDue(cleanup_type, older_than, number_to_keep)
    ensures:
        if cleanup_type = older_than:
            for d in HookDeliveries where is_finished and finished_at + older_than <= now:
                not exists d
        else:
            for w in Webhooks:
                for d in oldest_beyond(w.finished_deliveries, number_to_keep):
                    not exists d
}

------------------------------------------------------------
-- Invariants
------------------------------------------------------------

-- from: models/webhook/webhook.go:124
invariant WebhookHasExactlyOneHome {
    for w in Webhooks:
        (w.scope = per_repository implies (w.repository != null and w.owner_user = null and w.owner_org = null))
        and (w.scope = per_owner implies (w.repository = null and ((w.owner_user != null) != (w.owner_org != null))))
        and (w.is_admin_level implies (w.repository = null and w.owner_user = null and w.owner_org = null))
}

-- A copy awaiting re-authorisation may lack a required Authorization header
-- (matrix, sourcehut_builds) until a manager edits it.
invariant StoredConfigIsValid {
    for w in Webhooks:
        w.needs_reauthorization or w.config.is_valid
}

invariant AttemptsAreBounded {
    for d in HookDeliveries:
        d.attempts <= config.max_delivery_attempts
}

invariant DeliveryIdsAreUnique {
    for a in HookDeliveries:
        for b in HookDeliveries:
            a != b implies a.delivery_id != b.delivery_id
}

-- Default webhooks are templates and never accumulate deliveries.
invariant DefaultWebhooksHaveNoDeliveries {
    for w in Webhooks:
        w.scope = default implies w.deliveries.count = 0
}

invariant ChosenEventsOnlyWhenChoosing {
    for w in Webhooks:
        w.config.event_mode != choose_events implies w.config.chosen_events.count = 0
}

------------------------------------------------------------
-- Actor Declarations
------------------------------------------------------------

-- Managers are the shared actors: access/RepoAdmin (repository webhooks),
-- organizations/OrgOwner (organization webhooks), access/SignedInUser (own
-- webhooks) and access/SiteAdmin (system and default webhooks). Every
-- permission is also a `requires` on the rule, since surfaces do not enforce
-- the facing actor.

actor HookReceiver {
    identified_by: ReceivingService where base_url != ""
}

------------------------------------------------------------
-- Surfaces
------------------------------------------------------------

-- Repository settings → Webhooks (web) and /repos/{owner}/{repo}/hooks (API).
-- from: routers/web/web.go:1329
surface RepoWebhookSettings {
    facing admin: access/RepoAdmin
    context repo: repositories/Repository

    let hooks = Webhooks where scope = per_repository and repository = repo

    exposes:
        for w in hooks:
            w.config.kind
            w.config.target_url
            w.config.http_method
            w.config.content_type
            w.config.event_mode
            w.config.chosen_events
            w.config.branch_filter
            w.config.settings
            w.is_active
            w.last_status
            w.created_at
            w.updated_at
        for d in HookDeliveries where webhook.repository = repo:
            d.delivery_id
            d.event
            d.status
            d.is_test
            d.request
            d.response
            d.finished_at

    provides:
        RepoAdminCreatesWebhook(admin, repo, hook_config, is_active) when not config.disable_webhooks
        ManagerEditsWebhook(admin, webhook, hook_config, is_active) when not config.disable_webhooks
        ManagerDeletesWebhook(admin, webhook) when not config.disable_webhooks
        ManagerTestsWebhook(admin, webhook) when not config.disable_webhooks
        ManagerRedeliversDelivery(admin, delivery) when not config.disable_webhooks

    @guarantee SecretIsWriteOnly
        -- The HMAC secret is never shown back, in the web UI or the API.

    @guarantee AuthorizationIsWriteOnly
        -- decided (webhooks 7): the Authorization header is write-only like
        -- the secret, on every webhook surface: managers can replace or
        -- clear it, never read it (Forgejo returned it in clear). Recorded
        -- requests show it redacted.

    @guarantee HistoryIsPaged
        -- Deliveries are listed newest first, config.history_page_size per page.

    @guidance
        -- Web: GET {repo}/settings/hooks; GET/POST {repo}/settings/hooks/{kind}/new;
        -- GET/POST {repo}/settings/hooks/{id}; POST .../{id}/test;
        -- POST .../{id}/replay/{delivery_id}; POST {repo}/settings/hooks/delete.
        -- API: GET/POST /repos/{o}/{r}/hooks; GET/PATCH/DELETE /repos/{o}/{r}/hooks/{id};
        -- POST /repos/{o}/{r}/hooks/{id}/tests. All need a token and repo admin.
}

-- Organization settings → Webhooks and /orgs/{org}/hooks.
-- from: routers/web/web.go:1151
surface OrgWebhookSettings {
    facing owner: organizations/OrgOwner
    context organization: organizations/Organization

    let hooks = Webhooks where scope = per_owner and owner_org = organization

    exposes:
        for w in hooks:
            w.config.kind
            w.config.target_url
            w.config.event_mode
            w.config.chosen_events
            w.config.branch_filter
            w.config.settings
            w.is_active
            w.last_status
        for d in HookDeliveries where webhook.owner_org = organization:
            d.delivery_id
            d.event
            d.status
            d.request
            d.response

    provides:
        OrgOwnerCreatesWebhook(owner, organization, hook_config, is_active) when not config.disable_webhooks
        ManagerEditsWebhook(owner, webhook, hook_config, is_active) when not config.disable_webhooks
        ManagerDeletesWebhook(owner, webhook) when not config.disable_webhooks
        ManagerTestsWebhook(owner, webhook) when not config.disable_webhooks
        ManagerRedeliversDelivery(owner, delivery) when not config.disable_webhooks

    @guidance
        -- Web: {org}/settings/hooks[...]. API: GET/POST
        -- /orgs/{org}/hooks, GET/PATCH/DELETE /orgs/{org}/hooks/{id}.
}

-- User settings → Webhooks and /user/hooks.
-- from: routers/web/web.go:867
surface UserWebhookSettings {
    facing user: access/SignedInUser

    let hooks = Webhooks where scope = per_owner and owner_user = user

    exposes:
        for w in hooks:
            w.config.kind
            w.config.target_url
            w.config.event_mode
            w.config.chosen_events
            w.config.branch_filter
            w.config.settings
            w.is_active
            w.last_status
        for d in HookDeliveries where webhook.owner_user = user:
            d.delivery_id
            d.event
            d.status
            d.request
            d.response

    provides:
        UserCreatesOwnWebhook(user, hook_config, is_active) when not config.disable_webhooks
        ManagerEditsWebhook(user, webhook, hook_config, is_active) when not config.disable_webhooks
        ManagerDeletesWebhook(user, webhook) when not config.disable_webhooks
        ManagerTestsWebhook(user, webhook) when not config.disable_webhooks
        ManagerRedeliversDelivery(user, delivery) when not config.disable_webhooks

    @guidance
        -- Web: /user/settings/hooks[...]. API: GET/POST /user/hooks,
        -- GET/PATCH/DELETE /user/hooks/{id}.
}

-- Site administration → Webhooks (system and default) and /admin/hooks.
-- from: routers/web/admin/hooks.go:22
surface AdminWebhookSettings {
    facing admin: access/SiteAdmin

    let hooks = Webhooks where is_admin_level

    exposes:
        for w in hooks:
            w.scope
            w.config.kind
            w.config.target_url
            w.config.event_mode
            w.config.chosen_events
            w.config.branch_filter
            w.config.settings
            w.is_active
            w.last_status
        for d in HookDeliveries where webhook.scope = system:
            d.delivery_id
            d.event
            d.status
            d.request
            d.response

    provides:
        AdminCreatesSystemWebhook(admin, hook_config, is_active) when not config.disable_webhooks
        AdminCreatesDefaultWebhook(admin, hook_config, is_active) when not config.disable_webhooks
        ManagerEditsWebhook(admin, webhook, hook_config, is_active) when not config.disable_webhooks
        ManagerDeletesWebhook(admin, webhook) when not config.disable_webhooks
        ManagerTestsWebhook(admin, webhook) when not config.disable_webhooks
        ManagerRedeliversDelivery(admin, delivery) when not config.disable_webhooks

    @guidance
        -- Web: GET /admin/hooks (both lists); /admin/{system-hooks|default-hooks}/{kind}/new;
        -- GET/POST /admin/hooks/{id}; POST /admin/hooks/{id}/replay/{uuid};
        -- POST /admin/hooks/delete. API: GET/POST /admin/hooks (list shows
        -- system hooks only), GET/PATCH/DELETE /admin/hooks/{id}.
}

-- decided (webhooks 8): an instance-wide delivery log. Site admins browse
-- every delivery of every webhook (repository, owner and system), newest
-- first, filterable by webhook and by status. Forgejo had none.
surface InstanceDeliveryLog {
    facing admin: access/SiteAdmin

    exposes:
        for d in HookDeliveries:
            d.webhook
            d.delivery_id
            d.event
            d.status
            d.attempts
            d.is_test
            d.request
            d.response
            d.finished_at

    provides:
        ManagerRedeliversDelivery(admin, delivery) when not config.disable_webhooks

    @guarantee HistoryIsPaged
        -- config.history_page_size deliveries per page.

    @guidance
        -- Web: /admin/hooks/deliveries?hook=<id>&status=<status>.
        -- API: GET /admin/hooks/deliveries with the same filters.
}

-- The external endpoint receiving a delivery.
-- from: services/webhook/deliver.go:440
surface HookReceiverEndpoint {
    facing receiver: HookReceiver
    context delivery: HookDelivery where status = sending

    exposes:
        delivery.request

    provides:
        ReceiverResponds(delivery, status_code, headers, body) when receiver.base_url != ""
        DeliveryTransportFailed(delivery, reason)

    contracts:
        fulfils SignedDelivery
        fulfils HookRequestRendering

    @guarantee BoundedAttempts
        -- decided (webhooks 9): each attempt is sent at most once, and a
        -- delivery makes at most config.max_delivery_attempts attempts, all
        -- under the same X-Forgejo-Delivery id.

    @guarantee BoundedWait
        -- The receiver has config.deliver_timeout to answer.

    timeout:
        DeliveryTimesOut
}

------------------------------------------------------------
-- Deferred Specifications
------------------------------------------------------------

deferred HookRequestRendering.render    -- see: services/webhook/ per-kind message formatting: services/webhook/{slack,discord,dingtalk,telegram,msteams,feishu,matrix,wechatwork,packagist}.go, sourcehut/builds.go

------------------------------------------------------------
-- Requests to other modules
------------------------------------------------------------
-- (Triggers consumed are bound exactly as the integration's canonical table
--  names them; see the header.)
-- REQUEST repositories/Repository.owner_user, owner_org: used for owner-webhook fan-out; RepositoryDeleted must be emitted before the repository is removed.
-- REQUEST code/Push.ref_updates with RefUpdate.{ref_kind, ref_name, is_deletion}; PushReceived also for refs updated by pull-mirror sync, and RefCreated / RefDeleted also emitted by mirror sync.
-- REQUEST issues/Issue.milestone; issues/Comment.kind with value `comment` for plain conversation comments; IssueClosed must not be emitted for a merge.
-- REQUEST pulls: PullRequestMerged is emitted for auto-merges as well (webhooks does not react to PullRequestAutoMerged); Review.{status, kind: ReviewVerdict, reviewer, pull_request}.
-- RESOLVED (packages): PackageVersion.package; Package.repository? (the optional link), owner_user / owner_org (derived from the registry).
-- RESOLVED (actions): WorkflowRun.{status, repository, trigger_user}; Job.{status, run} are present.
-- REQUEST migrations/Migration{repository}.doer: the sender of the repository/created event for a migration.
-- REQUEST migrations (or whichever module owns the instance import addon): map stored Forgejo `gitea` / `gogs` webhooks onto kind `forgejo` on import (decided: webhooks 10).
-- REQUEST administration: list the [webhook] retry settings max_delivery_attempts (default 3) and retry_backoff_base among the instance settings, and link the instance-wide delivery log (InstanceDeliveryLog) from site administration (decided: webhooks 8, 9).
