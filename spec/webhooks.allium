-- from: services/webhook/notifier.go:145
rule AssigneeAddedRaisesHookEvent {
    when: issues/IssueAssigneeAdded(issue, doer, assignee)
    ensures: HookEventRaised(
        kind: if issue.is_pull: pull_request_assign else: issue_assign,
        action: assigned, source_repo: issue.repository, sender: doer)
}

-- from: services/webhook/notifier.go:145
rule AssigneeRemovedRaisesHookEvent {
    when: issues/IssueAssigneeRemoved(issue, doer, assignee)
    ensures: HookEventRaised(
        kind: if issue.is_pull: pull_request_assign else: issue_assign,
