-- Config
------------------------------------------------------------

config {
    -- [security] INSTALL_LOCK: once true the install wizard is gone for good.
    -- from: modules/setting/setting.go:248
    install_lock: Boolean = false

    -- [admin]
    -- from: modules/setting/admin.go:20
    -- DISABLE_REGULAR_ORG_CREATION lives in organizations' config
    -- (organizations/config.disable_regular_org_creation).
    default_email_notifications: String = "enabled"    -- enabled | onmention | disabled; new accounts' default (notifications)
    notify_admins_on_new_user: Boolean = false         -- SEND_NOTIFICATION_EMAIL_ON_NEW_USER (notifications)
    -- USER_DISABLED_FEATURES / EXTERNAL_USER_DISABLE_FEATURES live in accounts'
    -- config (accounts/config.user_disabled_features, external_user_disabled_features).

    -- [ui.admin] page sizes of the admin lists
    -- from: modules/setting/ui.go:133
    admin_user_page_size: Integer = 50
    admin_repo_page_size: Integer = 50
    admin_org_page_size: Integer = 50
    admin_notice_page_size: Integer = 25

    -- Announcement title limit
    -- from: models/service_message/service_message.go:33
    announcement_title_max_bytes: Integer = 255

    -- Per-task parameters ([cron.<name>] KEY). The common keys ENABLED,
    -- RUN_AT_START, SCHEDULE and NOTICE_ON_SUCCESS are on each default CronTask.
    -- from: services/cron/tasks_basic.go, tasks_extended.go, tasks_actions.go
    update_mirrors_pull_limit: Integer = 50
    update_mirrors_push_limit: Integer = 50
    repo_health_check_timeout: Duration = 360.seconds      -- [git.timeout] DEFAULT
    repo_health_check_args: String = ""
    archive_cleanup_older_than: Duration = 24.hours
    sync_external_users_update_existing: Boolean = true
    deleted_branches_cleanup_older_than: Duration = 24.hours
    cleanup_hook_task_table_cleanup_type: HookCleanupKind = older_than
    cleanup_hook_task_table_older_than: Duration = 168.hours
    cleanup_hook_task_table_number_to_keep: Integer = 10
    cleanup_packages_older_than: Duration = 24.hours
    delete_inactive_accounts_older_than: Duration = 180.minutes   -- [service] ACTIVE_CODE_LIVE_MINUTES
    git_gc_repos_timeout: Duration = 60.seconds            -- [git.timeout] GC
    git_gc_repos_args: String = ""                         -- [git] GC_ARGS
    delete_old_actions_older_than: Duration = 365.days
    update_checker_http_endpoint: String = "https://dl.gitea.com/gitea/version.json"
    update_checker_domain_endpoint: String = "release.forgejo.org"   -- DNS TXT "forgejo_versions=..." preferred over HTTP
    delete_old_system_notices_older_than: Duration = 365.days
    gc_lfs_older_than: Duration = 7.days
    gc_lfs_last_updated_more_than_ago: Duration = 3.days
    gc_lfs_number_to_check_per_repo: Integer = 100
    gc_lfs_proportion_to_check_per_repo: Decimal = 0.6
    remove_resolved_reports_keep_for: Duration = moderation/config.keep_resolved_reports_for  -- [moderation] KEEP_RESOLVED_REPORTS_FOR, 180 days (decided: moderation 9)
    delete_orphaned_attachments_older_than: Duration = issues/config.orphan_attachment_expiry
    cleanup_offline_runners_older_than: Duration = 24.hours
    cleanup_offline_runners_global_scope_only: Boolean = true
}

