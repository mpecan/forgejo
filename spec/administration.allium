-- allium: 3
-- administration.allium — site administration and the lifecycle of one Forgejo instance.
--
-- Scope: everything a site administrator (web UI + /api/v1/admin) or a server
--   operator (the `forgejo` CLI on the host) does to run the instance as a whole,
--   plus the instance's own lifecycle: first-run installation, health, scheduled
--   maintenance (cron), operational notices, runtime-changeable settings and the
--   site-wide announcement.
-- Includes:
--   - Installation: the first-run install wizard, the install lock, creation of
--     the first administrator.
--   - Instance: version, start time, release/update check, health endpoint,
--     instance statistics (dashboard).
--   - Runtime settings (the system-settings store): disable gravatar, federated
--     avatars, "open with" editor apps — editable by admins without restart.
--   - SystemNotice: operational failure log; created by failing background work,
--     listed, deleted, emptied, aged out.
--   - CronTask: EVERY scheduled task registered by services/cron, its schedule,
--     enablement, run-at-start, run-now, last/next run, exec count, last outcome,
--     and which module owns the work each task performs.
--   - Dashboard one-off operations (resync all branches / all tags).
--   - Announcement (service message): a site-wide modal banner, and per-user
--     acknowledgement of it.
--   - Admin management of users: create (optionally forcing a password change),
--     edit any account field (admin, restricted, prohibit-login, active,
--     max repo creation, visibility, permissions, login source, password, email),
--     rename (bypassing non-local and cooldown restrictions), delete / purge,
--     reset 2FA, avatar, list/search, email directory (activate / delete).
--   - Admin management of orgs and repositories: list, delete repository,
--     unadopted repository directories (adopt / delete), create org or repo on a
--     user's behalf.
--   - Read-only configuration view with secrets masked; test mail; cache test.
--   - Monitoring as a capability only: processes, queues, stack traces.
--   - CLI surface: `forgejo admin user …`, `admin regenerate keys`,
--     `admin auth …` (reference), `admin sendmail`, `admin repo-sync-releases`,
--     `doctor check` (with the full list of checks), `dump`, `manager …`.
-- Excludes:
--   - Auth source CRUD behaviour (LDAP/SMTP/PAM/OAuth2/SSPI) — owned by
--     authentication; only referenced from the admin surfaces here.
--   - System and default webhooks — owned by webhooks; referenced.
--   - Instance-wide OAuth2 applications — owned by authentication; referenced.
--   - Admin runner / variable management — owned by actions; referenced.
--   - Quota rules and groups — owned by quota; referenced.
--   - Abuse report moderation — owned by moderation; referenced.
--   - API impersonation (`sudo`) — owned by access (SiteAdminActsAs); referenced.
--   - Federation host / federated user listing — owned by federation; referenced.
--   - Admin package listing / deletion / cleanup — owned by packages; referenced.
--   - The *work* performed by each cron task (mirror sync, GC, cleanup, ...) —
--     owned by the module named on the task; this module only schedules it and
--     records its outcome.
--   - models/admin/task.go (`Task`) — it is the repository migration task, owned
--     by migrations, despite its package name.
--   - Instance branding, templates and themes — UI only.
--   - MySQL collation self-check page (/admin/self_check) — specific to one
--     database engine; a rebuild picks its own storage.
--   - Go runtime memory/GC statistics on the system-status page — runtime
--     implementation detail; only "uptime + version" survives.
--   - `forgejo doctor recreate-table`, `doctor convert`, `migrate-storage`,
--     `doctor cleanup-commit-status`, `avatar-strip-exif`, `avatar-resize` —
--     storage/ORM maintenance tied to the current implementation.
--   - Deprecated-setting warnings on the dashboard — legacy config migration.
--   - `--name` (deprecated alias of `--username`) on `admin user create` — legacy.
--   - Maintenance / read-only mode — Forgejo has none (checked); see open question.
--   - A full-instance restore — Forgejo has `dump` but no `restore` (only
--     `restore-repo`, which is migrations' import); see open question.
--
-- Emits (domain triggers other modules react to):
--   InstallationCompleted(instance)
--   RuntimeSettingChanged(key)
--   SystemNoticeRecorded(notice)
--   CronTaskExecutes(task, doer)                      -- generic start of any run
--   CronTaskRunFinished(task, outcome)
--   per-task work requests (one per registered cron task, see "Cron dispatch"):
--     MirrorUpdateDue(pull_limit, push_limit)                       -> repositories
--     RepositoryHealthCheckDue(timeout, args)                       -> repositories
--     RepositoryStatsCheckDue()                                     -> repositories
--     RepositoryArchiveCleanupDue(older_than)                       -> repositories
--     ExternalUserSyncDue(update_existing)                          -> authentication
--     DeletedBranchCleanupDue(older_than)                           -> code
--     MigrationPosterIdUpdateDue()                                  -> migrations
--     HookDeliveryCleanupDue(cleanup_type, older_than, number_to_keep) -> webhooks
--     PackageCleanupDue(older_than)                                 -> packages
--     InactiveAccountCleanupDue(older_than)                         -> accounts
--     AllRepositoryArchivesDeletionDue()                            -> repositories
--     RepositoryGarbageCollectionDue(timeout, args)                 -> repositories
--     AuthorizedKeysRewriteDue()                                    -> keys
--     AuthorizedPrincipalsRewriteDue()                              -> keys
--     MissingRepositoryReinitDue()                                  -> repositories
--     MissingRepositoryDeletionDue()                                -> repositories
--     GeneratedRepositoryAvatarDeletionDue()                        -> repositories
--     OldActivityDeletionDue(older_than)                            -> notifications
--     UpdateCheckDue(http_endpoint, domain_endpoint)                -> administration
--     OldSystemNoticeDeletionDue(older_than)                        -> administration
--     LfsGarbageCollectionDue(older_than, last_updated_more_than_ago, number_to_check_per_repo, proportion_to_check_per_repo) -> code
--     IssueIndexRebuildDue()                                        -> discovery
--     ResolvedReportRemovalDue(keep_for)                            -> moderation
--     ZombieActionsTaskStopDue()                                    -> actions
--     EndlessActionsTaskStopDue()                                   -> actions
--     AbandonedActionsJobCancellationDue()                          -> actions
--     LingeringActionsLogTransferDue()                              -> actions
--     ActionsScheduleStartDue()                                     -> actions
--     ActionsCleanupDue()                                           -> actions
--     OfflineRunnerCleanupDue(older_than, global_scope_only)        -> actions
--     ActionsUserCleanupDue()                                       -> actions
--   AllRepositoryBranchesResyncRequested(admin)                     -> code
--   AllRepositoryTagsResyncRequested(admin)                         -> releases
--   AnnouncementPublished(announcement) / AnnouncementWithdrawn(kind)
--   UserCreatedByAdmin(admin, user, send_notification)  -- notifications sends the
--                                                       -- "account created for you" mail
--   UserEditedByAdmin(admin, user)
--   UserRenamedByAdmin(admin, user, old_name, new_name) -- accounts keeps a redirect
--   UserDeletedByAdmin(admin, user, purge)              -- accounts/repositories/organizations/
--                                                       -- packages/federation cascade
--   UserTwoFactorResetByAdmin(admin, user)              -> authentication
--   UserPasswordSetByAdmin(admin, user, password) / UserPasswordSetByOperator(operator, user, password) -> authentication (hash + store)
--   UserAvatarChangedByAdmin(admin, user) / UserAvatarRemovedByAdmin(admin, user)
--   RepositoryDeletionRequestedByAdmin(admin, repository)  -> repositories (the OwnerDeletesRepository
--                                                       -- cascade, ending in RepositoryDeleted)
--   OrganizationCreatedForUserByAdmin(admin, user, name, visibility)  -> organizations (creates it)
--   RepositoryCreationRequestedByAdmin(admin, user, name)  -> repositories (creates it with the
--                                                       -- instance defaults; no creation limit)
--   SshKeyAddedForUserByAdmin / SshKeyRemovedForUserByAdmin -> keys
--   AccessTokenRequestedForUser(requester, user, token_name, scopes) -> authentication
--   TestMailRequested(admin, address)                   -> notifications
--   MassMailRequested(subject, body, recipients)        -> notifications
--   AuthorizedKeysRegenerationRequested(operator)       -> keys
--   ReleasesSyncWithTagsRequested(operator)             -> releases
--   AuthSourceConfiguredFromCli(operator, kind, action) -> authentication
--   AuthorizedIntegrationRequested(operator, user, name) -> authentication
--   DoctorRunRequested(operator, checks, fix)
--   InstanceDumpProduced(operator, format, contents)
--   RunningInstanceCommanded(operator, command)
--   ProcessCancellationRequested(admin, process)
--
-- Reacts to:
--   SystemFailureReported(kind, description)  -- any module reporting a background
--                                             -- failure (e.g. file removal failed,
--                                             -- repository deletion left files behind)
--   migrations/MigrationFailureReported(kind, description)
--                                             -- a failed import, or source data an import
--                                             -- had to drop, worth an operator's attention
--   CronWorkCompleted(task, outcome, message) -- the owning module reporting the end
--                                             -- of the work it was asked to do
--   ReleaseFeedAnswered(supported_versions, error)  -- the update-check lookup result
--   InstanceStarted(instance)                 -- process start (run-at-start tasks)

use "./accounts.allium" as accounts
use "./access.allium" as access
use "./organizations.allium" as organizations
use "./authentication.allium" as authentication
use "./repositories.allium" as repositories
use "./keys.allium" as keys
use "./code.allium" as code
use "./releases.allium" as releases
use "./webhooks.allium" as webhooks
use "./actions.allium" as actions
use "./packages.allium" as packages
use "./notifications.allium" as notifications
use "./quota.allium" as quota
use "./moderation.allium" as moderation
use "./federation.allium" as federation
use "./discovery.allium" as discovery
use "./migrations.allium" as migrations

------------------------------------------------------------
-- Given
------------------------------------------------------------

-- No module-level given: the single Instance is passed explicitly where a rule
-- needs it; notices, settings and tasks are instance-wide collections.

------------------------------------------------------------
-- External Entities
------------------------------------------------------------

-- A person with a shell on the server host, running the `forgejo` binary against
-- the instance's configuration and database. Not a Forgejo account.
-- from: cmd/admin.go:22
external entity Operator {
    has_host_access: Boolean
}

-- A unit of work currently running inside the server process (a request, a cron
-- run, a queue worker). Infrastructure-level; listed only so administrators can
-- see and cancel runaway work.
-- from: routers/web/admin/stacktrace.go:16
external entity MonitoredProcess {
    description: String
    is_system: Boolean
    started_at: Timestamp
    cancelled: Boolean
}

-- A background work queue (indexers, webhook delivery, mirror sync, ...).
-- Infrastructure-level capability.
-- from: routers/web/admin/queue.go:15
external entity WorkQueue {
    name: String
    max_workers: Integer
    item_count: Integer
}

-- The running server process (code party on integration surfaces).
-- from: services/cron/cron.go:23
external entity ServerProcess {
    is_running: Boolean
}

------------------------------------------------------------
-- Value Types
------------------------------------------------------------

-- (none: the install form and the runtime-setting change are modelled as an
-- entity and as trigger parameters respectively)



------------------------------------------------------------
-- Enumerations
------------------------------------------------------------

enum DatabaseKind { sqlite3 | mysql | postgres }

-- The runtime settings an administrator may change without a restart. Each one
-- falls back to the matching configuration-file value, then to its default.
-- from: modules/setting/config.go:66
enum SettingKey {
    disable_gravatar            -- falls back to [picture] DISABLE_GRAVATAR (default: offline mode)
    | enable_federated_avatar   -- falls back to [picture] ENABLE_FEDERATED_AVATAR
    | open_with_editor_apps     -- "Name = URL-template" lines; default VS Code, VSCodium, IntelliJ IDEA
}

-- from: models/system/notice.go:20
enum NoticeKind { repository | task }

-- Outcome of one cron run as the owning module reports it.
-- from: services/cron/tasks.go:117
enum CronOutcome { finished | failed | cancelled }

-- Which module performs the work of a cron task.
enum OwningModule {
    administration | accounts | authentication | repositories | keys | code
    | releases | webhooks | actions | packages | notifications | moderation
    | discovery | migrations
}

-- A feature switch a task's registration depends on. Tasks whose feature is
-- off are not registered at all (not listed, cannot be run).
-- from: services/cron/tasks_basic.go:157
enum TaskFeature { always | mirrors | migrations | packages | lfs_server | moderation | actions }

-- Every cron task Forgejo registers (services/cron/tasks_basic.go,
-- tasks_extended.go, tasks_actions.go). Names are the stable identifiers used
-- in configuration ([cron.<name>]) and in the "run now" API.
enum CronTaskName {
    update_mirrors
    | repo_health_check
    | check_repo_stats
    | archive_cleanup
    | sync_external_users
    | deleted_branches_cleanup
    | update_migration_poster_id
    | cleanup_hook_task_table
    | cleanup_packages
    | delete_inactive_accounts
    | delete_repo_archives
    | git_gc_repos
    | resync_all_sshkeys
    | resync_all_sshprincipals
    | reinit_missing_repos
    | delete_missing_repos
    | delete_generated_repository_avatars
    | delete_old_actions
    | update_checker
    | delete_old_system_notices
    | gc_lfs
    | rebuild_issue_indexer
    | remove_resolved_reports
    | stop_zombie_tasks
    | stop_endless_tasks
    | cancel_abandoned_jobs
    | transfer_lingering_logs
    | start_schedule_tasks
    | cleanup_actions
    | cleanup_offline_runners
    | actions_action_user
}

-- How the hook delivery cleanup task chooses what to delete.
-- from: services/cron/tasks_basic.go:133
enum HookCleanupKind { older_than | per_webhook }

-- Release-support state derived from the update check.
-- from: modules/updatechecker/update_checker.go:139
enum ReleaseState { unknown | current | minor_update_available | major_unsupported | prerelease }

-- from: modules/service_message/service_message.go:17
enum AnnouncementKind { modal }

-- `forgejo doctor check` — every registered check. Checks marked (default) run
-- when no --run/--all is given. Each can report, and with --fix repair.
-- from: services/doctor/*.go (Register calls)
enum DoctorCheck {
    paths                               -- (default) paths and basic configuration
    | check_db_version                  -- (default) database schema version
    | check_user_type                   -- (default) accounts with an invalid kind
    | authorized_keys                   -- (default) OpenSSH authorized_keys up to date
    | synchronize_repo_heads            -- (default) repository HEAD matches default branch
    | check_db_consistency              -- orphaned rows across tables
    | check_user_email                  -- accounts with an invalid email address
    | check_user_names                  -- accounts with an invalid username
    | check_old_archives                -- legacy archive files
    | fix_broken_repo_units             -- malformed repository unit configuration
    | fix_owner_team_create_org_repo    -- owner teams lacking create-repo permission
    | gc_lfs                            -- garbage-collect unreferenced LFS objects
    | script_type                       -- configured hook script interpreter exists
    | recalculate_stars_number          -- recount stars per repository
    | enable_push_options               -- repositories advertise push options
    | check_git_daemon_export_ok        -- git-daemon-export-ok matches visibility
    | check_commit_graphs               -- commit-graph files present
    | packages_nuget_nuspec             -- extract NuGet nuspec files
    | fix_push_mirrors_without_git_remote
    | delete_orphaned_repos             -- content of repositories whose owner is gone
    | storages                          -- orphaned files in all storages
    | storage_attachments
    | storage_lfs
    | storage_avatars
    | storage_archives
    | storage_packages
    | disable_mirror_actions_unit       -- turn off the actions unit on pull mirrors
}

-- from: cmd/dump.go:107
enum DumpFormat { zip | tar | tar_sz | tar_gz | tar_xz | tar_bz2 | tar_br | tar_lz4 | tar_zst }

-- `forgejo manager …` commands sent to the running server over its private
-- control channel.
-- from: cmd/manager.go:17
enum ManagerCommand { shutdown | restart | reload_templates | flush_queues | list_processes | cancel_process | change_logging }

-- `forgejo admin auth …` sub-commands. Behaviour is authentication's.
-- from: cmd/admin.go:55
enum AuthSourceCliAction { add | update | list | delete }
enum AuthSourceCliKind { oauth2 | ldap_bind_dn | ldap_simple | pam | smtp }

------------------------------------------------------------
-- Entities and Variants
------------------------------------------------------------

-- The running instance. Exactly one exists.
-- from: routers/install/install.go:223, routers/web/admin/admin.go:131
entity Instance {
    install_status: awaiting_install | installed
    app_name: String
    root_url: String
    version: String
    started_at: Timestamp

    -- reachability as last probed (health endpoint)
    database_reachable: Boolean
    cache_reachable: Boolean

    -- release/update check (fed by the update_checker cron task)
    supported_versions: Set<String>
    update_check_error: String?
    release_state: ReleaseState
    recommended_upgrade: String?

    transitions install_status {
        awaiting_install -> installed
        terminal: installed
    }

    -- Health: before installation only the bare "pass" is reported; afterwards
    -- database and cache are checked and either failing makes the whole fail.
    -- from: routers/web/healthcheck/check.go:61
    is_installed: install_status = installed
    health_status: if install_status = awaiting_install: pass
                   else if database_reachable and cache_reachable: pass
                   else: fail
}

-- One submission of the install wizard: everything it collects, plus the
-- outcome of the environment checks run against it. Most of it is written to
-- the instance configuration file and becomes config of other modules
-- (registration, mail, LFS, SSH, ...); this module owns only the act of
-- installing.
-- from: services/forms/user_form.go (InstallForm), routers/install/install.go:223
entity InstallSettings {
    app_name: String
    app_slogan: String?
    root_url: String              -- normalised to end with "/"
    domain: String
    http_port: Integer
    ssh_port: Integer             -- 0 disables SSH
    database_kind: DatabaseKind
    database_reachable: Boolean   -- connection test succeeded
    database_previously_used: Boolean   -- schema version > 0 AND accounts exist
    reinstall_confirmed: Boolean  -- all three re-install confirmations ticked
    repository_root: String
    lfs_root: String?             -- absent disables the built-in LFS server
    log_root: String
    paths_writable: Boolean       -- data, repository, LFS and log paths can be created
    run_user_matches: Boolean     -- the configured RUN_USER is the OS user running the process
    git_available: Boolean        -- a git binary is on PATH
    ssh_authorized_keys_clean: Boolean  -- no unexpected keys in authorized_keys (only checked when ssh_port > 0)
    smtp_address: String?         -- absent disables mail
    smtp_from: String?            -- must parse as a mail address when smtp_address is set
    register_email_confirm: Boolean
    enable_notify_mail: Boolean
    offline_mode: Boolean
    disable_gravatar: Boolean
    enable_federated_avatar: Boolean
    disable_registration: Boolean
    allow_only_external_registration: Boolean
    enable_captcha: Boolean
    require_signin_view: Boolean
    default_keep_email_private: Boolean
    default_allow_create_organization: Boolean
    default_enable_timetracking: Boolean
    no_reply_address: String
    enable_update_checker: Boolean
    password_hash_algorithm: String?
    admin_name: String?           -- absent: no administrator is created now
    admin_email: String?
    admin_password: String?
    admin_password_confirm: String?
}

-- One runtime setting stored by the instance and overriding the config file.
-- from: models/system/setting.go:19
entity SystemSetting {
    key: SettingKey
    value: String           -- normalised: "true"/"false" for flags; a list of
                            -- {display name, URL template} for editor apps
    version: Integer        -- increments on every write
    updated_at: Timestamp
}

-- An entry in the system-notice log: something went wrong in background work
-- (or a cron task with notice-on-success finished). Administrators read and
-- clear them; they age out when the cleanup task is enabled.
-- from: models/system/notice.go:27
entity SystemNotice {
    kind: NoticeKind
    description: String
    created_at: Timestamp
}

-- A scheduled maintenance task. The set of tasks is fixed by the software (see
-- the defaults below); configuration ([cron.<name>]) only changes enabled,
-- run_at_start, schedule, notice_on_success and task-specific parameters.
-- from: services/cron/tasks.go:32
entity CronTask {
    name: CronTaskName
    owner: OwningModule            -- the module whose work this task triggers
    requires_feature: TaskFeature  -- not registered when that feature is off
    enabled: Boolean               -- scheduled; a disabled task can still be run by hand
    run_at_start: Boolean          -- also run once when the instance starts (if enabled)
    schedule: String               -- cron spec or descriptor: "@midnight", "@every 10m", 5/6-field crontab
    notice_on_success: Boolean     -- also record a SystemNotice when a run finishes cleanly
    shown_on_dashboard: Boolean    -- offered as a one-click operation on the admin dashboard

    run_state: idle | running
    last_outcome: never_run | finished | failed | cancelled
    last_message: String?          -- error / cancellation message of the last run
    last_doer: accounts/User?      -- administrator who started the last run; null = the scheduler
    last_run_at: Timestamp?        -- start of the most recent run (scheduled or manual)
    next_run_at: Timestamp?        -- next scheduled start; null when not enabled
    exec_times: Integer            -- runs started since the process started

    transitions run_state {
        idle -> running
        running -> idle
    }

    is_scheduled: enabled = true
}

-- A site-wide announcement shown to signed-in users as a modal until each user
-- acknowledges it. At most one per kind; publishing again replaces its text and
-- re-shows it to everybody.
-- from: models/service_message/service_message.go:21
entity Announcement {
    kind: AnnouncementKind
    title: String           -- at most 255 bytes; longer titles are cut
    text: String            -- Markdown, rendered in the modal
    created_at: Timestamp
    updated_at: Timestamp

    acknowledgements: AnnouncementAcknowledgement with kind = this.kind

    is_pending_for(u): not acknowledgements.any(a => a.user = u and a.acknowledged_at >= updated_at)
}

-- That a user dismissed the announcement of a kind at a moment. A newer
-- announcement (updated after that moment) shows again.
-- from: models/user/user.go:380
entity AnnouncementAcknowledgement {
    user: accounts/User
    kind: AnnouncementKind
    acknowledged_at: Timestamp
}

-- One line of the read-only configuration view. Secrets (passwords, URIs with
-- credentials, connection strings) are shown masked.
-- from: routers/web/admin/config.go:117
entity ConfigEntry {
    section: String
    key: String
    value: String
    is_secret: Boolean

    displayed_value: if is_secret: masked(value) else: value
}

------------------------------------------------------------
-- Config
------------------------------------------------------------

config {
    -- [security] INSTALL_LOCK: once true the install wizard is gone for good.
    -- from: modules/setting/setting.go:248
    install_lock: Boolean = false

    -- [admin]
    -- from: modules/setting/admin.go:20
    -- DISABLE_REGULAR_ORG_CREATION lives in organizations' config
    -- (organizations/config.disable_regular_org_creation).
    default_email_notifications: String = "enabled"    -- enabled | onmention | disabled; new accounts' default (notifications)
    notify_admins_on_new_user: Boolean = false         -- SEND_NOTIFICATION_EMAIL_ON_NEW_USER (notifications)
    user_disabled_features: Set<String> = {}           -- deletion, manage_ssh_keys, manage_gpg_keys, manage_password
    external_user_disabled_features: Set<String> = {}  -- same list, for accounts from external auth sources

    -- [ui.admin] page sizes of the admin lists
    -- from: modules/setting/ui.go:133
    admin_user_page_size: Integer = 50
    admin_repo_page_size: Integer = 50
    admin_org_page_size: Integer = 50
    admin_notice_page_size: Integer = 25

    -- Announcement title limit
    -- from: models/service_message/service_message.go:33
    announcement_title_max_bytes: Integer = 255

    -- Per-task parameters ([cron.<name>] KEY). The common keys ENABLED,
    -- RUN_AT_START, SCHEDULE and NOTICE_ON_SUCCESS are on each default CronTask.
    -- from: services/cron/tasks_basic.go, tasks_extended.go, tasks_actions.go
    update_mirrors_pull_limit: Integer = 50
    update_mirrors_push_limit: Integer = 50
    repo_health_check_timeout: Duration = 360.seconds      -- [git.timeout] DEFAULT
    repo_health_check_args: String = ""
    archive_cleanup_older_than: Duration = 24.hours
    sync_external_users_update_existing: Boolean = true
    deleted_branches_cleanup_older_than: Duration = 24.hours
    cleanup_hook_task_table_cleanup_type: HookCleanupKind = older_than
    cleanup_hook_task_table_older_than: Duration = 168.hours
    cleanup_hook_task_table_number_to_keep: Integer = 10
    cleanup_packages_older_than: Duration = 24.hours
    delete_inactive_accounts_older_than: Duration = 180.minutes   -- [service] ACTIVE_CODE_LIVE_MINUTES
    git_gc_repos_timeout: Duration = 60.seconds            -- [git.timeout] GC
    git_gc_repos_args: String = ""                         -- [git] GC_ARGS
    delete_old_actions_older_than: Duration = 365.days
    update_checker_http_endpoint: String = "https://dl.gitea.com/gitea/version.json"
    update_checker_domain_endpoint: String = "release.forgejo.org"   -- DNS TXT "forgejo_versions=..." preferred over HTTP
    delete_old_system_notices_older_than: Duration = 365.days
    gc_lfs_older_than: Duration = 7.days
    gc_lfs_last_updated_more_than_ago: Duration = 3.days
    gc_lfs_number_to_check_per_repo: Integer = 100
    gc_lfs_proportion_to_check_per_repo: Decimal = 0.6
    remove_resolved_reports_keep_for: Duration = 168.hours  -- [moderation] KEEP_RESOLVED_REPORTS_FOR
    cleanup_offline_runners_older_than: Duration = 24.hours
    cleanup_offline_runners_global_scope_only: Boolean = true
}

------------------------------------------------------------
-- Defaults
------------------------------------------------------------

-- The complete, fixed catalogue of cron tasks with Forgejo's defaults.
-- Each is overridable per instance in [cron.<name>].

-- Basic tasks (enabled by default)
-- from: services/cron/tasks_basic.go:29
default CronTask update_mirrors = { name: update_mirrors, owner: repositories, requires_feature: mirrors, enabled: true, run_at_start: false, schedule: "@every 10m", notice_on_success: false, shown_on_dashboard: false, run_state: idle, last_outcome: never_run, exec_times: 0 }
-- from: services/cron/tasks_basic.go:47
default CronTask repo_health_check = { name: repo_health_check, owner: repositories, requires_feature: always, enabled: true, run_at_start: false, schedule: "@midnight", notice_on_success: false, shown_on_dashboard: true, run_state: idle, last_outcome: never_run, exec_times: 0 }
