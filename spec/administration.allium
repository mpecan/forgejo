------------------------------------------------------------
-- Rules
------------------------------------------------------------

------------------------------------------------------------
-- Installation
------------------------------------------------------------

-- The first-run wizard. Only reachable while the install lock is off; it tests
-- every input, writes the configuration (setting the lock), stores the two
-- avatar runtime settings, optionally creates the first administrator and
-- signs them in, then hands over to the normal server.
-- from: routers/install/install.go:223
rule VisitorInstallsInstance {
    when: VisitorSubmitsInstallation(visitor, instance, settings)
    requires: instance.install_status = awaiting_install
    requires: settings.git_available
    requires: settings.database_reachable
    -- a database that already holds accounts and a schema needs triple confirmation
    requires: not settings.database_previously_used or settings.reinstall_confirmed
    requires: settings.paths_writable
    requires: settings.run_user_matches
    requires: settings.ssh_port = 0 or settings.ssh_authorized_keys_clean
    requires: settings.smtp_address = null or is_mail_address(settings.smtp_from)
    -- closing registration without creating an administrator would lock everyone out
    requires: not settings.disable_registration or settings.admin_name != null
    requires: settings.password_hash_algorithm = null or is_known_hash_algorithm(settings.password_hash_algorithm)
    ensures: instance.install_status = installed
    ensures: instance.app_name = settings.app_name
    ensures: instance.root_url = settings.root_url
    ensures: SystemSetting.created(key: disable_gravatar, value: settings.disable_gravatar, version: 1, updated_at: now)
    ensures: SystemSetting.created(key: enable_federated_avatar, value: settings.enable_federated_avatar, version: 1, updated_at: now)
    ensures:
        if settings.admin_name != null:
            InstallerCreatesFirstAdmin(settings: settings)
    ensures: InstallationCompleted(instance: instance)
    @guidance
        -- Also written to configuration: database, repository root, domain,
        -- SSH (disabled when port 0), LFS (enabled with a fresh signing secret
        -- when a path is given), mail, registration and service defaults, the
        -- update-checker switch, a new SECRET_KEY (never overwriting an existing
        -- one), OpenID sign-in/up off, run mode "prod". Every path is created.
        -- Submitting again once installed just shows the "installed" page.
        -- The wizard serves only `/`, `/post-install` and `/api/healthz`;
        -- every other path is not-found until installation finishes.
}

-- from: routers/install/install.go:319
rule InstallerCreatesFirstAdmin {
    when: InstallerCreatesFirstAdmin(settings)
    requires: is_usable_username(settings.admin_name)
    requires: settings.admin_email != null
    requires: settings.admin_password != null
    requires: settings.admin_password = settings.admin_password_confirm
    requires: password_long_enough(settings.admin_password)
    ensures: accounts/User.created(
        name: settings.admin_name,
        primary_email: settings.admin_email,
        is_admin: true,
        is_active: true,
        is_restricted: false,
        prohibit_login: false
    )
    ensures: FirstAdminSignedIn(name: settings.admin_name)
    @guidance
        -- The admin checks happen before anything is written, so a rejected
        -- admin leaves the instance uninstalled. If an account of that name
        -- already exists (re-install into a used database) it is reused and
        -- signed in instead of failing.
}

------------------------------------------------------------
-- Instance start, release check
------------------------------------------------------------

-- At start, every enabled task is scheduled, and those flagged run-at-start
-- run once immediately.
-- from: services/cron/cron.go:32
rule ScheduleTasksAtStart {
    when: InstanceStarted(instance)
    ensures:
        for task in CronTasks where enabled = true:
            task.next_run_at = now + time_until_next(task.schedule)
            if task.run_at_start:
                CronTaskRunRequested(task: task, doer: null)
    @guidance
        -- Disabled tasks are registered (listed, runnable by hand) but never
        -- scheduled. No global switch overrides the per-task flags
        -- (decided: administration 2).
}

-- The update_checker task asks the release feed which versions are supported;
-- the answer decides the dashboard's "update available" banner.
-- from: modules/updatechecker/update_checker.go:111
rule RecordReleaseFeedAnswer {
    when: ReleaseFeedAnswered(instance, supported_versions, error)
    ensures: instance.supported_versions = supported_versions
    ensures: instance.update_check_error = error
    ensures: instance.release_state = release_state_of(instance.version, supported_versions)
    ensures: instance.recommended_upgrade = recommended_upgrade_of(instance.version, supported_versions)
    -- decided: requests 5 (the update_checker run ends with the answer; a
    -- failed lookup is a failed run)
    ensures:
        for task in CronTasks where name = update_checker and run_state = running:
            if error = null:
                CronWorkCompleted(job: task, outcome: finished, message: null)
            else:
                CronWorkCompleted(job: task, outcome: failed, message: error)
}

------------------------------------------------------------
-- Runtime settings
------------------------------------------------------------

-- from: routers/web/admin/config.go:199
rule AdminChangesSetting {
    when: AdminChangesSetting(admin, key, raw_value)
    requires: admin.is_admin = true
    let existing = SystemSetting{key: key}
    let normalised = normalise_setting(key, raw_value)
    ensures:
        if exists existing:
            existing.value = normalised
            existing.version = existing.version + 1
            existing.updated_at = now
        else:
            SystemSetting.created(key: key, value: normalised, version: 1, updated_at: now)
    ensures: RuntimeSettingChanged(key: key)
    @guidance
        -- Flags accept any truthy spelling and store "true"/"false". Editor apps
        -- are one "Display Name = URL template" per line; malformed lines are
        -- dropped. Unknown keys are refused (the enum enforces it). Every
        -- server process must see the change promptly (Forgejo re-reads the
        -- store at most once a second, keyed on a global revision counter).
}

------------------------------------------------------------
-- System notices
------------------------------------------------------------

-- from: models/system/notice.go:41
rule RecordSystemNotice {
    when: SystemFailureReported(kind, description)
    ensures: SystemNotice.created(kind: kind, description: description, created_at: now)
    ensures: SystemNoticeRecorded(kind: kind)
}

-- A failed migration, or source data an import had to drop, leaves a notice.
-- migrations decides which of its failures merit one and words it.
-- from: services/migrations/migrate.go:57, services/migrations/common.go:17
rule RecordMigrationFailureNotice {
    when: migrations/MigrationFailureReported(kind, description)
    ensures: SystemNotice.created(kind: kind, description: description, created_at: now)
    ensures: SystemNoticeRecorded(kind: kind)
}

-- A purge that stopped short leaves a notice so an admin resumes it.
-- from: services/user/user.go:183
rule RecordAccountPurgeFailureNotice {
    when: accounts/AccountPurgeFailed(purge)
    ensures: SystemNotice.created(kind: task, description: purge_failure_notice_text(purge), created_at: now)
    ensures: SystemNoticeRecorded(kind: task)
}

-- A directory / OAuth2 key refused by the key policy (decided: keys 2).
rule RecordRefusedExternalKeyNotice {
    when: keys/ExternalSshKeyRefused(user, source, fingerprint)
    ensures: SystemNotice.created(kind: task, description: refused_key_notice_text(user, source, fingerprint), created_at: now)
    ensures: SystemNoticeRecorded(kind: task)
}

-- An LDAP synchronisation found nobody in the directory and was refused rather
-- than deactivate every account of the source (decided: requests 8).
rule RecordRefusedDirectorySyncNotice {
    when: authentication/ExternalUserSyncRefused(source)
    ensures: SystemNotice.created(kind: task, description: refused_sync_notice_text(source), created_at: now)
    ensures: SystemNoticeRecorded(kind: task)
}

-- Background repository failures worth an operator's attention.
-- from: services/mirror/mirror_pull.go:248
rule RecordPullMirrorFailureNotice {
    when: repositories/PullMirrorSyncFailed(mirror, reason)
    ensures: SystemNotice.created(kind: repo, description: reason, created_at: now)
    ensures: SystemNoticeRecorded(kind: repo)
}

-- git fsck found a broken repository (repo_health_check).
-- from: services/repository/check.go:24
rule RecordHealthCheckFailureNotice {
    when: repositories/RepositoryHealthCheckFailed(repository, reason)
    ensures: SystemNotice.created(kind: repo, description: reason, created_at: now)
    ensures: SystemNoticeRecorded(kind: repo)
}

-- git gc failed on a repository (git_gc_repos).
-- from: services/repository/check.go:61
rule RecordGarbageCollectionFailureNotice {
    when: repositories/RepositoryGarbageCollectionFailed(repository, reason)
    ensures: SystemNotice.created(kind: repo, description: reason, created_at: now)
    ensures: SystemNoticeRecorded(kind: repo)
}

-- An indexer did not start in time: search is unavailable until it is ready
-- (decided: discovery 4).
rule RecordIndexerStartupFailureNotice {
    when: discovery/IndexerStartupFailed(kind)
    ensures: SystemNotice.created(kind: task, description: indexer_notice_text(kind), created_at: now)
    ensures: SystemNoticeRecorded(kind: task)
    @guidance
        -- indexer_notice_text: "<kind> indexer did not start in time; search
        -- is unavailable until it is ready".
}

-- Removing a deleted account's stored files (avatar, user directory) failed.
-- from: services/user/user.go:300
rule RecordAccountFilesLeftBehindNotice {
    when: accounts/AccountFilesLeftBehind(user_name, description)
    ensures: SystemNotice.created(kind: task, description: description, created_at: now)
    ensures: SystemNoticeRecorded(kind: task)
}

-- from: routers/web/admin/notice.go:46
rule AdminDeletesNotices {
    when: AdminDeletesNotices(admin, notices)
    requires: admin.is_admin = true
    ensures:
        for n in notices:
            not exists n
}

-- from: routers/web/admin/notice.go:66
rule AdminEmptiesNotices {
    when: AdminEmptiesNotices(admin)
    requires: admin.is_admin = true
    ensures:
        for n in SystemNotices:
            not exists n
}

------------------------------------------------------------
-- Cron: scheduling and recording
------------------------------------------------------------

-- A task falls due on its schedule.
-- from: services/cron/tasks.go:209
rule CronTaskFallsDue {
    when: task: CronTask.next_run_at <= now
    requires: task.enabled = true
    ensures: task.next_run_at = now + time_until_next(task.schedule)
    ensures: CronTaskRunRequested(task: task, doer: null)
}

-- An administrator runs a task now — from the dashboard, the cron monitor page,
-- or POST /api/v1/admin/cron/{task}. Disabled tasks can be run this way.
-- The admin is the doer on every path (Forgejo's API path records the scheduler).
-- decided: administration 1 (the admin who triggered it, on every path)
-- from: routers/web/admin/admin.go:207
rule AdminRunsCronTask {
    when: AdminRunsCronTask(admin, task)
    requires: admin.is_admin = true
    ensures: CronTaskRunRequested(task: task, doer: admin)
}

-- A run starts only if the same task is not already running; a request while
-- running is silently dropped (no queueing, no overlap).
-- from: services/cron/tasks.go:72
rule StartCronTaskRun {
    when: CronTaskRunRequested(task, doer)
    requires: task.run_state = idle
    ensures: task.run_state = running
    ensures: task.exec_times = task.exec_times + 1
    ensures: task.last_run_at = now
    ensures: task.last_doer = doer
    ensures: CronTaskExecutes(task: task, doer: doer)
}

-- The owning module reports how the work went.
-- from: services/cron/tasks.go:108
rule FinishCronTaskRun {
    when: CronWorkCompleted(job, outcome, message)
    requires: job.run_state = running
    ensures: job.run_state = idle
    ensures: job.last_outcome = outcome
    ensures: job.last_message = message
    ensures:
        if outcome != finished:
            SystemNotice.created(kind: task, description: cron_notice_text(job, outcome, message), created_at: now)
        else if job.notice_on_success:
            SystemNotice.created(kind: task, description: cron_notice_text(job, outcome, message), created_at: now)
    ensures: CronTaskRunFinished(task: job, outcome: outcome)
    @guidance
        -- A panic/crash inside the work is caught and logged; the job returns
        -- to idle so the next schedule still fires.
}

-- accounts reports the end of the delete_inactive_accounts sweep with a
-- trigger of its own (it is not handed the task); the run finishes here.
rule FinishInactiveAccountCleanupRun {
    when: accounts/InactiveAccountCleanupFinished(older_than)
    ensures:
        for task in CronTasks where name = delete_inactive_accounts and run_state = running:
            CronWorkCompleted(job: task, outcome: finished, message: null)
}

-- keys reports that the authorized_keys / authorized_principals rewrite is
-- done (resync_all_sshkeys / resync_all_sshprincipals, or the operator's
-- regenerate command, which runs no task: then nothing is running).
rule FinishKeyFilesRewriteRun {
    when: keys/KeyFilesRewritten(kind)
    ensures:
        for task in CronTasks where run_state = running and ((kind = authorized_keys and name = resync_all_sshkeys) or (kind = authorized_principals and name = resync_all_sshprincipals)):
            CronWorkCompleted(job: task, outcome: finished, message: null)
}

