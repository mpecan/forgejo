------------------------------------------------------------
-- Announcement (service message)
------------------------------------------------------------

-- from: routers/web/admin/service_message.go:45
-- decided: administration 5 (modal or banner, each with optional start and end times)
rule AdminPublishesAnnouncement {
    when: AdminPublishesAnnouncement(admin, kind, title, text, starts_at, ends_at)
    requires: admin.is_admin = true
    requires: title != ""
    requires: text != ""
    requires: starts_at = null or ends_at = null or starts_at < ends_at
    let existing = Announcement{kind: kind}
    let stored_title = truncate_bytes(title, config.announcement_title_max_bytes)
    ensures:
        if exists existing:
            existing.title = stored_title
            existing.text = text
            existing.starts_at = starts_at
            existing.ends_at = ends_at
            existing.updated_at = now
        else:
            Announcement.created(kind: kind, title: stored_title, text: text, starts_at: starts_at, ends_at: ends_at, created_at: now, updated_at: now)
    ensures: AnnouncementPublished(kind: kind)
    @guidance
        -- The admin page also offers a preview of the rendered modal or
        -- banner, which changes nothing. A modal and a banner may be live at
        -- the same time (one of each kind).
}

-- from: routers/web/admin/service_message.go:71
rule AdminWithdrawsAnnouncement {
    when: AdminWithdrawsAnnouncement(admin, announcement)
    -- read before the record goes: an emission sees the resulting state
    let withdrawn_kind = announcement.kind
    requires: admin.is_admin = true
    ensures: not exists announcement
    ensures: AnnouncementWithdrawn(kind: withdrawn_kind)
}

-- from: routers/web/user/service_message.go:15
rule UserAcknowledgesAnnouncement {
    when: UserAcknowledgesAnnouncement(user, announcement)
    let existing = AnnouncementAcknowledgement{user: user, kind: announcement.kind}
    ensures:
        if exists existing:
            existing.acknowledged_at = now
        else:
            AnnouncementAcknowledgement.created(user: user, kind: announcement.kind, acknowledged_at: now)
}

------------------------------------------------------------
-- Admin management of users
------------------------------------------------------------

-- Create an account on someone's behalf (web form, API, also CLI below).
-- The account is active immediately and is not subject to the email domain
-- allow/block list (a warning only). A local password must satisfy the
-- password policy (length, complexity, breach check).
-- from: routers/web/admin/users.go:127
rule AdminCreatesUser {
    when: AdminCreatesUser(admin, name, email, password, login_source, login_name, visibility, must_change_password, restricted, send_notification)
    requires: admin.is_admin = true
    requires: is_usable_username(name)
    requires: not (exists accounts/ReservedName{name: name})   -- accounts: reserved until AdminReleasesName
    requires: not username_taken(name)
    requires: is_valid_email(email)
    requires: not email_in_use(email)
    requires: login_source != null or password_acceptable(password)
    ensures:
        let user = accounts/User.created(
            name: name,
            kind: individual,
            primary_email: email,
            is_admin: false,
            is_active: true,
            is_restricted: restricted,
            prohibit_login: false,
            visibility: visibility,
            created_at: now
        )
        accounts/EmailAddress.created(user: user, address: email, is_activated: true, is_primary: true)
        authentication/UserLogin.created(
            user: user,
            source: login_source,
            login_name: if login_name != null: login_name else: name,
            has_password: login_source = null,
            must_change_password: login_source = null and must_change_password,
            password_changed_at: now,
            last_sign_in_at: null
        )
        UserCreatedByAdmin(admin: admin, user: user, send_notification: send_notification)
    @guidance
        -- must_change_password: web form checkbox (default unchecked); API
        -- defaults to true; CLI defaults to true except for the very first
        -- account. Ignored for accounts bound to an external login source.
        -- restricted: API/CLI may set it; otherwise the instance default.
        -- The API may also back-date the creation time (`created`).
        -- All other creation defaults are accounts' (as for self-registration,
        -- minus reserved-prefix, cooldown and email-domain checks).
}

-- Admins weakening themselves: one guard for all of it. A self-edit that
-- would leave no other active admin — demote, restrict, deactivate, prohibit
-- sign-in — is refused (has_other_admin counts active administrators who may
-- sign in).
-- decided: administration 6 (one guard for every self-weakening edit)

-- Grant or revoke site administration. The last administrator can never be
-- demoted.
-- from: services/user/update.go:113
rule AdminSetsUserAdmin {
    when: AdminSetsUserAdmin(admin, user, value)
    requires: admin.is_admin = true
    requires: not user.being_purged     -- accounts invariant PurgingAccountStaysDisabled
    -- the last administrator cannot be demoted
    requires: value = true or not user.is_admin or has_other_admin(user)
    ensures: user.is_admin = value
    ensures: UserEditedByAdmin(admin: admin, user: user)
}

-- from: routers/web/admin/users.go:451
-- decided: administration 6 (restricting oneself needs another active admin)
rule AdminSetsUserRestricted {
    when: AdminSetsUserRestricted(admin, user, value)
    requires: admin.is_admin = true
    requires: user != admin or value = false or has_other_admin(admin)
    ensures: user.is_restricted = value
    ensures: UserEditedByAdmin(admin: admin, user: user)
}

-- Block (or unblock) sign-in. Blocking oneself is refused unless another
-- active administrator remains (Forgejo silently forces the flag off instead).
-- decided: administration 6 (one guard for every self-weakening edit)
-- from: routers/web/admin/users.go:391
rule AdminSetsProhibitLogin {
    when: AdminSetsProhibitLogin(admin, user, value)
    requires: admin.is_admin = true
    requires: value = true or not user.being_purged    -- accounts invariant PurgingAccountStaysDisabled
    requires: user != admin or value = false or has_other_admin(admin)
    ensures: user.prohibit_login = value
    ensures: UserEditedByAdmin(admin: admin, user: user)
}

-- decided: administration 6 (deactivating oneself needs another active admin)
-- from: routers/web/admin/users.go:447
rule AdminSetsUserActive {
    when: AdminSetsUserActive(admin, user, value)
    requires: admin.is_admin = true
    requires: not user.being_purged     -- accounts invariant PurgingAccountStaysDisabled
    requires: user != admin or value = true or has_other_admin(admin)
    ensures: user.is_active = value
    ensures: UserEditedByAdmin(admin: admin, user: user)
}

-- null = instance default, 0 = may not create repositories, n = at most n.
-- (Forgejo encodes the default as -1.)
-- from: routers/web/admin/users.go:451
rule AdminSetsMaxRepoCreation {
    when: AdminSetsMaxRepoCreation(admin, user, limit)
    requires: admin.is_admin = true
    requires: limit = null or limit >= 0
    ensures: user.max_repo_creation = limit
    ensures: UserEditedByAdmin(admin: admin, user: user)
}

-- Admins may set any visibility the instance allows for users.
-- from: routers/web/admin/users.go:451
rule AdminSetsUserVisibility {
    when: AdminSetsUserVisibility(admin, user, visibility)
    requires: admin.is_admin = true
    ensures: user.visibility = visibility
    ensures: UserEditedByAdmin(admin: admin, user: user)
}

-- Per-account capabilities only an admin can grant.
-- from: routers/web/admin/users.go:451
rule AdminSetsUserPermissions {
    when: AdminSetsUserPermissions(admin, user, allow_git_hook, allow_import_local, allow_create_organization)
    requires: admin.is_admin = true
    ensures: user.allow_git_hook = allow_git_hook
    ensures: user.allow_import_local = allow_import_local
    ensures: user.allow_create_organization = allow_create_organization
    ensures: UserEditedByAdmin(admin: admin, user: user)
}

-- Profile fields an admin may overwrite (full name, website, location,
-- pronouns, description, language, hide email).
-- from: routers/web/admin/users.go:442
rule AdminEditsUserProfile {
    when: AdminEditsUserProfile(admin, user, full_name, website, location, pronouns, description, keep_email_private)
    requires: admin.is_admin = true
    ensures: user.full_name = full_name
    ensures: user.website = website
    ensures: user.location = location
    ensures: user.pronouns = pronouns
    ensures: user.description = description
    ensures: user.keep_email_private = keep_email_private
    ensures: UserEditedByAdmin(admin: admin, user: user)
}

-- Set a new password (subject to the password policy), optionally forcing a
-- change at next sign-in.
-- from: routers/api/v1/admin/user.go:166
rule AdminSetsUserPassword {
    when: AdminSetsUserPassword(admin, user, password, must_change_password)
    requires: admin.is_admin = true
    requires: password_acceptable(password)
    let login = authentication/UserLogin{user: user}
    ensures: login.has_password = true
    ensures: login.must_change_password = must_change_password
    ensures: login.password_changed_at = now
    ensures: UserPasswordSetByAdmin(admin: admin, user: user, password: password)
}

-- Rebind an account to a login source and login name (source and name
-- together, via the API). decided: requests 4 — the binding is authentication's
-- login record, so authentication applies it (RebindLoginForAdmin).
-- from: routers/api/v1/admin/user.go:170
rule AdminSetsUserLoginSource {
    when: AdminSetsUserLoginSource(admin, user, login_source, login_name)
    requires: admin.is_admin = true
    requires: login_name != null
    ensures: UserLoginSourceSetByAdmin(admin: admin, user: user, login_source: login_source, login_name: login_name)
    ensures: UserEditedByAdmin(admin: admin, user: user)
}

-- Replace the primary email. Existing address of the same user is promoted;
-- a new one is added already activated. Domain allow/block lists do not apply.
-- from: services/user/email.go:22
rule AdminSetsUserPrimaryEmail {
    when: AdminSetsUserPrimaryEmail(admin, user, address)
    requires: admin.is_admin = true
    requires: is_valid_email(address)
    requires: not email_used_by_other(address, user)
    let old_primary = user.primary_email
    let existing = accounts/EmailAddress{user: user, address: address}
    -- the old primary stays as a secondary address
    ensures:
        for e in user.email_addresses where is_primary:
            e.is_primary = false
    ensures:
        if exists existing:
            existing.is_primary = true
            existing.is_activated = true
        else:
            accounts/EmailAddress.created(user: user, address: address, is_activated: true, is_primary: true)
    ensures: user.primary_email = address
    ensures: UserPrimaryEmailSetByAdmin(admin: admin, user: user, old_address: old_primary, new_address: address)
    ensures: UserEditedByAdmin(admin: admin, user: user)
}

-- Rename. Unlike self-service rename, works for accounts from external sources
-- and ignores the cooldown on recently released names.
-- from: services/user/user.go:42
rule AdminRenamesUser {
    when: AdminRenamesUser(admin, user, new_name)
    requires: admin.is_admin = true
    requires: is_usable_username(new_name)
    requires: not username_taken(new_name) or lower(new_name) = lower(user.name)
    requires: lower(new_name) = lower(user.name) or not (exists accounts/ReservedName{name: new_name})   -- accounts: reserved until AdminReleasesName
    let old_name = user.name
    ensures: user.name = new_name
    ensures: UserRenamedByAdmin(admin: admin, user: user, old_name: old_name, new_name: new_name)
}

-- Remove every second factor (TOTP and security keys) of an account.
-- from: routers/web/admin/users.go:466
rule AdminResetsUserTwoFactor {
    when: AdminResetsUserTwoFactor(admin, user)
    requires: admin.is_admin = true
    ensures: UserTwoFactorResetByAdmin(admin: admin, user: user)
}

-- from: routers/web/admin/users.go:542
rule AdminChangesUserAvatar {
    when: AdminChangesUserAvatar(admin, user, image)
    requires: admin.is_admin = true
    ensures: UserAvatarChangedByAdmin(admin: admin, user: user)
}

-- from: routers/web/admin/users.go:559
rule AdminRemovesUserAvatar {
    when: AdminRemovesUserAvatar(admin, user)
    requires: admin.is_admin = true
    ensures: UserAvatarRemovedByAdmin(admin: admin, user: user)
}

-- Delete an account. Without purge the account must own nothing (no
-- repositories, no organization memberships, no packages). With purge the
-- account is first disabled (inactive, restricted, not admin, login prohibited,
-- password cleared, sessions told to log out), then its repositories, its
-- packages and federated identity are deleted and it leaves every organization
-- — organizations it was the last owner of are deleted with it.
-- from: services/user/user.go:183
rule AdminDeletesUser {
    when: AdminDeletesUser(admin, user, purge)
    requires: admin.is_admin = true
    requires: user != admin
    requires: not user.is_admin or has_other_admin(user)
    requires: purge or not owns_content(user)
    -- accounts removes the account at the end of its cascade (AdminDeletionCascades).
    ensures: UserDeletedByAdmin(admin: admin, user: user, purge: purge)
}

-- The instance-wide email directory: (de)activate an address. Activating is
-- refused if the same address is active on another account. (De)activating a
-- primary address also (de)activates the account.
-- from: models/user/email_address.go:361
rule AdminSetsEmailActivation {
    when: AdminSetsEmailActivation(admin, email, activate)
    requires: admin.is_admin = true
    requires: not activate or not email_active_elsewhere(email)
    ensures: email.is_activated = activate
    ensures:
        if email.is_primary:
            email.user.is_active = activate
}

-- A primary address cannot be deleted.
-- from: routers/web/admin/emails.go:156
rule AdminDeletesEmail {
    when: AdminDeletesEmail(admin, email)
    requires: admin.is_admin = true
    requires: not email.is_primary
    ensures: not exists email
}

-- Create an organization owned by a user (API).
-- from: routers/api/v1/admin/org.go:21
rule AdminCreatesOrganizationForUser {
    when: AdminCreatesOrganizationForUser(admin, user, name, visibility)
    requires: admin.is_admin = true
    requires: is_usable_username(name)
    requires: not (exists accounts/ReservedName{name: name})   -- accounts: reserved until AdminReleasesName
    requires: not username_taken(name)
    ensures: OrganizationCreatedForUserByAdmin(admin: admin, user: user, name: name, visibility: visibility)
}

-- Create a repository owned by a user (API).
-- from: routers/api/v1/admin/repo.go:14
rule AdminCreatesRepositoryForUser {
    when: AdminCreatesRepositoryForUser(admin, user, name)
    requires: admin.is_admin = true
    -- repositories owns creation: it reacts by creating the repository with
    -- the instance defaults (empty description, public, not a template, not
    -- initialised, the default object format); a site admin is not held to
    -- the owner's creation limit.
    ensures: RepositoryCreationRequestedByAdmin(admin: admin, user: user, name: name)
}

-- Add / remove an SSH key on a user's account (API).
-- from: routers/api/v1/admin/user.go:329
rule AdminAddsSshKeyForUser {
    when: AdminAddsSshKeyForUser(admin, user, key_content, title)
    requires: admin.is_admin = true
    ensures: SshKeyAddedForUserByAdmin(admin: admin, user: user, key_content: key_content, title: title)
}

-- from: routers/api/v1/admin/user.go:361
rule AdminRemovesSshKeyOfUser {
    when: AdminRemovesSshKeyOfUser(admin, user, key)
    requires: admin.is_admin = true
    ensures: SshKeyRemovedForUserByAdmin(admin: admin, user: user, key: key)
}

-- Manage a user's access tokens (API: list / create / delete).
-- from: routers/api/v1/admin/user_token.go:46
rule AdminCreatesAccessTokenForUser {
    when: AdminCreatesAccessTokenForUser(admin, user, token_name, scopes)
    requires: admin.is_admin = true
    ensures: AccessTokenRequestedForUser(requester: admin, user: user, token_name: token_name, scopes: scopes)
}

------------------------------------------------------------
-- Admin management of repositories
------------------------------------------------------------

-- Delete any repository from the admin list.
-- from: routers/web/admin/repos.go:42
rule AdminDeletesRepository {
    when: AdminDeletesRepository(admin, repository)
    requires: admin.is_admin = true
    -- repositories owns the deletion and its cascade (RepositoryDeleted reaches
    -- access, webhooks, packages, actions, ...); a site admin passes its check.
    ensures: RepositoryDeletionRequestedByAdmin(admin: admin, repository: repository)
}

-- Adopting an unadopted directory, or deleting its files, is repositories'
-- UserAdoptsRepository / UserDeletesUnadoptedRepository, for owners (when the
-- instance allows it) and site admins alike (site admins always pass their
-- checks); administration only owns the instance-wide listing (surface
-- UnadoptedRepositories below).
-- decided: administration 7 (repositories owns adopt and delete; administration the listing)

------------------------------------------------------------
-- Monitoring (infrastructure capability)
------------------------------------------------------------

-- from: routers/web/admin/stacktrace.go:42
rule AdminCancelsProcess {
    when: AdminCancelsProcess(admin, process)
    requires: admin.is_admin = true
    requires: not process.is_system
    ensures: process.cancelled = true
    ensures: ProcessCancellationRequested(admin: admin, process: process)
}

-- from: routers/web/admin/queue.go:40
rule AdminSetsQueueWorkers {
    when: AdminSetsQueueWorkers(admin, queue, max_workers)
    requires: admin.is_admin = true
    requires: max_workers >= 1
    ensures: queue.max_workers = max_workers
}

-- from: routers/web/admin/queue.go:71
rule AdminClearsQueue {
    when: AdminClearsQueue(admin, queue)
    requires: admin.is_admin = true
    ensures: queue.item_count = 0
}

------------------------------------------------------------
-- CLI (server operator)
------------------------------------------------------------

-- `forgejo admin user create`. Exactly one of --password / --random-password.
-- must-change-password defaults to true, except for the very first account of
-- the instance. Can also mint an access token for the new account.
-- from: cmd/admin_user_create.go:89
rule OperatorCreatesUser {
    when: OperatorCreatesUser(operator, instance, name, email, password, is_admin, must_change_password, restricted, access_token_name, access_token_scopes)
    requires: instance.install_status = installed
    requires: is_usable_username(name)
    requires: not (exists accounts/ReservedName{name: name})   -- accounts: reserved until AdminReleasesName
    requires: not username_taken(name)
    requires: not email_in_use(email)
    let first_account = not any_account_exists()
    ensures:
        let user = accounts/User.created(
            name: name,
            kind: individual,
            primary_email: email,
            is_admin: is_admin,
            is_active: true,
            is_restricted: restricted = true,
            prohibit_login: false,
            created_at: now
        )
        accounts/EmailAddress.created(user: user, address: email, is_activated: true, is_primary: true)
        authentication/UserLogin.created(
            user: user,
            source: null,
            login_name: name,
            has_password: true,
            must_change_password: if must_change_password != null: must_change_password else: not first_account,
            password_changed_at: now,
            last_sign_in_at: null
        )
        if access_token_name != null:
            AccessTokenRequestedForUser(requester: operator, user: user, token_name: access_token_name, scopes: access_token_scopes)
}

-- `forgejo admin user change-password`
-- from: cmd/admin_user_change_password.go:64
rule OperatorChangesPassword {
    when: OperatorChangesPassword(operator, user, password, must_change_password)
    requires: password_acceptable(password)
    let login = authentication/UserLogin{user: user}
    ensures: login.has_password = true
    ensures: login.must_change_password = must_change_password
    ensures: login.password_changed_at = now
    ensures: UserPasswordSetByOperator(operator: operator, user: user, password: password)
}

-- `forgejo admin user must-change-password [--all] [--exclude u] [--unset] users…`
-- from: cmd/admin_user_must_change_password.go:40
rule OperatorSetsMustChangePassword {
    when: OperatorSetsMustChangePassword(operator, users, value)
    ensures:
        for login in authentication/UserLogins where user in users:
            login.must_change_password = value
}

-- `forgejo admin user reset-mfa`
-- from: cmd/admin_user_reset_mfa.go:33
rule OperatorResetsTwoFactor {
    when: OperatorResetsTwoFactor(operator, user)
    ensures: UserTwoFactorResetByAdmin(admin: operator, user: user)
}

-- `forgejo admin user delete --id|--username|--email [--purge]`
-- from: cmd/admin_user_delete.go:48
rule OperatorDeletesUser {
    when: OperatorDeletesUser(operator, user, purge)
    requires: not user.is_admin or has_other_admin(user)
    requires: purge or not owns_content(user)
    -- accounts removes the account at the end of its cascade (AdminDeletionCascades).
    ensures: UserDeletedByAdmin(admin: operator, user: user, purge: purge)
}

-- `forgejo admin user generate-access-token`
-- from: cmd/admin_user_generate_access_token.go:48
rule OperatorGeneratesAccessToken {
    when: OperatorGeneratesAccessToken(operator, user, token_name, scopes)
    ensures: AccessTokenRequestedForUser(requester: operator, user: user, token_name: token_name, scopes: scopes)
}

-- `forgejo admin user create-authorized-integration` (JWT-trusting token)
-- from: cmd/admin_user_generate_authorized_integration.go:102
rule OperatorCreatesAuthorizedIntegration {
    when: OperatorCreatesAuthorizedIntegration(operator, user, name, description, issuer, claim_rules, scopes, all_repositories, repositories)
    -- authentication checks the issuer and the claim rules and generates the audience.
    ensures: AuthorizedIntegrationRequested(operator: operator, user: user, name: name, description: description, issuer: issuer, claim_rules: claim_rules, scopes: scopes, all_repositories: all_repositories, repositories: repositories)
    @guidance
        -- Flags: --username, --name, --description, --issuer, --claim-eq,
        -- --claim-in, --claim-glob, --claim-glob-in (claim=value[,value...]),
        -- --scope (repeatable), --repo owner/name or "all".
}

-- `forgejo admin regenerate keys`
-- from: cmd/admin_regenerate.go:20
rule OperatorRegeneratesAuthorizedKeys {
    when: OperatorRegeneratesAuthorizedKeys(operator)
    ensures: AuthorizedKeysRegenerationRequested(operator: operator)
}

-- `forgejo admin repo-sync-releases`
-- from: cmd/admin.go:109
rule OperatorSyncsReleases {
    when: OperatorSyncsReleases(operator)
    ensures: ReleasesSyncWithTagsRequested(operator: operator)
}

-- `forgejo admin auth add-oauth|update-oauth|add-ldap|update-ldap|
-- add-ldap-simple|update-ldap-simple|add-pam|update-pam|add-smtp|update-smtp|
-- list|delete`
-- from: cmd/admin.go:55
rule OperatorConfiguresAuthSource {
    when: OperatorConfiguresAuthSource(operator, kind, action, source, name, is_active, sync_enabled, settings)
    -- source: the --id of the source for update / delete, null for add and list.
    -- authentication creates, updates or deletes the source with the admin
    -- form's validation; `list` changes nothing.
    ensures: AuthSourceConfiguredFromCli(operator: operator, kind: kind, action: action, source: source, name: name, is_active: is_active, sync_enabled: sync_enabled, settings: settings)
}

-- `forgejo admin sendmail --title --content [--force]`: mail every active
-- account with an email address. Needs mail to be configured.
-- from: cmd/mailer.go:16
rule OperatorMailsAllUsers {
    when: OperatorMailsAllUsers(operator, instance, subject, body)
    requires: instance.install_status = installed
    requires: subject != ""
    requires: mail_enabled()
    ensures: MassMailRequested(subject: subject, body: body, recipients: active_accounts_with_email())
}

-- `forgejo doctor check [--list|--default|--run c…|--all] [--fix]`
-- from: cmd/doctor.go:270
rule OperatorRunsDoctor {
    when: OperatorRunsDoctor(operator, checks, fix)
    ensures: DoctorRunRequested(operator: operator, checks: checks, fix: fix)
}

-- Report-only doctor checks from the web admin: never with fix — repairs that
-- change data stay CLI-only. The report is kept for the admin to read.
-- decided: administration 9 (read-only checks from the web; fixes CLI-only)
rule AdminRunsDoctorChecks {
    when: AdminRunsDoctorChecks(admin, checks)
    requires: admin.is_admin = true
    requires: checks != {}
    ensures:
        let run = DoctorRun.created(requested_by: admin, checks: checks, state: running, report: null, started_at: now, finished_at: null)
        DoctorRunRequestedByAdmin(run: run)
}

rule RecordDoctorReport {
    when: DoctorRunFinished(run, report)
    requires: run.state = running
    ensures: run.state = finished
    ensures: run.report = report
    ensures: run.finished_at = now
}

-- `forgejo dump`: one archive with the configuration file, a database dump
-- (optionally converted to another SQL dialect), repositories, LFS objects,
-- attachments, packages, avatars, custom dir, indexes, logs — each
-- skippable — in the chosen format, to a file or stdout.
-- from: cmd/dump.go:246
rule OperatorDumpsInstance {
    when: OperatorDumpsInstance(operator, instance, format, contents)
    requires: instance.install_status = installed
    ensures: InstanceDumpProduced(operator: operator, format: format, contents: contents)
}

-- `forgejo restore <dump>`: load a dump (configuration, database, repositories
-- and the other stored files) into an empty, not yet installed instance; it
-- comes up installed exactly as dumped. Restoring over a live instance is
-- refused. Forgejo has no counterpart (restore is manual).
-- decided: administration 4 (CLI restore into an empty instance)
rule OperatorRestoresInstance {
    when: OperatorRestoresInstance(operator, instance, dump)
    requires: instance.install_status = awaiting_install
    requires: instance_storage_is_empty(instance)
    requires: is_readable_dump(dump)
    ensures: instance.install_status = installed
    ensures: InstanceRestored(operator: operator, instance: instance)
    @guidance
        -- Any format `forgejo dump` writes is accepted; a database dump in
        -- another SQL dialect is converted. Parts skipped at dump time stay
        -- empty. The install wizard is not shown afterwards (the restored
        -- configuration carries the install lock).
}

-- `forgejo manager shutdown|restart|reload-templates|flush-queues|processes|logging`
-- from: cmd/manager.go:17
rule OperatorCommandsRunningInstance {
    when: OperatorCommandsRunningInstance(operator, command)
    ensures: RunningInstanceCommanded(operator: operator, command: command)
}

------------------------------------------------------------
-- Invariants
------------------------------------------------------------

-- At most one announcement per kind.
invariant OneAnnouncementPerKind {
    for a in Announcements:
        for b in Announcements:
            a.kind = b.kind implies a = b
}

-- Each runtime setting key is stored once.
invariant OneSettingPerKey {
    for a in SystemSettings:
        for b in SystemSettings:
            a.key = b.key implies a = b
}

-- Every cron task name is registered once.
invariant UniqueCronTaskNames {
    for a in CronTasks:
        for b in CronTasks:
            a.name = b.name implies a = b
}

-- A task that is not enabled has no next scheduled run.
invariant DisabledTasksAreNotScheduled {
    for t in CronTasks:
        t.enabled = false implies t.next_run_at = null
}

-- One acknowledgement per user and announcement kind.
invariant OneAcknowledgementPerUserAndKind {
    for a in AnnouncementAcknowledgements:
        for b in AnnouncementAcknowledgements:
            (a.user = b.user and a.kind = b.kind) implies a = b
}

-- The instance always keeps at least one administrator (demotion and deletion
-- of the last one are refused).
-- (accounts declares the matching invariant AtLeastOneAdmin over its Users.)

------------------------------------------------------------
-- Actor Declarations
------------------------------------------------------------

-- Administrators, signed-in users and anonymous visitors (the install wizard,
-- a load-balancer health probe, an API client reading the version) are the
-- shared actors access/SiteAdmin, access/SignedInUser and access/Visitor.

actor ServerOperator {
    identified_by: Operator where has_host_access = true
}

-- The server process itself and the background work of other modules,
-- reporting into this module.
actor BackgroundWork {
    identified_by: ServerProcess where is_running = true
}

------------------------------------------------------------
-- Surfaces
------------------------------------------------------------

-- The first-run install wizard.
surface InstallWizard {
    facing visitor: access/Visitor
    context instance: Instance

    exposes:
        instance.install_status

    provides:
        VisitorSubmitsInstallation(visitor, instance, settings)
            when instance.install_status = awaiting_install

    @guidance
        -- Web: GET / (form prefilled from current config and environment),
        -- POST / (submit), GET /post-install (done page). While not installed
        -- every other path is 404. After success the install server shuts down
        -- and the normal server starts.
}

-- Health endpoint for load balancers and orchestrators.
surface HealthEndpoint {
    facing probe: access/Visitor
    context instance: Instance

    exposes:
        instance.health_status
        instance.app_name
        instance.database_reachable
        instance.cache_reachable

    @guarantee FailureIsDistinguishable
        -- "pass" (or "warn") maps to a success response, "fail" to a failure
        -- response, so a probe can act on the status code alone.

    @guidance
        -- GET /api/healthz, JSON shaped after draft-inadarei-api-health-check:
        -- {status, description, checks: {"database:ping": [...], "cache:ping": [...]}}.
        -- Before installation no component checks are run. Never cached.
}

-- Public instance information.
surface InstanceInfo {
    facing visitor: access/Visitor
    context instance: Instance

    exposes:
        instance.version
        instance.app_name

    @guidance
        -- GET /api/v1/version; GET /api/v1/settings/{ui,api,repository,attachment}
        -- expose the public, non-secret instance limits other modules own.
}

-- The admin dashboard.
surface AdminDashboard {
    facing admin: access/SiteAdmin
    context instance: Instance

    exposes:
        instance.version
        instance.started_at
        instance.release_state
        instance.recommended_upgrade
        instance.update_check_error
        instance_statistics()
        for task in CronTasks where shown_on_dashboard = true:
            task.name

    provides:
        AdminRunsCronTask(admin, task)
        AdminResyncsAllBranches(admin)
        AdminResyncsAllTags(admin)

    @guidance
        -- Web: GET /admin, POST /admin (op=<task name>|sync_repo_branches|sync_repo_tags),
        -- GET /admin/system_status (uptime), GET /admin/monitor/stats (entity counts).
        -- Dashboard one-click operations: delete_inactive_accounts,
        -- delete_repo_archives, delete_missing_repos, git_gc_repos,
        -- resync_all_sshkeys + resync_all_sshprincipals (only when an external
        -- SSH server is used), reinit_missing_repos, sync_external_users,
        -- repo_health_check, delete_generated_repository_avatars,
        -- sync_repo_branches, sync_repo_tags.
}

-- The cron monitor: one row per registered task.
surface CronTaskMonitor {
    facing admin: access/SiteAdmin
    context task: CronTask

    exposes:
        task.name
        task.schedule
        task.enabled
        task.next_run_at
        task.last_run_at
        task.exec_times
        task.last_outcome
        task.last_message
        task.last_doer

    provides:
        AdminRunsCronTask(admin, task)

    timeout:
        CronTaskFallsDue

    @guidance
        -- Web: GET /admin/monitor/cron, POST /admin (op=<name>, from=monitor).
        -- API: GET /api/v1/admin/cron (name, schedule, next, prev, exec_times),
        -- POST /api/v1/admin/cron/{task}.
        -- An unknown task name is reported, not run.
}

-- The system notice log.
surface SystemNoticeLog {
    facing admin: access/SiteAdmin
    context notice: SystemNotice

    exposes:
        notice.kind
        notice.description
        notice.created_at
        -- the audit trail access keeps of site admins opening private
        -- repositories they hold no role in (decided: follow-up 1); shown
        -- next to the notices, never edited, no retention of its own
        for record in access/AdminAccessRecords:
            record.admin
            record.repository
            record.unit_kind
            record.accessed_at

    provides:
        AdminDeletesNotices(admin, notices)
        AdminEmptiesNotices(admin)

    @guidance
        -- Web: GET /admin/notices (newest first, paged), POST /admin/notices/delete
        -- (ids[]), POST /admin/notices/empty.
}

-- Read-only configuration with secrets masked; test mail.
surface InstanceConfiguration {
    facing admin: access/SiteAdmin
    context entry: ConfigEntry

    exposes:
        entry.section
        entry.key
        entry.displayed_value

    provides:
        AdminSendsTestMail(admin, address)

    @guarantee SecretsNeverShown
        -- Database passwords, mailer passwords, cache/session/queue connection
        -- strings and credentials embedded in URLs are always masked.

    @guidance
        -- Web: GET /admin/config, POST /admin/config/test_mail,
        -- POST /admin/config/test_cache (cache round-trip timing).
        -- Lists among others the [webhook] retry settings (max delivery
        -- attempts, retry backoff base) and the [actions] settings other
        -- modules own: registration_token_lifetime (1h), run_pruning_enabled /
        -- run_retention, schedule_inactivity_disable_enabled /
        -- schedule_inactivity_period. Instance-wide merge-message templates
        -- are files under the custom path (pulls), with no admin UI.
}

-- Runtime-changeable settings.
surface RuntimeSettings {
    facing admin: access/SiteAdmin
    context setting: SystemSetting

    exposes:
        setting.key
        setting.value

    provides:
        AdminChangesSetting(admin, key, raw_value)

    @guidance
        -- Web: GET /admin/config/settings, POST /admin/config (key, value).
}

-- Managing the site announcement.
surface AnnouncementAdministration {
    facing admin: access/SiteAdmin
    context announcement: Announcement

    exposes:
        announcement.kind
        announcement.title
        announcement.text
        announcement.starts_at
        announcement.ends_at
        announcement.updated_at

    provides:
        AdminPublishesAnnouncement(admin, kind, title, text, starts_at, ends_at)
        AdminWithdrawsAnnouncement(admin, announcement)

    @guidance
        -- Web: GET/POST /admin/service_message, POST /admin/service_message/delete,
        -- POST /admin/service_message/preview, POST /admin/service_message/markup.
}

-- The announcement (modal or banner) every signed-in user sees, inside its
-- start/end window, until they dismiss it.
-- decided: administration 5 (modal or banner, optional start and end)
surface AnnouncementBanner {
    facing viewer: access/SignedInUser
    context announcement: Announcement

    exposes:
        announcement.kind when announcement.is_live and announcement.is_pending_for(viewer)
        announcement.title when announcement.is_live and announcement.is_pending_for(viewer)
        announcement.text when announcement.is_live and announcement.is_pending_for(viewer)

    provides:
        UserAcknowledgesAnnouncement(viewer, announcement)
            when announcement.is_live

    @guidance
        -- Rendered on every signed-in web page: a modal blocks the page until
        -- dismissed, a banner sits above the content. POST /user/confirm
        -- (sm_type, redirect_to) records the acknowledgement. Dismissing is a
        -- per-viewer acknowledgement, still accepted in read-only mode.
}

-- Switching read-only (maintenance) mode.
-- decided: administration 3
surface ReadOnlyModeAdministration {
    facing admin: access/SiteAdmin
    context gate: access/InstanceWriteGate

    exposes:
        gate.read_only
        gate.message
        gate.since

    provides:
        AdminEntersReadOnlyMode(admin, gate, message)
            when not gate.read_only
        AdminLeavesReadOnlyMode(admin, gate)
            when gate.read_only

    @guidance
        -- Web: /-/admin/maintenance (toggle + message); API
        -- PUT/DELETE /api/v1/admin/read-only. Admin pages stay writable for
        -- this switch and the rest of the admin console.
}

-- The banner every visitor sees while the instance is read-only.
surface ReadOnlyBanner {
    facing visitor: access/Visitor
    context gate: access/InstanceWriteGate

    exposes:
        gate.read_only
        gate.message when gate.read_only

    @guarantee WritesRefusedWhileReadOnly
        -- While gate.read_only, every write — web form, API call, git
        -- push over HTTP or SSH — is refused with the banner message (API: a
        -- distinct "instance is read-only" error); reads, clones and
        -- downloads keep working.
}

-- Doctor checks from the web admin: report-only.
-- decided: administration 9
surface DoctorReports {
    facing admin: access/SiteAdmin
    context run: DoctorRun

    exposes:
        run.checks
        run.state
        run.report
        run.started_at
        run.requested_by

    provides:
        AdminRunsDoctorChecks(admin, checks)

    @guarantee NoFixesFromTheWeb
        -- The web never runs a check with fix; repairs are `forgejo doctor
        -- check --fix` on the host only.

    @guidance
        -- Web: GET /-/admin/doctor (checks, past runs), POST /-/admin/doctor/run
        -- (checks[]). Same catalogue and defaults as `forgejo doctor check`.
}

-- User administration: one account.
surface AdminUserAccount {
    facing admin: access/SiteAdmin
    context subject: accounts/User

    exposes:
        subject.name
        subject.primary_email
        subject.is_admin
        subject.is_active
        subject.is_restricted
        subject.prohibit_login
        subject.visibility
        subject.max_repo_creation
        subject.login_source
        subject.allow_git_hook
        subject.allow_import_local
        subject.allow_create_organization

    provides:
        AdminSetsUserAdmin(admin, subject, value)
        AdminSetsUserRestricted(admin, subject, value)
        AdminSetsProhibitLogin(admin, subject, value)
        AdminSetsUserActive(admin, subject, value)
        AdminSetsMaxRepoCreation(admin, subject, limit)
        AdminSetsUserVisibility(admin, subject, visibility)
        AdminSetsUserPermissions(admin, subject, allow_git_hook, allow_import_local, allow_create_organization)
        AdminEditsUserProfile(admin, subject, full_name, website, location, pronouns, description, keep_email_private)
        AdminSetsUserPassword(admin, subject, password, must_change_password)
        AdminSetsUserLoginSource(admin, subject, login_source, login_name)
        AdminSetsUserPrimaryEmail(admin, subject, address)
        AdminRenamesUser(admin, subject, new_name)
        AdminResetsUserTwoFactor(admin, subject)
        AdminChangesUserAvatar(admin, subject, image)
        AdminRemovesUserAvatar(admin, subject)
        AdminDeletesUser(admin, subject, purge)
            when subject != admin
        AdminCreatesOrganizationForUser(admin, subject, name, visibility)
        AdminCreatesRepositoryForUser(admin, subject, name)
        AdminAddsSshKeyForUser(admin, subject, key_content, title)
        AdminRemovesSshKeyOfUser(admin, subject, key)
        AdminCreatesAccessTokenForUser(admin, subject, token_name, scopes)

    @guidance
        -- Web: GET /admin/users/{id} (account, its repositories, emails, orgs),
        -- GET/POST /admin/users/{id}/edit, POST /admin/users/{id}/delete (purge),
        -- POST /admin/users/{id}/avatar, POST /admin/users/{id}/avatar/delete.
        -- API: PATCH/DELETE /api/v1/admin/users/{username},
        -- POST /api/v1/admin/users/{username}/rename,
        -- POST/DELETE /api/v1/admin/users/{username}/keys[/{id}],
        -- GET/POST /api/v1/admin/users/{username}/orgs,
        -- POST /api/v1/admin/users/{username}/repos,
        -- GET/DELETE /api/v1/admin/users/{username}/emails,
        -- GET/POST/DELETE /api/v1/admin/users/{username}/tokens[/{id}],
        -- GET /api/v1/admin/users/{username}/quota, POST …/quota/groups (quota).
        -- Any API call: ?sudo=<user> or Sudo header — access/SiteAdminActsAs.
        -- The delete form offers "reserve this name": it first issues
        -- accounts' AdminReservesName (accounts/ReservedNameAdministration)
        -- for the account's name, then AdminDeletesUser.
        -- The edit form applies all fields in one submit, in this order:
        -- rename, login source/password/prohibit-login, email, profile+flags, 2FA reset.
}

-- User administration: the directory.
surface AdminUserDirectory {
    facing admin: access/SiteAdmin

    exposes:
        accounts/User.name
        accounts/User.primary_email
        accounts/User.is_admin
        accounts/User.is_active
        accounts/User.is_restricted
        accounts/User.prohibit_login

    provides:
        AdminCreatesUser(admin, name, email, password, login_source, login_name, visibility, must_change_password, restricted, send_notification)

    @guidance
        -- Web: GET /admin/users (search by name/email; filters active, admin,
        -- restricted, 2FA enabled, prohibit-login, account kind; sort; includes
        -- reserved, bot and remote accounts), GET/POST /admin/users/new.
        -- API: GET /api/v1/admin/users (filters login_name, source_id,
        -- is_2fa_enabled), POST /api/v1/admin/users.
        -- Orgs: GET /admin/orgs, GET /api/v1/admin/orgs (all visibilities).
}

-- The instance-wide email directory.
surface AdminEmailDirectory {
    facing admin: access/SiteAdmin
    context email: accounts/EmailAddress

    exposes:
        email.address
        email.user
        email.is_primary
        email.is_activated

    provides:
        AdminSetsEmailActivation(admin, email, activate)
        AdminDeletesEmail(admin, email)
            when not email.is_primary

    @guidance
        -- Web: GET /admin/emails (search, filter activated/primary, sort by
        -- email or user), POST /admin/emails/activate, POST /admin/emails/delete.
        -- API: GET /api/v1/admin/emails, GET /api/v1/admin/emails/search?q=.
        -- An admin may not toggle activation of their own primary address.
}

-- Repository administration.
surface AdminRepositoryDirectory {
    facing admin: access/SiteAdmin
    context repository: repositories/Repository

    exposes:
        repository.name
        repository.owner_user
        repository.owner_org
        repository.is_private

    provides:
        AdminDeletesRepository(admin, repository)

    @guidance
        -- Web: GET /admin/repos (all repositories incl. private), POST /admin/repos/delete.
}

-- Directories without repositories.
surface UnadoptedRepositories {
    facing admin: access/SiteAdmin
    context dir: repositories/UnadoptedRepository

    exposes:
        dir.owner_name
        dir.name

    @guidance
        -- decided: administration 7 (repositories owns adopt and delete; the
        -- instance-wide listing is administration's).
        -- Adopt and delete are repositories' actions (UserAdoptsRepository,
        -- UserDeletesUnadoptedRepository), offered on repositories/RepositoryAdministration.
        -- Web: GET /admin/repos/unadopted?search=true&q=, POST /admin/repos/unadopted
        -- (id=owner/name, action=adopt|delete).
        -- API: GET /api/v1/admin/unadopted, POST/DELETE /api/v1/admin/unadopted/{owner}/{repo}.
}

-- Runtime monitoring (infrastructure capability).
surface RuntimeMonitor {
    facing admin: access/SiteAdmin
    context process: MonitoredProcess

    exposes:
        process.description
        process.started_at
        process.is_system

    provides:
        AdminCancelsProcess(admin, process)
            when not process.is_system
        AdminSetsQueueWorkers(admin, queue, max_workers)
        AdminClearsQueue(admin, queue)

    @guidance
        -- Web: GET /admin/monitor/stacktrace, POST /admin/monitor/stacktrace/cancel/{pid},
        -- GET /admin/monitor/queue, GET /admin/monitor/queue/{qid},
        -- POST …/set, POST …/remove-all-items,
        -- GET /admin/monitor/diagnosis (downloadable diagnosis bundle).
}

-- Delegated admin consoles whose behaviour other modules own. Listed so the
-- endpoint inventory is complete.
surface DelegatedAdminConsoles {
    facing admin: access/SiteAdmin
    context instance: Instance

    exposes:
        instance.app_name

    @guidance
        -- authentication: /admin/auths (list, new, edit, delete auth sources);
        --   /admin/applications (instance-wide OAuth2 apps, regenerate secret, delete).
        -- webhooks: /admin/hooks, /admin/{default-hooks|system-hooks}/{type}/new,
        --   /admin/hooks/{id} (edit, replay); API /api/v1/admin/hooks[/{id}];
        --   the instance-wide delivery log (webhooks/InstanceDeliveryLog).
        -- accounts: reserved names (accounts/ReservedNameAdministration) and
        --   account purges (accounts/AccountPurgeAdministration).
        -- actions: /-/admin/actions/runners, /-/admin/actions/variables
        --   (actions' ActionsSettings at the instance scope);
        --   API /api/v1/admin/actions/runners[...], /api/v1/admin/runners/...
        -- packages: /admin/packages (list, delete version, cleanup expired data).
        -- moderation: /admin/moderation/reports, /admin/abuse_reports/act.
        -- federation: /admin/federation/hosts[/{id}], /admin/federation/users.
        -- quota: /api/v1/admin/quota/rules[...], /api/v1/admin/quota/groups[...].
}

-- The `forgejo` CLI on the host.
surface OperatorConsole {
    facing operator: ServerOperator
    context instance: Instance

    exposes:
        instance.install_status
        instance.version

    provides:
        OperatorCreatesUser(operator, instance, name, email, password, is_admin, must_change_password, restricted, access_token_name, access_token_scopes)
        OperatorChangesPassword(operator, user, password, must_change_password)
        OperatorSetsMustChangePassword(operator, users, value)
        OperatorResetsTwoFactor(operator, user)
        OperatorDeletesUser(operator, user, purge)
        OperatorGeneratesAccessToken(operator, user, token_name, scopes)
        OperatorCreatesAuthorizedIntegration(operator, user, name, description, issuer, claim_rules, scopes, all_repositories, repositories)
        OperatorRegeneratesAuthorizedKeys(operator)
        OperatorSyncsReleases(operator)
        OperatorConfiguresAuthSource(operator, kind, action, source, name, is_active, sync_enabled, settings)
        OperatorMailsAllUsers(operator, instance, subject, body)
        OperatorRunsDoctor(operator, checks, fix)
        OperatorDumpsInstance(operator, instance, format, contents)
        OperatorRestoresInstance(operator, instance, dump)
        OperatorCommandsRunningInstance(operator, command)

    @guidance
        -- forgejo admin user {create,list [--admin],change-password,delete,
        --   generate-access-token,create-authorized-integration,must-change-password,reset-mfa}
        -- forgejo admin regenerate keys
        -- forgejo admin auth {add,update}-{oauth,ldap,ldap-simple,pam,smtp}, list, delete
        -- forgejo admin sendmail, forgejo admin repo-sync-releases
        -- forgejo doctor check, forgejo dump, forgejo restore, forgejo manager …
        -- Commands that need the running server (sendmail, manager) talk to it
        -- over its private, host-local control API; the rest open the database
        -- directly.
}

-- How the process and other modules' background work report into this module.
surface BackgroundWorkReporting {
    facing worker: BackgroundWork
    context instance: Instance

    exposes:
        instance.install_status
        for task in CronTasks where run_state = running:
            task.name

    provides:
        InstanceStarted(instance)
        CronWorkCompleted(task, outcome, message)
        SystemFailureReported(kind, description)
        ReleaseFeedAnswered(instance, supported_versions, error)
        DoctorRunFinished(run, report)

    timeout:
        CronTaskFallsDue

    @guidance
        -- In-process contract, not a network API. Each module that owns cron
        -- work answers a *Due trigger by doing the work and then reporting
        -- CronWorkCompleted with finished / failed (error text) / cancelled
        -- (shutdown or explicit cancel). An owner that reports completion
        -- with a trigger of its own (accounts/InactiveAccountCleanupFinished,
        -- keys/KeyFilesRewritten) has it mapped to its task here. Background
        -- failures worth an operator's attention are owners' own triggers
        -- that this module turns into SystemNotices (Reacts to).
}

------------------------------------------------------------
-- Deferred Specifications
------------------------------------------------------------

deferred time_until_next           -- see: services/cron/tasks.go:209 — duration from now to the next occurrence of a cron/descriptor schedule evaluation: "@every <dur>", "@midnight", "@daily", "@weekly", "@monthly", "@annually", 5- or 6-field crontab
deferred release_state_of          -- see: modules/updatechecker/update_checker.go:161 — semantic-version comparison against the supported list (unsupported major, outdated minor, prerelease)
deferred normalise_setting         -- see: services/admin_setting/admin_setting.go:14 — per-key parsing; see AdminChangesSetting guidance
deferred instance_statistics       -- see: models/activities/statistic.go — counts of users, orgs, repos, issues, PRs, releases, packages, … (notifications/discovery data)

------------------------------------------------------------
-- Open Questions
------------------------------------------------------------

-- (none: all decided, see DECISIONS.md "administration")

------------------------------------------------------------
-- Requests to other modules
------------------------------------------------------------
-- REQUEST accounts/User: fields used here already exist (max_repo_creation with null = default, allow_git_hook, allow_import_local, allow_create_organization, login_source, profile fields); config.disable_regular_org_creation now lives in organizations' config.
-- REQUEST accounts: react to UserDeletedByAdmin(admin, user, purge) with the cascade (purge: disable first, delete repos, leave orgs and delete sole-owned orgs, delete packages and federated identity; remove user dir and avatar, report a file-removal failure for a system notice (see the last request)).
-- REQUEST accounts: react to UserRenamedByAdmin with the same redirect/ownership handling as a self rename; react to UserAvatarChangedByAdmin / UserAvatarRemovedByAdmin.
-- REQUEST accounts: own InactiveAccountCleanupDue(older_than) — delete never-activated accounts older than that and report CronWorkCompleted.
-- REQUEST repositories: react to MirrorUpdateDue, RepositoryHealthCheckDue, RepositoryStatsCheckDue, RepositoryArchiveCleanupDue, AllRepositoryArchivesDeletionDue, RepositoryGarbageCollectionDue, MissingRepositoryReinitDue, MissingRepositoryDeletionDue, GeneratedRepositoryAvatarDeletionDue. (Done in integration: all nine have reactions.)
-- REQUEST repositories: react to RepositoryCreationRequestedByAdmin(admin, user, name) by creating the repository with instance defaults as UserCreatesRepository does (a site admin bypasses the creation limit), and to RepositoryDeletionRequestedByAdmin(admin, repository) with the OwnerDeletesRepository cascade, ending in RepositoryDeleted(repository, doer: admin).
-- REQUEST code: react to DeletedBranchCleanupDue, LfsGarbageCollectionDue, AllRepositoryBranchesResyncRequested.
-- REQUEST releases: react to AllRepositoryTagsResyncRequested and ReleasesSyncWithTagsRequested.
-- REQUEST keys: react to AuthorizedKeysRewriteDue, AuthorizedPrincipalsRewriteDue, AuthorizedKeysRegenerationRequested, SshKeyAddedForUserByAdmin, SshKeyRemovedForUserByAdmin.
-- REQUEST webhooks: react to HookDeliveryCleanupDue(kind, older_than, number_to_keep).
-- REQUEST packages: react to PackageCleanupDue(older_than).
-- REQUEST notifications: notifications reacts to the AdminSendsTestMail stimulus directly (fine); also react to OldActivityDeletionDue, MassMailRequested, UserCreatedByAdmin (send "account created" mail when send_notification); honour config.notify_admins_on_new_user and config.default_email_notifications.
-- REQUEST discovery: react to IssueIndexRebuildDue.
-- REQUEST migrations: react to MigrationPosterIdUpdateDue; emit MigrationFailureReported(kind, description) (local) for every failure or dropped source data that merits a repository notice — administration records it.
-- REQUEST actions: react to ZombieActionsTaskStopDue, EndlessActionsTaskStopDue, AbandonedActionsJobCancellationDue, LingeringActionsLogTransferDue, ActionsScheduleStartDue, ActionsCleanupDue, OfflineRunnerCleanupDue, ActionsUserCleanupDue.
-- REQUEST organizations: react to OrganizationCreatedForUserByAdmin; honour config.disable_regular_org_creation.
-- REQUEST all modules with writes outside repository units (accounts, organizations, issues, pulls, releases, wiki, packages, projects, keys, webhooks, actions, moderation, federation, migrations, authentication settings, notifications settings): refuse every user-initiated write while access/InstanceWriteGate.read_only (decided: administration 3); access already gates UserWritesUnit / UserContributesToRepository; code's git push goes through access table C (changes_git_content).
-- REQUEST code: refuse git push over HTTP and SSH while access/InstanceWriteGate.read_only, with the read-only message on the client's terminal (decided: administration 3).
-- REQUEST accounts: the self-edit guard of decision administration 6 counts admins via has_other_admin(user) — another active administrator who may sign in (is_admin, is_active, not prohibit_login, not being_purged).
-- REQUEST repositories: administration records SystemNotices for PullMirrorSyncFailed; for RepositoryHealthCheckFailed / RepositoryGarbageCollectionFailed emit them from a rule level the audit sees (one trigger per failing repository) and administration will add the two notice rules.
