------------------------------------------------------------
-- Cron work this module owns itself
------------------------------------------------------------

-- from: models/system/notice.go:118
rule DeleteOldSystemNotices {
    when: OldSystemNoticeDeletionDue(older_than)
    ensures:
        for n in SystemNotices where created_at + older_than < now:
            not exists n
    -- decided: requests 5 (this module owns the work, so it finishes the run itself)
    ensures:
        for task in CronTasks where name = delete_old_system_notices and run_state = running:
            CronWorkCompleted(job: task, outcome: finished, message: null)
}

-- The update check: DNS TXT lookup on the domain endpoint (preferred) or the
-- HTTP version feed; the result (or the error) is recorded for the dashboard.
-- from: modules/updatechecker/update_checker.go:37
rule QueryReleaseFeed {
    when: UpdateCheckDue(http_endpoint, domain_endpoint)
    ensures: ReleaseFeedQueried(http_endpoint: http_endpoint, domain_endpoint: domain_endpoint)
}

------------------------------------------------------------
-- Read-only (maintenance) mode
------------------------------------------------------------
-- Forgejo has none. While it is on, every write — web, API, git push — is
-- refused and every page carries a banner with the admin's message; reads and
-- the admin pages keep working, so the admin can switch it off again.
-- The switch is access/InstanceWriteGate, the shared write gate access's
-- repository write and contribution rules consult; other modules'
-- non-repository writes are listed as REQUESTs at the end of this file.
-- decided: administration 3 (admins switch it on; every write refused with a banner)

rule AdminEntersReadOnlyMode {
    when: AdminEntersReadOnlyMode(admin, gate, message)
    requires: admin.is_admin = true
    requires: not gate.read_only
    ensures: gate.read_only = true
    ensures: gate.message = message
    ensures: gate.since = now
    ensures: InstanceReadOnlyModeChanged(gate: gate, read_only: true)
}

rule AdminLeavesReadOnlyMode {
    when: AdminLeavesReadOnlyMode(admin, gate)
    requires: admin.is_admin = true
    requires: gate.read_only
    ensures: gate.read_only = false
    ensures: gate.message = null
    ensures: gate.since = null
    ensures: InstanceReadOnlyModeChanged(gate: gate, read_only: false)
}

