-- Deferred Specifications
------------------------------------------------------------

deferred BranchProtection.first_match     -- see: models/git/protected_branch_list.go — protection_for: exact (case-insensitive) names beat globs; among equals, the oldest rule wins
deferred LfsGarbageCollection.batch       -- see: services/repository/lfs.go — per-repository batching and store deletion

