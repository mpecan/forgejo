-- Journeys through authentication.allium: registration, sign-in, second factors,
-- recovery, tokens, the OAuth2 provider, external sources and the directory sync.
--
-- Every journey runs on the instance defaults (open registration, no e-mail
-- confirmation, no mailer, OAuth2 provider enabled) unless it says otherwise.

journey SomebodyRegistersOnAnOpenInstance {
    goal: On a default instance anyone may sign up. Ada fills in the form, her account
          is usable straight away and she is signed in.

    cast:
        s: Session

    given:
        s.status = anonymous

    1. she fills in the sign-up form
        stipulate email_domain_allowed("ada@example.com") = true
        stipulate password_acceptable("correct horse battery") = true
        stipulate username_available("ada") = true
        stipulate email_available("ada@example.com") = true
        stipulate user_count() = 3
        s does VisitorRegisters(s, "ada", "ada@example.com", "correct horse battery") on SignInPage
            creating login: UserLogin
        then VisitorRegisters fires
        then login.source = null
        then login.has_password = true
        then login.must_change_password = false
        then s.status = authenticated
        then s.authenticated_via = password_login

    ends: Ada has an active account and is signed in.
}

-- Signing out, from the security settings of a signed-in person. Kept apart from the
-- sign-up journey because a journey can name only one thing an act created, and the
-- account that signs out is not the login record sign-up is checked by.
journey SheSignsOutAgain {
    goal: Ada is signed in. She signs out and her browser session is gone.

    cast:
        ada: accounts/User
        s: Session

    given:
        ada.is_active = true
        ada.prohibit_login = false
        s.status = authenticated
        s.user = ada
        s.remember_me = null

    1. she signs out
        ada does UserSignsOut(s) on SecuritySettings
        then UserSignsOut fires
        then s.status = destroyed

    ends: Her browser session is destroyed.
}

journey AWeakPasswordIsRefusedAtSignUp {
    goal: The password policy (length, character classes, breach list) is checked
          before any account exists.

    cast:
        s: Session

    given:
        s.status = anonymous

    1. bob tries a password that is too weak
        stipulate email_domain_allowed("bob@example.com") = true
        stipulate password_acceptable("1234") = false
        stipulate username_available("bob") = true
        stipulate email_available("bob@example.com") = true
        s cannot do VisitorRegisters(s, "bob", "bob@example.com", "1234") on SignInPage
        then s.status = anonymous

    ends: No account was created and bob is still anonymous.
}

journey AnActivationLinkActivatesTheAccount {
    goal: An account waiting for confirmation is activated by the mailed link; the user
          re-enters their password so a forwarded link alone is not enough. The link
          works once.

    cast:
        s:     Session
        other: Session
        ada:   accounts/User

    given:
        s.status = anonymous
        other.status = anonymous
        ada.is_active = false
        ada.prohibit_login = false
        login: UserLogin { user: ada, source: null, login_name: "ada", has_password: true, must_change_password: false }
        code: EmailVerificationCode { user: ada, purpose: user_activation, email: "ada@example.com", status: pending }
        addr: accounts/EmailAddress { user: ada, address: "ada@example.com", is_activated: false, is_primary: true }

    1. she follows the link and types her password
        stipulate password_matches(ada, "correct horse battery") = true
        stipulate activated_elsewhere(addr) = false
        s does UserActivatesAccount(s, code, "correct horse battery") on MailedCodeLanding
        then UserActivatesAccount fires
        then code.status = used
        then ada.is_active = true
        then s.status = authenticated
        then s.user = ada
        then addr.is_activated = true

    2. the same link cannot be used a second time
        other cannot do UserActivatesAccount(other, code, "correct horse battery") on MailedCodeLanding

    ends: Ada is active and signed in; the code is spent.
}

journey SignInWithAnAuthenticatorApp {
    goal: Ada has TOTP enrolled. Her password only gets her half way; the passcode
          from her app completes the sign-in, and the same passcode cannot be replayed.

    cast:
        s:   Session
        eve: Session
        ada: accounts/User

    given:
        s.status = anonymous
        s.pending_link = false
        s.pending_external_identity = null
        s.pending_openid_uri = null
        eve.status = anonymous
        ada.is_active = true
        ada.prohibit_login = false
        ada.kind = individual
        login: UserLogin { user: ada, source: null, login_name: "ada", has_password: true, must_change_password: false }
        totp: TwoFactor { user: ada, last_used_passcode: null, scratch_code_generation: 1 }

    1. the password is right, so a second factor is asked for
        stipulate password_matches(ada, "correct horse battery") = true
        s does VisitorSignsInWithPassword(s, ada, "correct horse battery", false) on SignInPage
        then VisitorSignsInWithPassword fires
        then s.status = pending_second_factor
        then s.pending_user = ada

    2. the passcode from her app finishes it
        stipulate totp_valid(totp, "492039") = true
        s does VisitorCompletesTotpChallenge(s, "492039") on SecondFactorChallenge
        then VisitorCompletesTotpChallenge fires
        then s.status = authenticated
        then s.user = ada
        then totp.last_used_passcode = "492039"

    3. somebody who shoulder-surfed both cannot reuse that passcode
        eve does VisitorSignsInWithPassword(eve, ada, "correct horse battery", false) on SignInPage
        then eve.status = pending_second_factor
        eve cannot do VisitorCompletesTotpChallenge(eve, "492039") on SecondFactorChallenge
        then eve.status = pending_second_factor

    ends: Ada is signed in; the eavesdropper is stuck at the second-factor step.
}

journey TheScratchCodeIsARecoveryCodeThatWorksOnce {
    goal: Ada lost her phone. The scratch code gets her in once and is replaced.

    cast:
        s:   Session
        ada: accounts/User

    given:
        s.status = anonymous
        s.pending_link = false
        s.pending_external_identity = null
        s.pending_openid_uri = null
        ada.is_active = true
        ada.prohibit_login = false
        ada.kind = individual
        login: UserLogin { user: ada, source: null, login_name: "ada", has_password: true, must_change_password: false }
        totp: TwoFactor { user: ada, last_used_passcode: null, scratch_code_generation: 1 }

    1. password first
        stipulate password_matches(ada, "correct horse battery") = true
        s does VisitorSignsInWithPassword(s, ada, "correct horse battery", false) on SignInPage
        then s.status = pending_second_factor

    2. then the scratch code
        stipulate scratch_code_valid(totp, "K7QF9PXA2M") = true
        s does VisitorUsesScratchCode(s, "K7QF9PXA2M") on SecondFactorChallenge
        then VisitorUsesScratchCode fires
        then s.status = authenticated
        then totp.scratch_code_generation = 2

    ends: Ada is in and has a new scratch code to write down.
}

journey RememberMeLapsesAfterAMonth {
    goal: Ticking "remember me" keeps Ada signed in across browser restarts, but only
          for LOGIN_REMEMBER_DAYS; after that she has to sign in again.

    cast:
        s:     Session
        later: Session
        ada:   accounts/User

    given:
        s.status = anonymous
        later.status = anonymous
        -- `later` is the fresh browser session she comes back with a month
        -- on; the forge first hears from it on that day.
        later.last_activity_at = now + 32.days
        ada.is_active = true
        ada.prohibit_login = false
        ada.kind = individual
        login: UserLogin { user: ada, source: null, login_name: "ada", has_password: true, must_change_password: false }

    1. she signs in and asks to be remembered
        stipulate password_matches(ada, "correct horse battery") = true
        s does VisitorSignsInWithPassword(s, ada, "correct horse battery", true) on SignInPage
            creating lta: LongTermAuthorization
        then s.status = authenticated
        then lta.status = active
        then lta.user = ada

    2. thirty-two days pass
        after 32.days
        then LongTermAuthorizationExpires fires
        then lta.status = expired

    3. the old cookie no longer signs her in
        later cannot do VisitorResumesWithRememberMe(later, lta) on SignInPage
        then later.status = anonymous

    ends: The remember-me credential is dead; Ada must sign in with her password.
}

journey IdleSessionsEnd {
    goal: A browser session that sees no activity for SESSION_LIFE_TIME is discarded.

    cast:
        s:   Session
        ada: accounts/User

    given:
        s.status = anonymous
        ada.is_active = true
        ada.prohibit_login = false
        ada.kind = individual
        login: UserLogin { user: ada, source: null, login_name: "ada", has_password: true, must_change_password: false }

    1. ada signs in without "remember me"
        stipulate password_matches(ada, "correct horse battery") = true
        s does VisitorSignsInWithPassword(s, ada, "correct horse battery", false) on SignInPage
        then s.status = authenticated

    2. she leaves the tab for a day and a bit
        after 25.hours
        then SessionExpires fires
        then s.status = destroyed

    ends: The session is gone; the next request is anonymous.
}

journey PasswordRecoveryNeedsAMailer {
    goal: Without an outgoing mail service the forge cannot prove an address belongs to
          somebody, so "forgot password" is unavailable.

    cast:
        s:   Session
        ada: accounts/User

    given:
        s.status = anonymous
        login: UserLogin { user: ada, source: null, login_name: "ada", has_password: true, must_change_password: false }

    1. she asks for a reset mail
        s cannot do VisitorRequestsPasswordReset(s, ada) on SignInPage

    ends: Nothing was mailed; an administrator has to reset the password.
}

journey ARecoveryLinkResetsThePasswordAndForgetsOldDevices {
    goal: Ada follows a password-reset link. Setting the new password signs her in and
          revokes every remember-me cookie issued under the old password.

    cast:
        s:   Session
        ada: accounts/User

    given:
        s.status = anonymous
        s.user = null
        ada.is_active = true
        ada.prohibit_login = false
        login: UserLogin { user: ada, source: null, login_name: "ada", has_password: true, must_change_password: true }
        code: EmailVerificationCode { user: ada, purpose: password_reset, email: "ada@example.com", status: pending }
        laptop: LongTermAuthorization { user: ada, sso_source: null, status: active }

    1. she chooses a new password
        stipulate password_acceptable("a much better passphrase") = true
        s does VisitorResetsPassword(s, code, "a much better passphrase", null, null) on MailedCodeLanding
        then VisitorResetsPassword fires
        then code.status = used
        then login.must_change_password = false
        then laptop.status = revoked
        then s.status = authenticated
        then s.user = ada

    ends: Only the browser she just used is signed in.
}

journey APersonalAccessTokenForTheCommandLine {
    goal: Ada makes a token for her scripts, sees only its last eight characters
          afterwards, cannot reuse the name, and Bob never sees it.

    cast:
        ada: accounts/User
        bob: accounts/User

    given:
        ada.is_active = true
        ada.prohibit_login = false
        ada.is_admin = false
        bob.is_active = true
        bob.prohibit_login = false
        bob.is_admin = false

    1. she creates a read-only repository token from the settings page
        stipulate secret_suffix() = "9f3c1a7e"
        ada does UserCreatesAccessToken(ada, ada, "ci", {read_repository}, false, true, {}, session) on ApplicationSettings
            creating token: AccessToken
        then UserCreatesAccessToken fires
        then token.owner = ada
        then token.all_repositories = true
        then token.last_eight = "9f3c1a7e"
        ada sees token.last_eight on ApplicationSettings

    2. a second token with the same name is refused
        ada cannot do UserCreatesAccessToken(ada, ada, "ci", {write_issue}, false, true, {}, session) on ApplicationSettings

    3. bob cannot see it
        bob cannot see token.last_eight on ApplicationSettings

    4. she deletes it
        ada does UserDeletesAccessToken(ada, token, session) on ApplicationSettings
        then token does not exist

    ends: The token is gone.
}

journey ATokenCannotMintAnotherToken {
    goal: Token creation needs proof of the password (or the trusted proxy); a leaked
          token cannot be used to make more tokens. Repository-specific tokens may not
          be public-only.

    cast:
        ada:  accounts/User
        repo: repositories/Repository

    given:
        ada.is_active = true
        ada.prohibit_login = false
        ada.is_admin = false

    1. a script authenticated with a token asks for a new token for ada
        ada cannot do UserCreatesAccessToken(ada, ada, "more", {write_repository}, false, true, {}, access_token) on ApplicationSettings

    2. a repository-specific token that is also public-only is refused
        stipulate access/can_read(ada, repo, code) = true
        ada cannot do UserCreatesAccessToken(ada, ada, "narrow", {read_repository}, true, false, {repo}, session) on ApplicationSettings

    ends: No tokens were created.
}

journey AnAppSignsInWithTheForgeUsingPkce {
    goal: A public client (a desktop app) asks Ada for access. She consents, the app
          swaps the code — with its PKCE verifier — for tokens, refreshes once, and a
          replayed refresh token is refused.

    cast:
        ada: accounts/User
        app: OAuth2Application

    given:
        ada.is_active = true
        ada.prohibit_login = false
        ada.kind = individual
        login: UserLogin { user: ada, source: null, login_name: "ada", has_password: true, must_change_password: false }
        app.owner_user = null
        app.owner_org = null
        app.builtin = null
        app.confidential = false
        app.client_id = "d5a1"

    1. she is asked to consent
        stipulate redirect_uri_registered(app, "loopback-callback") = true
        ada does UserRequestsAuthorization(ada, app, "loopback-callback", "code", s256, "E9Melhoa2Owv", {"openid", "profile"}, null) on OAuth2Consent
        then UserRequestsAuthorization fires

    2. she approves and the app receives a code
        ada does UserGrantsConsent(ada, app, "loopback-callback", {"openid", "profile"}, s256, "E9Melhoa2Owv", null) on OAuth2Consent
            creating code: OAuth2AuthorizationCode
        then UserGrantsConsent fires
        then code.status = issued
        then code.pkce_method = s256

    3. the app exchanges code and verifier for tokens
        stipulate pkce_verifier_matches(code, "dBjftJeZ4CVP") = true
        app does ClientExchangesAuthorizationCode(app, false, code, "dBjftJeZ4CVP", "loopback-callback") on OAuth2ClientEndpoints
            creating first: OAuth2TokenIssuance
        then ClientExchangesAuthorizationCode fires
        then code.status = redeemed
        then first.includes_id_token = true

    4. the code cannot be exchanged twice
        app cannot do ClientExchangesAuthorizationCode(app, false, code, "dBjftJeZ4CVP", "loopback-callback") on OAuth2ClientEndpoints

    5. an hour later it refreshes
        after 2.hours
        app does ClientRefreshesToken(app, false, first) on OAuth2ClientEndpoints
            creating second: OAuth2TokenIssuance
        then ClientRefreshesToken fires

    6. presenting the first refresh token again is refused
        app cannot do ClientRefreshesToken(app, false, first) on OAuth2ClientEndpoints

    ends: The app holds one live token pair; the earlier refresh token is dead.
}

journey AuthorizationCodesAreShortLived {
    goal: A confidential client that already holds Ada's grant gets a code without a
          consent screen, but if it does not redeem the code promptly the code expires.

    cast:
        ada: accounts/User
        app: OAuth2Application

    given:
        ada.is_active = true
        ada.prohibit_login = false
        app.owner_user = null
        app.owner_org = null
        app.builtin = null
        app.confidential = true
        app.client_id = "c0ff"
        grant: OAuth2Grant { user: ada, application: app, scopes: {"openid"}, nonce: null, counter: 1 }

    1. she visits the authorize endpoint again
        stipulate redirect_uri_registered(app, "ci-callback") = true
        ada does UserRequestsAuthorization(ada, app, "ci-callback", "code", none, null, {"openid"}, null) on OAuth2Consent
            creating code: OAuth2AuthorizationCode
        then code.status = issued
        then code.grant = grant

    2. the client sits on it for a quarter of an hour
        after 15.minutes
        then AuthorizationCodeExpires fires
        then code.status = expired

    3. it is too late to redeem
        stipulate pkce_verifier_matches(code, null) = true
        app cannot do ClientExchangesAuthorizationCode(app, true, code, null, "ci-callback") on OAuth2ClientEndpoints

    ends: No tokens were issued from the stale code.
}

journey AnAdministratorConnectsTheCompanyDirectory {
    goal: Root adds an LDAP source; an ordinary user cannot; a source that accounts
          still sign in through cannot be deleted.

    cast:
        root:   accounts/User
        mallory: accounts/User
        ada:    accounts/User
        legacy: AuthSource

    given:
        root.is_admin = true
        root.is_active = true
        root.prohibit_login = false
        mallory.is_admin = false
        mallory.is_active = true
        mallory.prohibit_login = false
        legacy.name = "legacy-ldap"
        legacy.kind = ldap_bind_dn
        legacy.is_active = true
        legacy.sync_enabled = false
        login: UserLogin { user: ada, source: legacy, login_name: "ada", has_password: false, must_change_password: false }

    1. root creates a sync-enabled LDAP source
        root does AdminCreatesAuthSource(root, "corp-ldap", ldap_bind_dn, true, true, legacy.settings) on AuthSourceAdministration
            creating corp: AuthSource
        then AdminCreatesAuthSource fires
        then corp.sync_enabled = true
        then corp.is_active = true

    2. a non-admin cannot
        mallory cannot do AdminCreatesAuthSource(mallory, "shadow", smtp, true, false, legacy.settings) on AuthSourceAdministration

    3. the legacy source is still used by ada's account, so it stays
        stipulate legacy.in_use = true
        root cannot do AdminDeletesAuthSource(root, legacy) on AuthSourceAdministration
        then legacy exists

    ends: The new source is active; the legacy one is untouched.
}

journey TheDirectorySyncDeactivatesPeopleWhoLeft {
    goal: When an LDAP entry disappears, the next synchronisation deactivates the
          matching local account.

    cast:
        root: accounts/User
        ada:  accounts/User
        bob:  accounts/User
        corp: AuthSource

    given:
        root.is_admin = true
        root.is_active = true
        root.prohibit_login = false
        ada.is_active = true
        corp.name = "corp-ldap"
        corp.kind = ldap_bind_dn
        corp.is_active = true
        corp.sync_enabled = true
        login: UserLogin { user: ada, source: corp, login_name: "ada", has_password: false, must_change_password: false }
        bob_login: UserLogin { user: bob, source: corp, login_name: "bob", has_password: false, must_change_password: false }
        bob_entry: DirectoryEntry { source: corp, username: "bob", email: "bob@corp.example", is_admin: false, is_restricted: false }

    1. root runs the synchronisation from the dashboard
        -- the directory publishes no SSH key attribute
        stipulate corp.provides_ssh_keys = false
        root does AdminRunsExternalUserSync(root) on AuthSourceAdministration
        then AdminRunsExternalUserSync fires
        then LdapSourceSynchronised fires
        then ada.is_active = false
        then bob.is_active = true

    ends: Ada's account is inactive; she can no longer sign in or use tokens.
}

-- Updated for the decision "tokens everywhere": this journey used to show password
-- Basic auth refused only once a security key was enrolled; now it is refused for
-- everybody, and the token is the way in.
journey PasswordBasicAuthIsRefusedATokenWorks {
    goal: Ada has no second factor at all. A script sending her account password in
          Basic auth is still refused; her access token as the password is accepted.

    cast:
        req: ClientRequest
        ada: accounts/User

    given:
        req.carries_credentials = true
        req.via_trusted_proxy = false
        ada.is_active = true
        ada.prohibit_login = false
        ada.kind = individual
        login: UserLogin { user: ada, source: null, login_name: "ada", has_password: true, must_change_password: false }
        token: AccessToken { owner: ada, name: "git", scopes: {write_repository}, public_only: false, all_repositories: true }

    1. git sends ada's password
        stipulate password_matches(ada, "correct horse battery") = true
        stipulate login.has_second_factor = false
        req does ClientPresentsPassword(req, ada, "correct horse battery") on RequestAuthentication
        then ClientPasswordBasicAuthRefused fires
        then ClientAuthenticatesWithAccessToken does not fire

    2. git sends her token instead
        req does ClientPresentsAccessToken(req, token) on RequestAuthentication
        then ClientAuthenticatesWithAccessToken fires

    ends: The request is authenticated as ada through the token, never the password.
}

-- Decision: signing out revokes this device's remember-me record, not only the cookie.
journey SigningOutForgetsThisDevice {
    goal: Ada ticked "remember me". When she signs out, the remember-me record behind
          the cookie is revoked, so a copy of the cookie no longer signs anyone in.

    cast:
        s:     Session
        later: Session
        ada:   accounts/User

    given:
        s.status = anonymous
        later.status = anonymous
        ada.is_active = true
        ada.prohibit_login = false
        ada.kind = individual
        login: UserLogin { user: ada, source: null, login_name: "ada", has_password: true, must_change_password: false }

    1. she signs in and asks to be remembered
        stipulate password_matches(ada, "correct horse battery") = true
        stipulate ada.being_purged = false
        s does VisitorSignsInWithPassword(s, ada, "correct horse battery", true) on SignInPage
            creating lta: LongTermAuthorization
        then s.status = authenticated
        then s.remember_me = lta
        then lta.status = active

    2. she signs out
        ada does UserSignsOut(s) on SecuritySettings
        then UserSignsOut fires
        then s.status = destroyed
        then lta.status = revoked

    3. the remembered cookie no longer works
        later cannot do VisitorResumesWithRememberMe(later, lta) on SignInPage
        then later.status = anonymous

    ends: Nothing on that device keeps Ada signed in.
}

-- accounts asked: an account whose purge is under way cannot sign in.
journey AnAccountBeingPurgedCannotSignIn {
    goal: An administrator has started purging Ada's account. Her right password no
          longer signs her in.

    cast:
        s:   Session
        ada: accounts/User

    given:
        s.status = anonymous
        ada.is_active = true
        ada.prohibit_login = false
        ada.kind = individual
        login: UserLogin { user: ada, source: null, login_name: "ada", has_password: true, must_change_password: false }

    1. she tries her password while the purge runs
        stipulate password_matches(ada, "correct horse battery") = true
        stipulate ada.being_purged = true
        s cannot do VisitorSignsInWithPassword(s, ada, "correct horse battery", false) on SignInPage
        then s.status = anonymous

    ends: No session was opened for an account that is going away.
}

-- Decision 1: reset links live for reset_code_lifetime, the lifetime the mail states.
journey AResetLinkLivesAsLongAsTheMailSays {
    goal: The instance gives reset links one hour and activation links three. Ada's
          reset link expires after the hour the mail promised, not three.

    cast:
        s:   Session
        ada: accounts/User

    given:
        config.mail_service_configured = true
        config.reset_code_lifetime = 60.minutes
        config.activation_code_lifetime = 180.minutes
        s.status = anonymous
        s.last_activity_at = now
        ada.primary_email = "ada@example.com"
        login: UserLogin { user: ada, source: null, login_name: "ada", has_password: true, must_change_password: false }

    1. she asks for a reset mail
        s does VisitorRequestsPasswordReset(s, ada) on SignInPage
            creating code: EmailVerificationCode
        then VisitorRequestsPasswordReset fires
        then code.purpose = password_reset
        then code.status = pending

    2. an hour and a minute later the link is dead
        after 61.minutes
        then VerificationCodeExpires fires
        then code.status = expired

    ends: The link expired when the mail said it would.
}

-- Decision 6, default: one throttle covers activation resends and reset mails.
journey ResetMailsShareTheActivationThrottleByDefault {
    goal: Ada was just sent an activation mail. On a default instance the same
          throttle holds back a password-reset mail for a few minutes.

    cast:
        s:   Session
        ada: accounts/User

    given:
        config.mail_service_configured = true
        s.status = anonymous
        login: UserLogin { user: ada, source: null, login_name: "ada", has_password: true, must_change_password: false }
        sent: MailSendThrottle { user: ada, kind: resend }

    1. she asks for a reset mail straight away
        s cannot do VisitorRequestsPasswordReset(s, ada) on SignInPage

    ends: Nothing more was mailed until the throttle lapses.
}

-- Decision 6, the admin's alternative: one throttle per kind of mail.
journey AnAdminGivesResetMailsTheirOwnThrottle {
    goal: The administrator turned the shared mail throttle off. A fresh activation
          mail no longer holds back a reset mail, but two reset mails in a row are
          still throttled.

    cast:
        s:   Session
        ada: accounts/User

    given:
        config.mail_service_configured = true
        config.mail_throttle_shared = false
        s.status = anonymous
        ada.primary_email = "ada@example.com"
        login: UserLogin { user: ada, source: null, login_name: "ada", has_password: true, must_change_password: false }
        sent: MailSendThrottle { user: ada, kind: resend }

    1. the reset mail goes out despite the activation throttle
        s does VisitorRequestsPasswordReset(s, ada) on SignInPage
            creating throttle: MailSendThrottle
        then VisitorRequestsPasswordReset fires
        then throttle.kind = password_reset

    2. a second reset mail at once is held back
        s cannot do VisitorRequestsPasswordReset(s, ada) on SignInPage

    ends: Each kind of mail has its own few-minute throttle.
}

-- Decision 7: passkeys sign in on their own; plain security keys stay second factors.
journey APasskeySignsInWithoutAPassword {
    goal: Ada registers a passkey and signs in with it alone, no password and no
          second-factor page. Her older, non-discoverable security key cannot do that.

    cast:
        s:     Session
        other: Session
        ada:   accounts/User

    given:
        s.status = anonymous
        other.status = anonymous
        ada.is_active = true
        ada.prohibit_login = false
        ada.kind = individual
        login: UserLogin { user: ada, source: null, login_name: "ada", has_password: true, must_change_password: false }
        yubikey: WebAuthnCredential { user: ada, name: "yubikey", discoverable: false, sign_count: 7 }

    1. she registers a passkey in her security settings
        stipulate webauthn_attestation_valid(ada, "laptop-attestation") = true
        stipulate attestation_is_discoverable("laptop-attestation") = true
        ada does UserRegistersPasskey(ada, "laptop", "laptop-attestation") on SecuritySettings
            creating pk: WebAuthnCredential
        then UserRegistersPasskey fires
        then pk.discoverable = true

    2. on the sign-in page the passkey alone signs her in
        stipulate webauthn_assertion_valid(pk) = true
        stipulate ada.being_purged = false
        s does VisitorSignsInWithPasskey(s, pk, 1, false) on SignInPage
        then VisitorSignsInWithPasskey fires
        then s.status = authenticated
        then s.user = ada
        then s.authenticated_via = passkey
        then pk.sign_count = 1

    3. the old security key is not a passkey
        stipulate webauthn_assertion_valid(yubikey) = true
        other cannot do VisitorSignsInWithPasskey(other, yubikey, 8, false) on SignInPage
        then other.status = anonymous

    ends: Ada signs in with her passkey; the security key still only serves as a second factor.
}

-- Decision 8: auto-link only on an e-mail the identity provider has verified.
journey AnUnverifiedEmailDoesNotAutoLink {
    goal: The instance auto-links external identities. An IdP returns Ada's address
          but does not vouch for it, so nothing is linked: the visitor must sign in to
          Ada's account to link it. The same address, verified, links at once.

    cast:
        s:      Session
        s2:     Session
        ada:    accounts/User
        corp:   AuthSource

    given:
        config.oauth2_client_auto_registration = true
        config.oauth2_client_account_linking = auto
        s.status = anonymous
        s2.status = anonymous
        ada.prohibit_login = false
        corp.name = "corp"
        corp.kind = oauth2
        corp.is_active = true
        login: UserLogin { user: ada, source: null, login_name: "ada", has_password: true, must_change_password: false }
        shaky: ExternalIdentity { source: corp, external_id: "u-17", email: "ada@example.com", email_verified: false }
        vouched: ExternalIdentity { source: corp, external_id: "u-18", email: "ada@example.com", email_verified: true }

    1. the IdP returns her address unverified
        stipulate remote_placeholder_for(corp, "u-17") = null
        stipulate external_username(shaky, nickname) = "ada"
        stipulate username_available("ada") = false
        stipulate email_available("ada@example.com") = false
        stipulate user_by_email("ada@example.com") = ada
        stipulate login.has_second_factor = false
        stipulate ada.being_purged = false
        corp does ProviderReturnsIdentity(s, shaky) on IdentityProviderCallback
        then ProviderIdentityAutoLinksExistingAccount does not fire
        then ProviderIdentityNeedsLinking fires
        then s.pending_external_identity = shaky
        then s.status = anonymous

    2. a verified address links to her account
        stipulate remote_placeholder_for(corp, "u-18") = null
        stipulate external_username(vouched, nickname) = "ada"
        stipulate is_numeric_id("u-18") = false
        corp does ProviderReturnsIdentity(s2, vouched) on IdentityProviderCallback
            creating link: ExternalLogin
        then ProviderIdentityAutoLinksExistingAccount fires
        then link.user = ada
        then s2.status = authenticated
        then s2.user = ada

    ends: Only the verified identity was linked; the other waits for Ada to sign in.
}

-- Decision 9: re-consent replaces the grant's scope; issued tokens keep theirs.
journey ReConsentReplacesTheScope {
    goal: Ada granted an app only "openid". It now asks for repository access too. She
          sees the consent screen again; approving sets the grant to exactly the new
          scopes, while the token pair it already holds keeps its old scope.

    cast:
        ada: accounts/User
        app: OAuth2Application

    given:
        ada.is_active = true
        ada.prohibit_login = false
        app.owner_user = null
        app.owner_org = null
        app.builtin = null
        app.confidential = true
        app.client_id = "c0ff"
        grant: OAuth2Grant { user: ada, application: app, scopes: {"openid"}, nonce: null, counter: 2 }
        old: OAuth2TokenIssuance { grant: grant, scopes: {"openid"}, refresh_counter: 2, includes_id_token: true }

    1. the app asks for more and Ada is asked again
        stipulate redirect_uri_registered(app, "ci-callback") = true
        ada does UserRequestsAuthorization(ada, app, "ci-callback", "code", none, null, {"openid", "read:repository"}, null) on OAuth2Consent
        then UserRequestsAuthorization fires

    2. she approves the new scopes
        ada does UserGrantsConsent(ada, app, "ci-callback", {"openid", "read:repository"}, none, null, null) on OAuth2Consent
            creating code: OAuth2AuthorizationCode
        then UserGrantsConsent fires
        then code.grant = grant
        then grant.scopes = {"openid", "read:repository"}
        then old.scopes = {"openid"}

    ends: One grant with the new scopes; the old tokens carry the old scope until refreshed.
}

-- Decision 10: while 2FA is required, the last second factor stays.
journey TheLastSecondFactorStaysWhileTwoFactorIsRequired {
    goal: The instance requires 2FA of everyone. Ada's only factor is a security key,
          so she cannot remove it; once she has enrolled TOTP she can.

    cast:
        ada: accounts/User

    given:
        config.global_two_factor_requirement = all
        ada.is_active = true
        ada.prohibit_login = false
        ada.kind = individual
        login: UserLogin { user: ada, source: null, login_name: "ada", has_password: true, must_change_password: false }
        key: WebAuthnCredential { user: ada, name: "yubikey", discoverable: false, sign_count: 7 }

    1. removing her only factor is refused
        ada cannot do UserRemovesSecurityKey(ada, key) on SecuritySettings
        then key exists

    2. she enrols an authenticator app
        stipulate enrolment_passcode_valid(ada, "492039") = true
        ada does UserEnrolsTotp(ada, "492039") on SecuritySettings
        then UserEnrolsTotp fires

    3. now the key may go
        ada does UserRemovesSecurityKey(ada, key) on SecuritySettings
        then UserRemovesSecurityKey fires
        then key does not exist

    ends: Ada always holds at least one second factor.
}

-- accounts asked: a name a site admin reserved cannot be registered.
journey AReservedNameCannotBeRegistered {
    goal: An admin reserved the name "ada" when her old account was deleted.
          Somebody trying to sign up as "ada" is refused, even though every other
          check passes.

    cast:
        s: Session

    given:
        s.status = anonymous
        held: accounts/ReservedName { name: "ada" }

    1. the sign-up is refused
        stipulate email_domain_allowed("ada@example.com") = true
        stipulate password_acceptable("correct horse battery") = true
        stipulate username_available("ada") = true
        stipulate email_available("ada@example.com") = true
        s cannot do VisitorRegisters(s, "ada", "ada@example.com", "correct horse battery") on SignInPage
        then s.status = anonymous

    ends: No account took the reserved name.
}

-- decided: administration 3. Signing in keeps working in read-only mode; making a
-- new credential does not.
journey ReadOnlyModeKeepsSignInButRefusesANewToken {
    goal: The instance is in maintenance. Ada can still sign in to read, but her
          attempt to create an access token is refused until the admin switches
          read-only mode off.

    cast:
        s:    Session
        ada:  accounts/User
        gate: access/InstanceWriteGate

    given:
        s.status = anonymous
        gate.read_only = true
        ada.is_active = true
        ada.prohibit_login = false
        ada.is_admin = false
        ada.kind = individual
        login: UserLogin { user: ada, source: null, login_name: "ada", has_password: true, must_change_password: false }

    1. she signs in
        stipulate password_matches(ada, "correct horse battery") = true
        stipulate ada.being_purged = false
        stipulate login.has_second_factor = false
        s does VisitorSignsInWithPassword(s, ada, "correct horse battery", false) on SignInPage
        then VisitorSignsInWithPassword fires
        then s.status = authenticated

    2. a new token is refused
        ada cannot do UserCreatesAccessToken(ada, ada, "ci", {read_repository}, false, true, {}, session) on ApplicationSettings

    3. so is enrolling a security key
        stipulate webauthn_attestation_valid(ada, "att") = true
        ada cannot do UserRegistersSecurityKey(ada, "yubikey", "att") on SecuritySettings

    ends: Ada reads the instance; nothing she owns changed.
}

-- administration asked: an admin's 2FA reset removes every second factor.
journey AnAdministratorResetsTwoFactor {
    goal: Ada lost her phone and her security key. Root resets her second
          factors from the admin edit page; her TOTP and her key are gone.

    cast:
        root: accounts/User
        ada:  accounts/User

    given:
        root.is_admin = true
        root.is_active = true
        root.prohibit_login = false
        ada.is_active = true
        ada.prohibit_login = false
        totp: TwoFactor { user: ada, last_used_passcode: null, scratch_code_generation: 1 }
        key: WebAuthnCredential { user: ada, name: "yubikey", discoverable: false, sign_count: 3 }

    1. root resets her two-factor authentication
        root does AdminResetsUserTwoFactor(root, ada) on AdminUserAccount
        then AdminResetRemovesSecondFactors fires
        then totp does not exist
        then key does not exist

    ends: Ada signs in with her password alone and may enrol again.
}

-- An administrator's password reset is stored like any other change.
journey AnAdminSetPasswordForgetsOldDevices {
    goal: Root sets a new password for Ada. Every device she had ticked
          "remember me" on is forgotten and she is told by mail.

    cast:
        root: accounts/User
        ada:  accounts/User

    given:
        root.is_admin = true
        root.is_active = true
        root.prohibit_login = false
        ada.is_active = true
        ada.prohibit_login = false
        login: UserLogin { user: ada, source: null, login_name: "ada", has_password: true, must_change_password: false }
        laptop: LongTermAuthorization { user: ada, sso_source: null, status: active }

    1. root sets the password and asks for a change at next sign-in
        stipulate password_acceptable("temporary pass 1") = true
        root does AdminSetsUserPassword(root, ada, "temporary pass 1", true) on AdminUserAccount
        then AdminSetPasswordRetiresOldDevices fires
        then laptop.status = revoked
        then login.must_change_password = true

    ends: Only the new password signs Ada in, and she must change it first.
}
