-- Journeys through discovery: explore, search, indexing, insights, crawlers.
--
-- The singletons (the directory, the code indexer, the issue indexer) are
-- reached in the spec through accessor functions; each journey says which
-- instance they are with `stipulate`, which the report prints first.

world {
    cast:
        dir: Directory
    given:
        dir.require_signin_view = false
        dir.explore_require_signin = false
        dir.users_page_disabled = false
        dir.organizations_page_disabled = false
        dir.code_page_disabled = false
        dir.code_unit_globally_disabled = false
        dir.sitemap_enabled = true
        dir.milestones_dashboard_enabled = true
        dir.version = "1.0.0"
}

-- The plain case: somebody looks around the instance.
journey AVisitorBrowsesRepositories {
    goal: Ada, signed in, opens the explore page and searches for "forge",
          sorted by most recently updated, and sees the matching repository.

    cast:
        ada:  accounts/User
        repo: repositories/Repository

    given:
        ada.is_active = true
        ada.is_restricted = false
        repo.name = "forgejo"
        repo.is_private = false

    1. she searches the explore page
        stipulate directory() = dir
        stipulate repository_search(ada, explore, null, "forge", null, {}, recent_update) = {repo}
        ada does ViewerSearchesRepositories(ada, explore, null, "forge", null, {}, recent_update) on ExploreDirectory
            creating search: RepositorySearch
        then ViewerSearchesRepositories fires
        then search.keyword = "forge"
        then search.scope = explore

    2. the repository is listed for her
        ada sees repo.name on ExploreDirectory in search

    ends: Ada has a page of repositories she is allowed to read.
}

-- Somebody else's search is not something I am shown.
journey ASearchBelongsToItsViewer {
    goal: Bob cannot read the result page Ada received; each viewer gets the
          listing computed for them.

    cast:
        ada:  accounts/User
        bob:  accounts/User
        repo: repositories/Repository

    given:
        ada.is_active = true
        bob.is_active = true

    1. ada searches
        stipulate directory() = dir
        stipulate repository_search(ada, explore, null, "secret", null, {}, alphabetically) = {repo}
        ada does ViewerSearchesRepositories(ada, explore, null, "secret", null, {}, alphabetically) on ExploreDirectory
            creating search: RepositorySearch

    2. bob is not shown ada's results
        bob cannot see repo.name on ExploreDirectory in search

    ends: Results are scoped to the viewer who asked.
}

-- The operator closed the explore area to anonymous visitors.
journey AnonymousVisitorsMustSignIn {
    goal: With the explore area requiring sign-in, an anonymous visitor's
          searches of repositories, organizations and topics are refused.

    cast:
        guest: accounts/User

    given:
        dir.explore_require_signin = true

    1. an anonymous repository search is refused
        stipulate directory() = dir
        guest cannot do ViewerSearchesRepositories(null, explore, null, "", null, {}, recent_update) on ExploreDirectory

    2. so is browsing organizations
        guest cannot do ViewerExploresOrganizations(null, "", newest) on ExploreDirectory

    3. and the topic picker
        guest cannot do ClientSearchesTopics(null, "go") on ExploreDirectory

    ends: Nothing in the directory is answered without signing in.
}

-- The operator switched the users page off.
-- Updated for decided discovery 3: the API user search now still answers
-- signed-in users (it used to be refused for everyone).
journey TheUsersPageIsDisabled {
    goal: With the explore users page disabled, the page is refused and so is
          an anonymous API user search, but Ada's signed-in API search (used
          by pickers) still answers, and the organizations page still does.

    cast:
        ada:   accounts/User
        guest: accounts/User

    given:
        ada.is_active = true
        dir.users_page_disabled = true

    1. the users page is refused
        stipulate directory() = dir
        ada cannot do ViewerSearchesUsers(ada, explore, "bo", newest) on UserDirectory

    2. an anonymous API search is refused
        guest cannot do ViewerSearchesUsers(null, api, "bo", alphabetically) on UserDirectory

    3. ada's API search still answers
        stipulate contains_nul("bo") = false
        ada does ViewerSearchesUsers(ada, api, "bo", alphabetically) on UserDirectory
            creating users: UserSearch
        then ViewerSearchesUsers fires
        then users.match_email = true

    4. organizations remain browsable
        ada does ViewerExploresOrganizations(ada, "", newest) on OrganizationDirectory
            creating orgs: OrganizationSearch
        then ViewerExploresOrganizations fires

    ends: Only the public users directory went dark.
}

-- A site admin re-indexes a repository and the queue works it off.
journey AnAdminReindexesARepository {
    goal: Root asks for a code re-index of a repository; the job is queued
          once, and a moment later the index reflects the default-branch head.

    cast:
        root: accounts/User
        repo: repositories/Repository
        svc:  CodeSearchService

    given:
        root.is_admin = true
        root.is_active = true
        root.prohibit_login = false
        config.repo_indexer_enabled = true
        svc.enabled = true
        svc.status = ready
        svc.kind = bleve

    1. root requests the re-index
        stipulate code_search_service() = svc
        root does AdminRequestsReindex(root, repo, code) on ReindexControls
            creating job: CodeIndexJob
        then AdminRequestsCodeReindex fires
        then QueueCodeIndexJob fires
        then job.status = queued

    2. the queue picks it up
        stipulate default_branch_head(repo) = "c0ffee"
        stipulate repository_kind_indexed(repo) = true
        after 1.second
        then CodeIndexJobRuns fires
        then job.status = completed

    ends: The repository's code index reflects commit c0ffee.
}

-- Only site admins may force a re-index.
journey AnOwnerCannotForceAReindex {
    goal: Ada owns a repository but is not a site admin; the re-index control
          is not hers to use.

    cast:
        ada:  accounts/User
        repo: repositories/Repository
        svc:  CodeSearchService

    given:
        ada.is_admin = false
        ada.is_active = true
        svc.enabled = true
        svc.status = ready

    1. her request is refused
        stipulate code_search_service() = svc
        ada cannot do AdminRequestsReindex(ada, repo, code) on ReindexControls

    ends: Nothing was queued.
}

-- Without an indexer the repository search still works, through git grep.
journey CodeSearchFallsBackToGrep {
    goal: On an instance with no code indexer, Ada searches one repository's
          code with a regular expression and gets git-grep results.

    cast:
        ada:  accounts/User
        repo: repositories/Repository
        svc:  CodeSearchService

    given:
        ada.is_active = true
        svc.enabled = false
        svc.status = ready
        repo.default_branch = "main"

    1. she searches the repository
        stipulate code_search_service() = svc
        stipulate can_read_code(ada, repo) = true
        ada does ReaderSearchesRepositoryCode(ada, repo, null, "func main", null, regexp) on CodeSearchPage
            creating search: CodeSearch
        then ReaderSearchesRepositoryCodeByGrep fires
        then ReaderSearchesRepositoryCodeIndexed does not fire
        then search.used_index = false
        then search.effective_mode = regexp

    2. she sees how the search was run
        ada sees search.used_index on CodeSearchPage in search

    ends: Results come from the default branch, found by git grep.
}

-- With an indexer, fuzzy is downgraded when it is not enabled.
journey IndexedSearchDowngradesFuzzy {
    goal: The indexer is running without fuzzy matching; a fuzzy request is
          answered as a union-of-words search.

    cast:
        ada:  accounts/User
        repo: repositories/Repository
        svc:  CodeSearchService

    given:
        ada.is_active = true
        svc.enabled = true
        svc.status = ready
        svc.fuzzy_enabled = false

    1. she asks for fuzzy matching
        stipulate code_search_service() = svc
        stipulate can_read_code(ada, repo) = true
        ada does ReaderSearchesRepositoryCode(ada, repo, null, "parse config", null, fuzzy) on CodeSearchPage
            creating search: CodeSearch
        then ReaderSearchesRepositoryCodeIndexed fires
        then search.effective_mode = union
        then search.used_index = true
        then search.index_unavailable = false

    ends: Fuzzy is offered only when the operator enables it.
}

-- Code search never opens a repository the viewer cannot read.
journey AStrangerCannotSearchPrivateCode {
    goal: Bob has no access to a private repository's code, so its code
          search is refused regardless of indexer.

    cast:
        bob:  accounts/User
        repo: repositories/Repository
        svc:  CodeSearchService

    given:
        bob.is_active = true
        repo.is_private = true
        svc.enabled = true
        svc.status = ready

    1. the search is refused
        stipulate code_search_service() = svc
        stipulate can_read_code(bob, repo) = false
        bob cannot do ReaderSearchesRepositoryCode(bob, repo, null, "password", null, exact) on CodeSearchPage

    ends: Bob learns nothing about the repository's contents.
}

-- The indexer has to come up in time.
journey TheCodeIndexerFailsToStart {
    goal: The code indexer is still starting when the start-up timeout
          passes; it is declared unavailable.

    cast:
        svc: CodeSearchService

    given:
        svc.enabled = true
        svc.status = starting
        svc.kind = elasticsearch
        svc.started_at = now

    1. thirty-one seconds pass
        after 31.seconds
        then CodeIndexerStartupTimesOut fires
        then svc.status = unavailable

    ends: Code search reports the indexer as unavailable.
}

-- decided: discovery 4 — the instance keeps running without a ready index.
journey ALateIndexerDegradesThenRecovers {
    goal: The code indexer misses the start-up timeout; the instance keeps
          serving, Ada's repository search says the index is unavailable, and
          once the indexer finishes starting search works again.

    cast:
        ada:  accounts/User
        repo: repositories/Repository
        svc:  CodeSearchService

    given:
        ada.is_active = true
        svc.enabled = true
        svc.status = starting
        svc.kind = elasticsearch
        svc.started_at = now
        svc.fuzzy_enabled = false

    1. the timeout passes and search degrades
        after 31.seconds
        then CodeIndexerStartupTimesOut fires
        then svc.status = unavailable

    2. ada still gets an answer, flagged unavailable
        stipulate code_search_service() = svc
        stipulate can_read_code(ada, repo) = true
        ada does ReaderSearchesRepositoryCode(ada, repo, null, "main", null, exact) on CodeSearchPage
            creating search: CodeSearch
        then ReaderSearchesRepositoryCodeIndexed fires
        then search.index_unavailable = true

    3. the indexer finishes starting late
        svc does CodeIndexerStartupCompleted(svc, false) on CodeIndexBackend
        then CodeIndexerStarts fires
        then svc.status = ready

    ends: Search was unavailable, never the whole instance.
}

-- decided: discovery 5 — admins get no code-search bypass.
journey AnAdminSearchesOnlyReadableCode {
    goal: Root searches the code of one repository she may not read under the
          access rules; the search is refused like anyone else's.

    cast:
        root: accounts/User
        repo: repositories/Repository
        svc:  CodeSearchService

    given:
        root.is_admin = true
        root.is_active = true
        repo.is_private = true
        svc.enabled = true
        svc.status = ready

    1. the search is refused
        stipulate code_search_service() = svc
        stipulate can_read_code(root, repo) = false
        root cannot do ReaderSearchesRepositoryCode(root, repo, null, "secret", null, exact) on CodeSearchPage

    ends: Code search follows read access, whoever asks.
}


-- Cross-repository dashboards are for signed-in users.
journey TheIssueDashboard {
    goal: Ada opens her pull-request dashboard filtered to review requests;
          an anonymous visitor cannot open a dashboard at all.

    cast:
        ada:   accounts/User
        guest: accounts/User
        isvc:  IssueIndexService

    given:
        ada.is_active = true
        isvc.status = ready
        isvc.kind = bleve

    1. ada lists pull requests awaiting her review
        stipulate issue_index_service() = isvc
        ada does UserViewsIssueDashboard(ada, null, null, pulls_only, review_requested, "", open, recent_update) on IssueSearchPage
            creating list: IssueSearch
        then UserViewsPersonalIssueDashboard fires
        then list.scope = dashboard
        then list.used_index = false
        then list.include_all_public = true

    2. she sees the counts
        ada sees list.open_count on IssueSearchPage in list

    3. an anonymous visitor cannot open a dashboard
        guest cannot do UserViewsIssueDashboard(null, null, null, issues_only, all, "", open, latest) on IssueSearchPage

    ends: Ada sees review requests across every repository she can read.
}

-- Pulse and the contributors graph, including the cache expiring.
journey ARepositorysPulseAndContributors {
    goal: Ada, who can read a repository, looks at its weekly pulse, then
          asks for the contributors graph; it is generated in the background,
          served, and discarded once the cache lifetime passes.

    cast:
        ada:  accounts/User
        repo: repositories/Repository

    given:
        ada.is_active = true
        repo.is_empty = false
        repo.default_branch = "main"

    1. she opens the weekly pulse
        stipulate can_read_code(ada, repo) = true
        stipulate can_read_issues(ada, repo) = true
        stipulate can_read_pulls(ada, repo) = false
        stipulate can_read_releases(ada, repo) = true
        ada does ReaderViewsActivity(ada, repo, weekly) on RepositoryInsights
            creating pulse: ActivityReport
        then pulse.includes_pulls = false
        then pulse.includes_code = true
        ada sees pulse.period on RepositoryInsights in pulse

    2. she asks for the contributors graph and is told to come back
        ada does ReaderRequestsContributorStats(ada, repo, "main") on RepositoryInsights
            creating stats: ContributorStats
        then stats.status = generating

    3. the background worker finishes
        stats does ContributorStatsGenerated(stats, true) on ContributorStatsWorker
        then ContributorStatsComplete fires
        then stats.status = ready

    4. a day later the cached statistics are gone
        after 17.hours
        then ContributorStatsExpire fires
        then stats does not exist

    ends: The next request will generate fresh statistics.
}

-- Profiles respect account visibility and fall back to repositories.
journey VisitingAProfile {
    goal: Ada opens Bob's overview tab; Bob has no profile README, so she
          lands on his repositories. Carol, who may not see Bob, is refused.

    cast:
        ada:   accounts/User
        bob:   accounts/User
        carol: accounts/User

    given:
        ada.is_active = true
        carol.is_active = true
        carol.is_restricted = true

    1. ada opens the overview
        stipulate can_see_profile(ada, bob) = true
        stipulate has_profile_readme(bob, ada) = false
        ada does ViewerOpensProfile(ada, bob, overview) on ProfilePage
            creating view: ProfileView
        then view.tab = repositories
        then view.has_profile_readme = false
        then view.default_sort = recent_update
        ada sees view.tab on ProfilePage in view

    2. carol may not see bob
        stipulate can_see_profile(carol, bob) = false
        carol cannot do ViewerOpensProfile(carol, bob, overview) on ProfilePage

    ends: The profile is shown only to those who may see the account.
}

-- Crawlers: the sitemap can be switched off; go-get always answers.
journey CrawlersAndTools {
    goal: With the sitemap disabled a crawler is turned away, while the go
          tool still gets import metadata for a repository that does not
          exist, pointing at the instance default branch.

    cast:
        bot: accounts/User

    given:
        dir.sitemap_enabled = false

    1. the sitemap is refused
        stipulate directory() = dir
        bot cannot do CrawlerFetchesSitemapIndex(null) on Crawlers

    2. go get still gets an answer
        stipulate repository_named("ada", "tool.git") = null
        stipulate trim_git_suffix("tool.git") = "tool"
        bot does GoToolRequestsImportMeta(null, "ada", "tool.git") on Crawlers
            creating answer: GoImportAnswer
        then GoToolRequestsImportMeta fires
        then answer.source_branch = "main"
        then answer.owner_name = "ada"

    ends: Crawlers see only what the operator allows; tooling keeps working.
}

-- decided: discovery 1 — go-get leaks nothing about unreadable repositories.
journey GoGetHidesAPrivateDefaultBranch {
    goal: A private repository uses "trunk" as its default branch; an
          anonymous go tool gets the instance default instead, while its
          owner Ada gets "trunk".

    cast:
        ada:  accounts/User
        bot:  accounts/User
        repo: repositories/Repository

    given:
        ada.is_active = true
        repo.is_private = true
        repo.default_branch = "trunk"

    1. the anonymous go tool sees the instance default
        stipulate repository_named("ada", "secret") = repo
        stipulate trim_git_suffix("secret") = "secret"
        stipulate can_see_repository(null, repo) = false
        bot does GoToolRequestsImportMeta(null, "ada", "secret") on Crawlers
            creating answer: GoImportAnswer
        then answer.source_branch = "main"

    2. the owner sees the real branch
        stipulate can_see_repository(ada, repo) = true
        ada does GoToolRequestsImportMeta(ada, "ada", "secret") on Crawlers
            creating mine: GoImportAnswer
        then mine.source_branch = "trunk"

    ends: Only readers learn the repository's real default branch.
}

-- Markup rendering needs an authenticated client.
journey RenderingMarkup {
    goal: An authenticated client renders a comment; an anonymous one is
          refused.

    cast:
        ada:   accounts/User
        guest: accounts/User

    given:
        ada.is_active = true

    1. ada renders an empty document
        ada does ClientRendersMarkup(ada, comment, "", null, null, false, null) on MiscellaneousApi
            creating out: MarkupRendering
        then out.html = ""

    2. an anonymous client is refused
        guest cannot do ClientRendersMarkup(null, gfm, "**hi**", null, null, false, null) on MiscellaneousApi

    ends: Rendering is a signed-in convenience, and its output is sanitised.
}
