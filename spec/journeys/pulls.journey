-- Journeys through pulls.allium: opening, checking, reviewing, merging and
-- the refusals around them.
--
-- ada contributes from her own branch; bob maintains the repository (code and
-- pull-request writer); carol can only read; root is an instance admin.
-- Permission answers come from access and are stipulated per journey; git
-- answers (conflicts, diffs, commits) are black boxes stipulated per step.

world {
    cast:
        ada:   accounts/User
        bob:   accounts/User
        carol: accounts/User
        root:  accounts/User
        repo:  repositories/Repository
        indexer: discovery/IssueIndexService
        conv:  issues/Issue
        pr:    PullRequest
    given:
        indexer.status = ready
        ada.is_admin = false
        ada.is_active = true
        bob.is_admin = false
        bob.is_active = true
        carol.is_admin = false
        carol.is_active = true
        root.is_admin = true
        root.is_active = true
        repo.name = "widgets"
        repo.default_branch = "main"
        repo.is_archived = false
        repo.is_mirror = false
        repo.is_empty = false
        repo.is_fork = false
        repo.is_private = false
        conv.repository = repo
        conv.poster = ada
        conv.title = "Add widgets"
        conv.is_pull = true
        conv.status = open
        conv.is_locked = false
        pr.issue = conv
        pr.flow = branch
        pr.head_repository = repo
        pr.head_branch = "feature"
        pr.base_repository = repo
        pr.base_branch = "main"
        pr.head_commit_sha = "f00d"
        pr.status = mergeable
        pr.commits_ahead = 2
        pr.commits_behind = 0
        pr.allow_maintainer_edit = false
}

-- The happy path of opening: a contributor proposes a branch and the
-- background check finds it mergeable.
journey ContributorOpensAPullRequest {
    goal: Ada pushed a feature branch and opens a pull request into main. The
          pull request starts out being checked; a moment later the check
          finds it merges cleanly, and anyone who can read pull requests sees
          that.

    1. ada opens the pull request
        stipulate can_read_pulls(ada, repo) = true
        stipulate can_read_code(ada, repo) = true
        stipulate branch_exists(repo, "main") = true
        stipulate branch_exists(repo, "feature") = true
        stipulate is_blocked_by_owner(repo, ada) = false
        stipulate trimmed_length("Add widgets") = 11
        stipulate open_pull_request_exists(repo, "feature", repo, "main") = false
        stipulate has_wip_prefix("Add widgets") = false
        stipulate is_related_fork(repo, repo) = false
        stipulate truncate("Add widgets", 255) = "Add widgets"
        stipulate next_issue_index(repo) = 1
        stipulate head_commit_of(repo, "feature") = "f00d"
        stipulate commits_ahead_of(repo, "feature", repo, "main") = 2
        stipulate commits_behind_of(repo, "feature", repo, "main") = 0
        stipulate commits_between(repo, "main", repo, "feature") = "f00d"
        ada does UserOpensPullRequest(ada, repo, "main", repo, "feature", "Add widgets", "Adds the widget factory.", true) on PullRequestComposer
            creating opened: PullRequest
        then UserOpensPullRequest fires
        then opened.status = checking
        then opened.flow = branch
        then opened.allow_maintainer_edit = true

    2. the background check finds it mergeable
        stipulate merge_check_outcome(opened) = clean
        stipulate protected_files_changed(opened) = {}
        stipulate merge_base_of(opened) = "ba5e"
        stipulate issue_index_service() = indexer
        after 1.minute
        then CheckMergeability fires
        then opened.status = mergeable
        then opened.last_check_outcome = clean

    3. carol, a reader, sees its state
        stipulate can_read_pulls(carol, repo) = true
        carol sees opened.status on PullRequestPage in opened

    ends: An open pull request exists for feature -> main, marked mergeable.
}

-- Opening needs read access to the code of both sides.
journey StrangerCannotOpenAPullRequest {
    goal: Carol cannot read the repository's code (it is restricted to her),
          so the proposal is refused before anything is created.

    1. carol tries to open a pull request
        stipulate can_read_pulls(carol, repo) = true
        stipulate can_read_code(carol, repo) = false
        carol cannot do UserOpensPullRequest(carol, repo, "main", repo, "feature", "Sneaky", "", false) on PullRequestComposer

    ends: Nothing was opened.
}

-- An archived repository accepts no new pull requests.
journey ArchivedRepositoryRefusesPullRequests {
    goal: Even a writer cannot open a pull request once the repository is archived.

    given:
        repo.is_archived = true

    1. bob tries to open a pull request
        stipulate can_read_pulls(bob, repo) = true
        stipulate can_read_code(bob, repo) = true
        bob cannot do UserOpensPullRequest(bob, repo, "main", repo, "fix", "Fix", "", false) on PullRequestComposer

    ends: Nothing was opened.
}

-- The world's pull request: open, mergeable, from ada's feature branch.
journey ReviewThenMerge {
    goal: Carol, a code writer, approves ada's pull request; bob merges it with
          a merge commit. The pull request is merged and its conversation is
          closed by issues.

    1. carol approves
        stipulate can_read_pulls(carol, repo) = true
        stipulate protection_for(repo, "main") = null
        stipulate can_write_code(carol, repo) = true
        carol does UserSubmitsReview(carol, pr, approve, "LGTM", "f00d") on PullRequestPage
            creating approval: Review
        then UserSubmitsReview fires
        then ReviewVerdictSupersedesEarlierState fires
        then approval.kind = approve
        then approval.is_official = true
        then approval.is_stale = false

    2. everyone reading the pull request sees the approval
        stipulate can_read_pulls(ada, repo) = true
        ada sees approval.kind on PullRequestPage in pr

    3. bob merges it
        stipulate can_write_code(bob, repo) = true
        stipulate merge_style_allowed(repo, merge) = true
        stipulate has_wip_prefix("Add widgets") = false
        stipulate merge_signing_satisfied(pr, bob, merge) = true
        stipulate has_open_blocking_dependencies(conv) = false
        stipulate branch_exists(repo, "feature") = true
        stipulate within_quota(repo) = true
        stipulate compose_merge_message(pr, merge, "", "") = "Merge pull request 'Add widgets' (#1) from feature into main"
        stipulate merge_result_commit(pr, merge, "Merge pull request 'Add widgets' (#1) from feature into main") = "abc1"
        bob does UserMergesPullRequest(bob, pr, merge, "", "", null, false, false) on PullRequestMergeBox
        then UserMergesPullRequest fires
        then pr.status = merged
        then pr.merge_style = merge
        then pr.merger = bob
        then pr.merged_commit_sha = "abc1"

    ends: The pull request is merged at abc1 by bob; issues closes its
          conversation in reaction to PullRequestMerged.
}

-- The poster may not approve their own work.
journey PosterCannotApproveTheirOwnPullRequest {
    goal: Ada tries to approve her own pull request; the review is refused,
          though she may still leave a plain comment review.

    1. ada tries to approve
        stipulate can_read_pulls(ada, repo) = true
        ada cannot do UserSubmitsReview(ada, pr, approve, "ship it", "f00d") on PullRequestPage

    2. a comment review is fine
        stipulate trimmed_length("Ready for review") = 16
        ada does UserSubmitsReview(ada, pr, comment, "Ready for review", "f00d") on PullRequestPage
            creating note: Review
        then note.kind = comment
        then note.is_official = false

    ends: No approval from the poster exists; her comment review does.
}

-- Branch protection holds the merge back; an instance admin may merge anyway.
journey ProtectionBlocksMergeUntilAnAdminOverrides {
    goal: main requires two official approvals. Bob, a code writer, cannot
          merge with none; root, an instance admin, uses "merge anyway".

    cast:
        rule: code/ProtectedBranch
    given:
        rule.repository = repo
        rule.rule_name = "main"
        rule.merge_allowlist_enabled = false
        rule.approvals_allowlist_enabled = false
        rule.status_check_enabled = false
        rule.required_approvals = 2
        rule.block_on_rejected_reviews = false
        rule.block_on_official_review_requests = false
        rule.block_on_outdated_branch = false
        rule.dismiss_stale_approvals = false
        rule.ignore_stale_approvals = false
        rule.apply_to_admins = false
        rule.protected_file_patterns = []

    1. bob cannot merge without approvals
        stipulate protection_for(repo, "main") = rule
        stipulate can_write_code(bob, repo) = true
        stipulate merge_style_allowed(repo, squash) = true
        stipulate has_wip_prefix("Add widgets") = false
        stipulate merge_signing_satisfied(pr, bob, squash) = true
        stipulate has_open_blocking_dependencies(conv) = false
        stipulate branch_exists(repo, "feature") = true
        stipulate within_quota(repo) = true
        stipulate required_status_checks_pass(pr) = true
        bob cannot do UserMergesPullRequest(bob, pr, squash, "", "", null, false, false) on PullRequestMergeBox

    2. nor can he force it: he is not a repository admin
        stipulate is_repo_admin(bob, repo) = false
        bob cannot do UserMergesPullRequest(bob, pr, squash, "", "", null, false, true) on PullRequestMergeBox

    3. root merges anyway
        stipulate can_write_code(root, repo) = true
        stipulate merge_signing_satisfied(pr, root, squash) = true
        stipulate compose_merge_message(pr, squash, "", "") = "Add widgets (#1)"
        stipulate merge_result_commit(pr, squash, "Add widgets (#1)") = "5a5a"
        root does UserMergesPullRequest(root, pr, squash, "", "", null, false, true) on PullRequestMergeBox
        then pr.status = merged
        then pr.merge_style = squash
        then pr.merger = root

    ends: The pull request is squash-merged by root despite the missing approvals.
}

-- A conflicting pull request cannot be merged by anyone.
journey ConflictsBlockTheMerge {
    goal: Ada retargets her pull request to the release branch, where it
          conflicts. The check records the conflicting files and the merge
          button refuses.

    1. ada retargets to release
        stipulate branch_exists(repo, "release") = true
        stipulate head_equals_branch(pr, "release") = false
        stipulate open_pull_request_exists(repo, "feature", repo, "release") = false
        stipulate commits_ahead_of(repo, "feature", repo, "release") = 4
        stipulate commits_behind_of(repo, "feature", repo, "release") = 6
        ada does UserChangesPullRequestTarget(ada, pr, "release") on PullRequestAuthorControls
        then pr.status = checking

    2. the check finds conflicts
        stipulate merge_check_outcome(pr) = conflicting
        stipulate conflicting_files(pr) = {"widgets.go"}
        stipulate merge_base_of(pr) = "ba5e"
        after 1.minute
        then CheckMergeability fires
        then pr.status = conflict

    3. bob cannot merge it
        stipulate protection_for(repo, "release") = null
        stipulate can_write_code(bob, repo) = true
        stipulate merge_style_allowed(repo, merge) = true
        stipulate has_wip_prefix("Add widgets") = false
        bob cannot do UserMergesPullRequest(bob, pr, merge, "", "", null, false, false) on PullRequestMergeBox

    4. readers see which files conflict
        stipulate can_read_pulls(carol, repo) = true
        carol sees pr.conflicted_files on PullRequestPage in pr

    ends: The pull request waits in `conflict` until its head or base moves.
}

-- Merge when checks succeed.
journey AutoMergeWaitsForRequiredChecks {
    goal: main requires status checks. Bob schedules the merge while CI is
          still running; when the checks pass the pull request merges itself
          as bob.

    cast:
        rule: code/ProtectedBranch
    given:
        rule.repository = repo
        rule.rule_name = "main"
        rule.merge_allowlist_enabled = false
        rule.approvals_allowlist_enabled = false
        rule.status_check_enabled = true
        rule.required_approvals = 0
        rule.block_on_rejected_reviews = false
        rule.block_on_official_review_requests = false
        rule.block_on_outdated_branch = false
        rule.dismiss_stale_approvals = false
        rule.ignore_stale_approvals = false
        rule.apply_to_admins = false
        rule.protected_file_patterns = []

    1. bob schedules the merge while checks are pending
        stipulate protection_for(repo, "main") = rule
        stipulate can_write_code(bob, repo) = true
        stipulate merge_style_allowed(repo, rebase) = true
        stipulate has_wip_prefix("Add widgets") = false
        stipulate merge_signing_satisfied(pr, bob, rebase) = true
        stipulate has_open_blocking_dependencies(conv) = false
        stipulate default_merge_message(pr, rebase) = ""
        bob does UserSchedulesAutoMerge(bob, pr, rebase, null, false) on PullRequestMergeBox
            creating scheduled: AutoMerge
        then scheduled.scheduled_by = bob
        then pr.status = mergeable

    2. the schedule is visible on the merge box
        bob sees scheduled.scheduled_by on PullRequestMergeBox in pr

    3. CI reports success and the merge happens
        stipulate required_status_checks_pass(pr) = true
        -- no approvals are required, so with checks passing the rule is met
        -- (the approval projections are not computed by the walker)
        stipulate pr.protection_satisfied = true
        -- quiet the reactions of other modules to the merge
        stipulate issue_index_service() = indexer
        stipulate actions_unit_enabled(repo) = false
        stipulate branch_exists(repo, "feature") = true
        stipulate merge_result_commit(pr, rebase, "") = "beef"
        after 1.minute
        then AutoMergeExecutes fires
        then pr.status = merged
        then pr.merge_style = rebase
        then pr.merger = bob
        then scheduled does not exist

    ends: The pull request merged as soon as its required checks succeeded.
}

-- A draft review is only its author's until submitted.
journey DraftReviewStaysPrivate {
    goal: Carol starts a review with a line comment. Until she submits, ada
          (the poster) cannot see it; after submitting, the review is public.

    1. carol comments on a line, starting a draft
        stipulate can_read_pulls(carol, repo) = true
        stipulate count_suggestions("Off by one?") = 0
        stipulate blamed_commit(pr, "widgets.go", 12, proposed) = "f00d"
        stipulate diff_hunk_around(pr, "widgets.go", 12, proposed, 0) = "@@ -10,4 +10,4 @@"
        carol does UserAddsPendingCodeComment(carol, pr, "widgets.go", 12, proposed, 0, "Off by one?") on PullRequestPage
            creating draft: Review
        then UserStartsDraftReview fires
        then draft.status = pending

    2. ada cannot see the draft, carol can
        ada cannot see draft.body on DraftReviewPanel in draft
        carol sees draft.body on DraftReviewPanel in draft

    3. carol submits it requesting changes
        stipulate trimmed_length("Please fix the loop") = 19
        stipulate protection_for(repo, "main") = null
        stipulate can_write_code(carol, repo) = true
        carol does UserSubmitsDraftReview(carol, draft, request_changes, "Please fix the loop", "f00d") on DraftReviewPanel
        then UserSubmitsDraftReview fires
        then draft.status = submitted
        then draft.kind = request_changes
        then draft.is_official = true

    ends: Carol's review, with its line comment, is now part of the pull request.
}

-- Review requests: the poster may ask; a mere reader may not.
journey ReviewRequestsAreAskedAndAnswered {
    goal: Ada asks bob to review. Carol, who only reads the repository, may not
          ask anyone. Bob's review fulfils the request.

    1. ada requests bob's review
        stipulate is_organization(bob) = false
        stipulate can_read_pulls(bob, repo) = true
        stipulate has_submitted_review(pr, bob) = false
        stipulate protection_for(repo, "main") = null
        stipulate can_write_code(bob, repo) = true
        ada does UserRequestsReview(ada, pr, bob) on PullRequestAuthorControls
            creating request: ReviewRequest
        then request.reviewer = bob
        then request.is_official = true

    2. carol cannot ask for reviews
        stipulate is_organization(ada) = false
        stipulate can_read_pulls(root, repo) = true
        stipulate is_organization(root) = false
        stipulate is_repository_owner(carol, repo) = false
        stipulate is_collaborator(carol, repo) = false
        stipulate in_team_reading_pulls(carol, repo) = false
        stipulate can_read_pulls(carol, repo) = true
        carol cannot do UserRequestsReview(carol, pr, root) on PullRequestPage

    3. bob reviews and the request is fulfilled
        stipulate trimmed_length("Looks fine but see nit") = 22
        bob does UserSubmitsReview(bob, pr, comment, "Looks fine but see nit", "f00d") on PullRequestPage
        then ReviewVerdictSupersedesEarlierState fires
        then request does not exist

    ends: Bob reviewed; no review request is outstanding.
}

-- Updating the head from base makes earlier approvals stale and, when the
-- rule says so, dismisses them.
journey UpdatingTheBranchDismissesStaleApprovals {
    goal: main moved on. Bob updates ada's branch from main (maintainer
          edits are allowed); the diff changes, so carol's approval goes
          stale and, because main dismisses stale approvals, is dismissed.

    cast:
        rule: code/ProtectedBranch
        approval: Review
    given:
        rule.repository = repo
        rule.rule_name = "main"
        rule.merge_allowlist_enabled = false
        rule.approvals_allowlist_enabled = false
        rule.status_check_enabled = false
        rule.required_approvals = 1
        rule.dismiss_stale_approvals = true
        rule.ignore_stale_approvals = false
        rule.protected_file_patterns = []
        pr.commits_behind = 3
        pr.allow_maintainer_edit = true
        approval.pull_request = pr
        approval.reviewer = carol
        approval.status = submitted
        approval.kind = approve
        approval.body = "LGTM"
        approval.commit_sha = "f00d"
        approval.is_official = true
        approval.is_stale = false
        approval.is_dismissed = false

    1. bob updates the branch by merging main into it
        stipulate protection_for(repo, "main") = rule
        stipulate may_update_by_merge(bob, pr) = true
        stipulate within_quota(repo) = true
        stipulate updated_head(pr, merge) = "f11e"
        stipulate diff_differs(pr, "f00d", "f11e") = true
        stipulate is_force_push(repo, "f00d", "f11e") = false
        stipulate commits_ahead_of(repo, "feature", repo, "main") = 3
        stipulate commits_behind_of(repo, "feature", repo, "main") = 0
        stipulate commits_between_shas(repo, "f00d", "f11e") = "f11e"
        bob does UserUpdatesPullRequestBranch(bob, pr, merge) on PullRequestMergeBox
        then PullRequestHeadMoves fires
        then pr.head_commit_sha = "f11e"
        then pr.status = checking
        then approval.is_stale = true
        then approval.is_dismissed = true

    2. the update cannot be repeated while nothing is behind
        bob cannot do UserUpdatesPullRequestBranch(bob, pr, merge) on PullRequestMergeBox

    ends: The head moved; the old approval no longer counts.
}

-- Retargeting: the poster moves the pull request to another base branch.
journey PosterRetargetsThePullRequest {
    goal: Ada decides her change belongs on the release branch and changes
          the target; the pull request is re-checked against it. Carol, a
          reader who did not write it, may not retarget it.

    1. carol cannot retarget it
        stipulate can_write_pulls(carol, repo) = false
        carol cannot do UserChangesPullRequestTarget(carol, pr, "release") on PullRequestPage

    2. ada retargets it
        stipulate branch_exists(repo, "release") = true
        stipulate head_equals_branch(pr, "release") = false
        stipulate open_pull_request_exists(repo, "feature", repo, "release") = false
        stipulate commits_ahead_of(repo, "feature", repo, "release") = 4
        stipulate commits_behind_of(repo, "feature", repo, "release") = 1
        ada does UserChangesPullRequestTarget(ada, pr, "release") on PullRequestAuthorControls
        then pr.base_branch = "release"
        then pr.status = checking
        then pr.commits_behind = 1

    ends: The pull request now targets release and is being re-checked.
}

-- Reopening refuses to create a duplicate of an open pull request.
journey ReopeningRefusesDuplicates {
    goal: Ada closed her pull request and opened another one for the same
          branches. Reopening the first is refused.

    given:
        conv.status = closed

    1. reopening is refused while a duplicate is open
        stipulate open_pull_request_exists(repo, "feature", repo, "main") = true
        ada cannot do UserReopensPullRequest(ada, pr) on PullRequestAuthorControls

    ends: The pull request stays closed; the open duplicate carries on.
}

-- Reopening a closed pull request queues a fresh check.
journey PosterReopensAClosedPullRequest {
    goal: With no duplicate open and both branches still there, ada reopens
          her closed pull request; it goes back to being checked.

    given:
        conv.status = closed

    1. ada reopens it
        stipulate open_pull_request_exists(repo, "feature", repo, "main") = false
        stipulate branch_exists(repo, "main") = true
        stipulate branch_exists(repo, "feature") = true
        stipulate is_blocked_by_owner(repo, ada) = false
        stipulate head_commit_of(repo, "feature") = "f00d"
        ada does UserReopensPullRequest(ada, pr) on PullRequestAuthorControls
        then conv.status = open
        then pr.status = checking

    ends: The original pull request is open again and queued for a check.
}

-- Only repository admins dismiss reviews.
journey AdminDismissesARequestForChanges {
    goal: Carol requested changes and went on holiday. Bob, a writer, cannot
          dismiss her review; root, a repository admin, can, with a message.

    cast:
        objection: Review
    given:
        objection.pull_request = pr
        objection.reviewer = carol
        objection.status = submitted
        objection.kind = request_changes
        objection.body = "Needs tests"
        objection.commit_sha = "f00d"
        objection.is_official = true
        objection.is_stale = false
        objection.is_dismissed = false

    1. bob cannot dismiss it
        stipulate is_repo_admin(bob, repo) = false
        bob cannot do RepoAdminDismissesReview(bob, objection, "Carol is away") on ReviewModeration

    2. root dismisses it
        stipulate is_repo_admin(root, repo) = true
        root does RepoAdminDismissesReview(root, objection, "Carol is away") on ReviewModeration
        then objection.is_dismissed = true

    3. everyone sees it was dismissed
        stipulate can_read_pulls(ada, repo) = true
        ada sees objection.is_dismissed on PullRequestPage in pr

    ends: The request for changes no longer blocks the merge.
}
