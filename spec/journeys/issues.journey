-- Journeys through the issue tracker (spec/issues.allium).
--
-- Permission predicates (can_read_issue, can_triage, is_repo_admin, ...) are
-- black boxes standing in for `access`; each journey says which ones hold
-- for whom, in its stipulations, so the ledger shows who is allowed what.

world {
    cast:
        ada:  accounts/User
        tess: accounts/User
        repo: repositories/Repository
    given:
        repo.is_archived = false
        repo.owner_user = tess
        repo.owner_org = null
        ada.is_admin = false
        ada.is_active = true
        ada.prohibit_login = false
        tess.is_admin = false
        tess.is_active = true
        tess.prohibit_login = false
}

-- The happy path of opening an issue.
journey SomebodyReportsABug {
    goal: Ada can read a public repository's tracker but cannot manage it.
          She opens an issue describing a crash; it gets the next number in
          the repository, and anything she tried to set as metadata is not
          hers to set.

    1. she opens the issue
        stipulate can_read_tracker(ada, repo) = true
        stipulate can_manage_tracker(ada, repo) = false
        stipulate is_blocked_by_owner(repo, ada) = false
        stipulate trim("Crash on save") = "Crash on save"
        stipulate length("Crash on save") = 13
        stipulate next_issue_index(repo) = 7
        stipulate all_assignable({}, repo) = true
        stipulate resolve_mentions_in(repo, ada, "Steps: ...") = {}
        stipulate cross_references(repo, ada, "Crash on save", "Steps: ...") = {}
        ada does UserOpensIssue(ada, repo, "Crash on save", "Steps: ...", {}, null, {}, null, null, {}) on IssueTracker
            creating issue: Issue
            where issue_notification_audience(issue, ada) = {}
        then UserOpensIssue fires
        then issue.index = 7
        then issue.status = open
        then issue.poster = ada
        then issue.is_locked = false
        then issue.milestone = null

    2. and can read it back
        stipulate can_read_issue(ada, issue) = true
        ada sees issue.title on IssueConversation in issue
        ada sees issue.index on IssueConversation in issue

    ends: Issue #7 exists, open, with Ada as its poster and no metadata.
}

-- Commenting and reacting, and the reaction set being closed.
journey AConversationUnfolds {
    goal: Tess maintains the repository and asks Ada for logs on her issue.
          Ada answers with a heart on Tess's comment. A reaction outside the
          instance's configured set is refused.

    cast:
        bug: Issue

    given:
        bug.repository = repo
        bug.poster = ada
        bug.status = open
        bug.is_locked = false
        bug.is_pull = false

    1. tess asks for logs
        stipulate can_read_issue(tess, bug) = true
        stipulate is_blocked(ada, tess) = false
        stipulate is_blocked_by_owner(repo, tess) = false
        stipulate can_read_issue(ada, bug) = true
        stipulate issue_notification_audience(bug, tess) = {ada}
        stipulate resolve_mentions(bug, tess, "Can you share logs?") = {}
        stipulate cross_references(repo, tess, null, "Can you share logs?") = {}
        tess does UserComments(tess, bug, "Can you share logs?", {}) on IssueConversation
            creating c: Comment
        then UserComments fires
        then c.kind = comment
        then c.poster = tess
        then c.issue = bug

    2. ada reacts with a heart
        stipulate is_blocked(tess, ada) = false
        stipulate is_blocked(ada, ada) = false
        stipulate is_blocked_by_owner(repo, ada) = false
        stipulate can_triage(ada, bug) = false
        stipulate c.has_content = true
        stipulate is_allowed_reaction("heart") = true
        stipulate is_allowed_reaction("party_parrot") = false
        ada does UserReactsToComment(ada, bug, c, "heart") on IssueConversation
            creating r: Reaction
        then r.emoji = "heart"
        then r.user = ada
        then r.comment = c

    3. but not with an emoji the instance does not offer
        ada cannot do UserReactsToComment(ada, bug, c, "party_parrot") on IssueConversation

    ends: The issue has one comment from Tess carrying Ada's heart.
}

-- Blocked users are kept out of the tracker.
journey ABlockedUserIsKeptOut {
    goal: Mallory has been blocked by the repository's owner, and separately
          by Ada. He can still read the public tracker, but he cannot open
          issues there, and he cannot comment on Ada's issue.

    cast:
        mallory: accounts/User
        bug:     Issue

    given:
        mallory.is_admin = false
        bug.repository = repo
        bug.is_pull = false
        bug.poster = ada
        bug.status = open
        bug.is_locked = false

    1. he cannot open an issue in a repository whose owner blocked him
        stipulate can_read_tracker(mallory, repo) = true
        stipulate is_blocked_by_owner(repo, mallory) = true
        mallory cannot do UserOpensIssue(mallory, repo, "spam", "spam", {}, null, {}, null, null, {}) on IssueTracker

    2. nor comment on the issue of a poster who blocked him
        stipulate can_read_issue(mallory, bug) = true
        stipulate is_blocked(ada, mallory) = true
        mallory cannot do UserComments(mallory, bug, "hello", {}) on IssueConversation

    3. nor react to it
        stipulate can_triage(mallory, bug) = false
        stipulate is_allowed_reaction("-1") = true
        mallory cannot do UserReactsToIssue(mallory, bug, "-1") on IssueConversation

    ends: Nothing Mallory tried left a trace on the tracker.
}

-- Locking a heated conversation.
journey LockingAHeatedConversation {
    goal: A discussion has turned sour. Tess locks it as "Too heated"; from
          that moment Ada, who cannot write to the tracker, cannot comment,
          while Tess still can. Inventing a lock reason is refused.

    cast:
        bug: Issue

    given:
        bug.repository = repo
        bug.is_pull = false
        bug.poster = ada
        bug.status = open
        bug.is_locked = false

    1. an invented reason is refused
        stipulate is_lock_reason("Because I said so") = false
        stipulate is_lock_reason("Too heated") = true
        stipulate can_triage(tess, bug) = true
        tess cannot do TriagerLocksIssue(tess, bug, "Because I said so") on IssueTriage

    2. tess locks it as too heated
        tess does TriagerLocksIssue(tess, bug, "Too heated") on IssueTriage
            creating note: Comment
        then bug.is_locked = true
        then note.kind = lock
        then note.content = "Too heated"

    3. ada can no longer comment
        stipulate can_read_issue(ada, bug) = true
        stipulate can_triage(ada, bug) = false
        stipulate is_blocked(ada, ada) = false
        stipulate is_blocked_by_owner(repo, ada) = false
        ada cannot do UserComments(ada, bug, "but...", {}) on IssueConversation

    4. tess still can
        stipulate can_read_issue(tess, bug) = true
        stipulate is_blocked(ada, tess) = false
        stipulate is_blocked_by_owner(repo, tess) = false
        stipulate issue_notification_audience(bug, tess) = {ada}
        stipulate resolve_mentions(bug, tess, "Locked until tempers cool.") = {}
        stipulate cross_references(repo, tess, null, "Locked until tempers cool.") = {}
        tess does UserComments(tess, bug, "Locked until tempers cool.", {}) on IssueTriage
            creating reply: Comment
        then reply.poster = tess

    5. and unlocks it later
        tess does TriagerUnlocksIssue(tess, bug) on IssueTriage
        then bug.is_locked = false

    ends: The lock and the unlock are both on the timeline.
}

-- Dependencies block closing.
journey ABlockedIssueWaitsForItsBlocker {
    goal: The crash fix depends on a refactoring tracked in another issue.
          Tess records the dependency; while the refactoring is open the
          crash issue cannot be closed, and once it is closed, it can.

    cast:
        bug:      Issue
        refactor: Issue

    given:
        bug.repository = repo
        bug.poster = ada
        bug.status = open
        bug.is_locked = false
        bug.is_pull = false
        refactor.repository = repo
        refactor.poster = tess
        refactor.status = open
        refactor.is_pull = false

    1. tess records that the bug is blocked by the refactoring
        stipulate dependencies_enabled(repo) = true
        stipulate can_triage(tess, bug) = true
        stipulate can_read_issue(tess, refactor) = true
        tess does TriagerAddsDependency(tess, bug, refactor) on IssueTriage
            creating dep: IssueDependency
        then dep.issue = bug
        then dep.blocker = refactor

    2. closing the bug is refused while the blocker is open
        stipulate can_read_issue(tess, bug) = true
        stipulate is_blocked(ada, tess) = false
        stipulate is_blocked_by_owner(repo, tess) = false
        stipulate bug.has_open_blockers = true
        tess cannot do UserClosesIssue(tess, bug) on IssueTriage

    3. the refactoring is closed
        stipulate can_read_issue(tess, refactor) = true
        stipulate can_triage(tess, refactor) = true
        stipulate is_blocked(tess, tess) = false
        stipulate refactor.has_open_blockers = false
        stipulate issue_notification_audience(refactor, tess) = {}
        tess does UserClosesIssue(tess, refactor) on IssueTriage
        then refactor.status = closed

    4. and now the bug can be closed
        stipulate bug.has_open_blockers = false
        stipulate can_read_issue(ada, bug) = true
        stipulate issue_notification_audience(bug, tess) = {ada}
        tess does UserClosesIssue(tess, bug) on IssueTriage
        then bug.status = closed
        then UserClosesIssue fires

    ends: Both issues are closed, the dependency recorded on both timelines.
}

-- Pinning, limited per repository and reserved to admins.
journey PinningHasALimit {
    goal: Three issues are already pinned in a repository whose instance
          allows three. Tess, an admin, cannot pin a fourth until she unpins
          one. Ada, who is not an admin, cannot pin at all.

    cast:
        a:      Issue
        b:      Issue
        c:      Issue
        fourth: Issue

    given:
        a.repository = repo
        b.repository = repo
        c.repository = repo
        fourth.repository = repo
        a.is_pull = false
        b.is_pull = false
        c.is_pull = false
        fourth.is_pull = false
        pa: IssuePin { repository: repo, issue: a, is_pull: false, position: 1 }
        pb: IssuePin { repository: repo, issue: b, is_pull: false, position: 2 }
        pc: IssuePin { repository: repo, issue: c, is_pull: false, position: 3 }

    1. ada is not an admin
        stipulate is_repo_admin(ada, repo) = false
        ada cannot do RepoAdminPinsIssue(ada, fourth) on IssueAdministration

    2. a fourth pin is over the limit
        stipulate is_repo_admin(tess, repo) = true
        tess cannot do RepoAdminPinsIssue(tess, fourth) on IssueAdministration

    3. she unpins the first, and the others move up
        tess does RepoAdminUnpinsIssue(tess, a) on IssueAdministration
        then ClosePinGap fires
        then pb.position = 1
        then pc.position = 2
        then pa does not exist

    4. now the fourth can be pinned, at the end
        tess does RepoAdminPinsIssue(tess, fourth) on IssueAdministration
            creating pin: IssuePin
        then pin.position = 3

    ends: Three issues are pinned, in order b, c, fourth.
}

-- Exclusive scoped labels.
journey OnlyOnePriorityAtATime {
    goal: The repository uses exclusive `priority/*` labels. Tess raises a
          bug from priority/low to priority/high by adding the new label; the
          old one leaves on its own.

    cast:
        bug:  Issue
        low:  Label
        high: Label

    given:
        bug.repository = repo
        bug.is_pull = false
        low.repository = repo
        high.repository = repo
        low.name = "priority/low"
        high.name = "priority/high"
        low.is_exclusive = true
        high.is_exclusive = true

    1. tess adds priority/high
        stipulate bug.labels = {low}
        stipulate can_triage(tess, bug) = true
        stipulate low.scope = "priority"
        stipulate high.scope = "priority"
        tess does TriagerAddsLabel(tess, bug, high) on IssueTriage
        then TriagerAddsLabel fires
        then high in bug.labels
        then bug.labels = {high}

    ends: The bug carries priority/high only.
}

-- Milestones: create, assign, close.
journey AReleaseMilestone {
    goal: Tess plans the 1.0 release: she creates a milestone, puts the bug
          in it, and closes the milestone when the release ships. Ada, who
          cannot manage the tracker, cannot create milestones.

    cast:
        bug: Issue

    given:
        bug.repository = repo
        bug.is_pull = false
        bug.milestone = null
        bug.status = open

    1. ada cannot create milestones
        stipulate can_manage_tracker(ada, repo) = false
        ada cannot do TrackerManagerCreatesMilestone(ada, repo, "1.0", "", null) on TrackerSettings

    2. tess creates the milestone
        stipulate can_manage_tracker(tess, repo) = true
        stipulate trim("1.0") = "1.0"
        stipulate length("1.0") = 3
        tess does TrackerManagerCreatesMilestone(tess, repo, "1.0", "First stable", null) on TrackerSettings
            creating one: Milestone
        then one.status = open
        then one.name = "1.0"

    3. puts the bug in it
        stipulate can_triage(tess, bug) = true
        tess does TriagerSetsMilestone(tess, bug, one) on IssueTriage
            creating note: Comment
        then bug.milestone = one
        then note.kind = milestone
        then note.new_milestone = one

    4. and closes it when 1.0 ships
        tess does TrackerManagerClosesMilestone(tess, repo, one) on TrackerSettings
        then one.status = closed

    ends: Milestone 1.0 is closed and the bug belongs to it.
}

-- Time tracking: a stopwatch over two hours.
journey TrackingTimeOnAnIssue {
    goal: Ada, the issue's poster, may track time on it. She starts the
          stopwatch, works for two hours, and stops it; the two hours are
          recorded as her tracked time and the stopwatch is gone. Tess's
          tracked time on the same issue is not shown to her.

    cast:
        bug:  Issue
        tess_time: TrackedTime

    given:
        bug.repository = repo
        bug.is_pull = false
        bug.poster = ada
        bug.status = open
        tess_time.issue = bug
        tess_time.user = tess
        tess_time.amount = 30.minutes
        tess_time.is_deleted = false

    1. she starts the stopwatch
        stipulate can_read_issue(ada, bug) = true
        stipulate may_track_time(ada, bug) = true
        ada does UserStartsStopwatch(ada, bug) on IssueConversation
            creating sw: Stopwatch
        then sw.user = ada
        then sw.issue = bug

    2. two hours pass
        after 2.hours

    3. she stops it
        ada does UserStopsStopwatch(ada, bug, sw) on IssueConversation
            creating spent: TrackedTime
        then FinishStopwatch fires
        then spent.amount = 2.hours
        then spent.user = ada
        then sw does not exist

    4. she sees her own time but not tess's
        stipulate can_read_issue(ada, bug) = true
        ada sees spent.amount on IssueConversation in bug
        ada cannot see tess_time.amount on IssueConversation in bug

    ends: Ada has two hours on the issue; no stopwatch is running.
}

-- Body edits are optimistic and keep history.
journey EditingKeepsHistory {
    goal: Ada fixes a typo in her issue's description. Her edit records the
          original text and the new one in the history. A second edit made
          from a stale copy of the page is refused rather than silently
          overwriting.

    cast:
        bug: Issue

    given:
        bug.repository = repo
        bug.is_pull = false
        bug.poster = ada
        bug.title = "Crash on save"
        bug.content = "Stpes: open then save"
        bug.content_version = 0

    1. she fixes the typo
        stipulate can_read_issue(ada, bug) = true
        stipulate can_triage(ada, bug) = false
        stipulate cross_references(repo, ada, "Crash on save", "Steps: open then save") = {}
        stipulate resolve_mentions(bug, ada, "Steps: open then save") = {}
        stipulate original_author(bug, null) = ada
        ada does UserEditsIssueBody(ada, bug, "Steps: open then save", 0) on IssueConversation
        then bug.content = "Steps: open then save"
        then bug.content_version = 1
        then RecordContentRevision fires

    2. an edit from a stale page is refused
        ada cannot do UserEditsIssueBody(ada, bug, "Steps: open", 0) on IssueConversation

    ends: The description reads correctly and its history holds both versions.
}

-- Attachments: type allow-list.
journey AttachingALog {
    goal: Ada attaches a log file to her report; an executable is refused by
          the instance's allowed types.

    1. a log file is accepted
        stipulate can_read_tracker(ada, repo) = true
        stipulate is_allowed_file("crash.log", "...") = true
        ada does UserUploadsAttachment(ada, repo, "crash.log", 2048, "...") on IssueTracker
            creating log: Attachment
        then log.uploader = ada
        then log.issue = null

    2. an executable is not
        stipulate is_allowed_file("tool.exe", "MZ") = false
        ada cannot do UserUploadsAttachment(ada, repo, "tool.exe", 4096, "MZ") on IssueTracker

    ends: One unlinked upload exists, visible only to Ada until she posts it.
}

-- Deleting an issue is for repository admins.
journey OnlyAdminsDeleteIssues {
    goal: A spam issue was opened. Tess can triage but is not a repository
          admin, so she cannot delete it; the repository admin can.

    cast:
        owner: accounts/User
        spam:  Issue

    given:
        owner.is_admin = false
        spam.repository = repo
        spam.is_pull = false
        spam.poster = ada
        spam.status = open

    1. tess cannot delete
        stipulate is_repo_admin(tess, repo) = false
        tess cannot do RepoAdminDeletesIssue(tess, spam) on IssueAdministration

    2. the admin deletes it
        stipulate is_repo_admin(owner, repo) = true
        owner does RepoAdminDeletesIssue(owner, spam) on IssueAdministration
        then spam does not exist

    ends: The spam issue and its timeline are gone.
}
