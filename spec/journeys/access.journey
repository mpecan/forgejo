-- access.journey — who may see and do what on repositories, organizations
-- and profiles, walked through the access module's boundaries.
--
-- Fields of entities owned by other modules (accounts/User,
-- repositories/Repository, repositories/RepoUnit, organizations/*) are set in
-- `given` because the grant rules read them; every field a competing grant
-- rule reads is set, so a refusal is a refusal and not an unknown.

-- The common ground: one public user-owned repository, its code unit, its
-- owner, and a stranger.
world {
    cast:
        olga:     SignedInUser
        sam:      SignedInUser
        repo:     repositories/Repository
        code:     repositories/RepoUnit
        visitor:  AnonymousVisitor
        internals: ForgeInternals

    given:
        olga.is_admin = false
        olga.is_restricted = false
        olga.visibility = public
        sam.is_admin = false
        sam.is_restricted = false
        sam.visibility = public
        repo.owner_user = olga
        repo.owner_org = null
        repo.is_private = false
        repo.is_archived = false
        repo.is_mirror = false
        repo.is_empty = false
        code.repository = repo
        code.kind = code
        code.enabled = true
        code.everyone_can_write = false
        code.is_external = false
        visitor.channel = web
        internals.name = "repositories"
}

journey AnonymousVisitorReadsAPublicRepository {
    goal: Somebody with no account opens a public repository of a public user
          and reads its code; nothing more is asked of them.

    1. the visitor reads the code
        visitor does AnonymousReadsUnit(visitor, code) on AnonymousRepositoryAccess
            creating decision: AccessDecision
        then ReadUnitAnonymously fires
        then decision.basis = anonymous_public

    2. and can see the repository exists
        visitor sees repo.name on AnonymousRepositoryAccess in code

    ends: Public code of a public owner is readable without signing in.
}

journey PrivateRepositoriesDoNotExistForStrangers {
    goal: Olga makes her repository private. An anonymous visitor and Sam, a
          signed-in stranger, both find nothing there; Olga still reads it.

    given:
        repo.is_private = true

    1. the anonymous visitor is refused and is not told the repository exists
        visitor cannot do AnonymousReadsUnit(visitor, code) on AnonymousRepositoryAccess
        visitor cannot see repo.name on AnonymousRepositoryAccess in code

    2. Sam, signed in but with no grant, is refused too
        sam cannot do UserReadsUnit(sam, code) on RepositoryUnitAccess

    3. Olga owns it and reads it
        olga does UserReadsUnit(olga, code) on RepositoryUnitAccess
            creating decision: AccessDecision
        then ReadUnitAsRepositoryOwner fires
        then decision.basis = repository_owner

    ends: A private repository is visible to its owner and to nobody without
          a grant; to everyone else it does not exist.
}

journey PrivateProfilesAreSeenOnlyByThoseTheyKnow {
    goal: Pia keeps her profile private. A stranger cannot see it; somebody
          she follows can; an anonymous visitor cannot.

    cast:
        pia: accounts/User

    given:
        pia.is_admin = false
        pia.is_restricted = false
        pia.visibility = private
        follow: accounts/Follow { follower: pia, followee: olga }

    1. Sam, a stranger, is refused
        stipulate shares_organization(pia, sam) = false
        sam cannot do UserViewsProfile(sam, pia) on ProfileAccess
        sam cannot see pia.name on VisibleProfile in pia

    2. the anonymous visitor is refused
        visitor cannot do AnonymousViewsProfile(visitor, pia) on AnonymousProfileAccess

    3. Olga, whom Pia follows, sees her
        olga does UserViewsProfile(olga, pia) on ProfileAccess
            creating decision: AccessDecision
        then ViewPrivateProfileByRelationship fires
        then decision.basis = profile_visible
        olga sees pia.name on VisibleProfile in pia

    4. and everyone always sees themselves
        olga does UserViewsProfile(olga, olga) on ProfileAccess
        then ViewOwnProfileOrAsSiteAdmin fires

    ends: Private means "people I have a relationship with".
}

journey ACollaboratorGainsWriteWhenTheIndexIsRecalculated {
    goal: Sam can read Olga's public repository but not push to it. Olga adds
          him as a write collaborator; the explicit-access index is
          recalculated and from then on he can write.

    1. before the grant Sam reads but cannot write
        sam does UserReadsUnit(sam, code) on RepositoryUnitAccess
        sam cannot do UserWritesUnit(sam, code, true) on RepositoryUnitAccess

    2. the collaboration is recorded and the index recalculated for Sam
        stipulate explicit_mode(sam, repo) = write
        stipulate has_any_access(sam, repo) = true
        internals does RecalculateUserRepositoryAccess(repo, sam) on AccessIndexMaintenance
            creating grant: RepoAccess
        then RecalculateOneUsersAccess fires
        then AnnounceLostAccess does not fire
        then grant.mode = write

    3. now Sam pushes
        sam does UserWritesUnit(sam, code, true) on RepositoryUnitAccess
            creating decision: AccessDecision
        then WriteUnitByExplicitGrant fires
        then decision.basis = explicit_grant

    4. but a write collaborator is not a repository administrator
        sam cannot do UserAdministersRepository(sam, repo) on RepositoryAdministration

    ends: Write comes from an explicit grant; administration needs more.
}

journey RemovingTheLastGrantTakesAccessAway {
    goal: Sam was a write collaborator on Olga's private repository. Olga
          removes him; the index drops his row and the rest of the forge is
          told he lost access.

    given:
        repo.is_private = true
        grant: RepoAccess { user: sam, repository: repo, mode: write }

    1. while the grant stands Sam writes
        sam does UserWritesUnit(sam, code, true) on RepositoryUnitAccess

    2. the collaboration is removed and the index recalculated
        stipulate explicit_mode(sam, repo) = none
        stipulate has_any_access(sam, repo) = false
        internals does RecalculateUserRepositoryAccess(repo, sam) on AccessIndexMaintenance
        then RecalculateOneUsersAccess fires
        then AnnounceLostAccess fires
        then grant does not exist

    3. and Sam can no longer even read
        sam cannot do UserReadsUnit(sam, code) on RepositoryUnitAccess

    ends: Losing the last grant on a private repository makes it vanish for
          the user, and watches/assignments are cleaned up by their owners.
}

journey ArchivedRepositoriesAreReadOnly {
    goal: Olga archives her repository. She can still read it and still
          administer it (she may unarchive), but nobody - not even she - can
          change its content.

    given:
        repo.is_archived = true

    1. reading still works
        olga does UserReadsUnit(olga, code) on RepositoryUnitAccess

    2. pushing does not
        olga cannot do UserWritesUnit(olga, code, true) on RepositoryUnitAccess

    3. Sam cannot open a pull request or comment either
        sam cannot do UserContributesToRepository(sam, code) on RepositoryUnitAccess

    4. administration (e.g. unarchiving) is still allowed
        olga does UserAdministersRepository(olga, repo) on RepositoryAdministration
            creating decision: AccessDecision
        then AdministerRepositoryAsOwner fires

    ends: Archived means read-only for content, not frozen for its owner.
}

journey AMirrorsCodeCannotBePushedButCanBeSynced {
    goal: Olga's repository is a pull mirror. She cannot push to it, but she
          can trigger a sync, which needs write on code without changing it
          by hand.

    given:
        repo.is_mirror = true

    1. a push is refused
        olga cannot do UserWritesUnit(olga, code, true) on RepositoryUnitAccess

    2. "sync now" is a write that does not change git content by hand
        olga does UserWritesUnit(olga, code, false) on RepositoryUnitAccess
            creating decision: AccessDecision
        then WriteUnitAsRepositoryOwner fires

    ends: A mirror's code follows its upstream only.
}

journey RestrictedUsersSeeOnlyWhatTheyAreGiven {
    goal: Rita is a restricted user. A public repository is invisible to her
          until she is given an explicit grant on it.

    cast:
        rita: RestrictedUser

    given:
        rita.is_admin = false
        rita.is_restricted = true

    1. a public repository is still closed to her, and hidden from her
        rita cannot do UserReadsUnit(rita, code) on RepositoryUnitAccess
        rita cannot see repo.name on VisibleRepository in repo

    2. she is added as a read collaborator
        stipulate explicit_mode(rita, repo) = read
        stipulate has_any_access(rita, repo) = true
        internals does RecalculateUserRepositoryAccess(repo, rita) on AccessIndexMaintenance
            creating grant: RepoAccess

    3. and now reads it, through the grant and nothing else
        rita does UserReadsUnit(rita, code) on RepositoryUnitAccess
            creating decision: AccessDecision
        then ReadUnitByExplicitGrant fires
        then ReadUnitByPublicDefault does not fire
        then decision.basis = explicit_grant
        rita sees repo.name on VisibleRepository in repo

    ends: For a restricted user, "public" means nothing; grants mean
          everything.
}

journey PrivateOrganizationsAreVisibleOnlyToMembers {
    goal: A private organization owns a public repository. Sam, who is not a
          member, can see neither the organization nor the repository; Mia,
          a member, can see both.

    cast:
        mia:   SignedInUser
        org:   organizations/Organization
        orepo: repositories/Repository
        ocode: repositories/RepoUnit

    given:
        mia.is_admin = false
        mia.is_restricted = false
        org.visibility = private
        orepo.owner_user = null
        orepo.owner_org = org
        orepo.is_private = false
        orepo.is_archived = false
        ocode.repository = orepo
        ocode.kind = code
        ocode.enabled = true
        ocode.is_external = false
        membership: organizations/OrgMembership { organization: org, user: mia, is_public: false }

    1. Sam cannot see the organization
        sam cannot do UserViewsOrganization(sam, org) on OrganizationAccess
        sam cannot see org.name on VisibleOrganization in org

    2. nor read its public repository
        sam cannot do UserReadsUnit(sam, ocode) on RepositoryUnitAccess

    3. Mia, a member, sees the organization
        mia does UserViewsOrganization(mia, org) on OrganizationAccess
            creating decision: AccessDecision
        then ViewOrganizationAsMember fires
        mia sees org.name on VisibleOrganization in org

    4. and reads its public repository
        mia does UserReadsUnit(mia, ocode) on RepositoryUnitAccess
        then ReadUnitByPublicDefault fires

    ends: Owner visibility gates everything the owner has, even public
          repositories.
}

journey LimitedOrganizationsNeedASignedInViewer {
    goal: A limited organization is visible to any signed-in user but not to
          anonymous visitors.

    cast:
        org: organizations/Organization

    given:
        org.visibility = limited

    1. the anonymous visitor is refused
        visitor cannot do AnonymousViewsOrganization(visitor, org) on AnonymousOrganizationAccess
        visitor cannot see org.name on AnonymousOrganizationAccess in org

    2. Sam, signed in, sees it
        sam does UserViewsOrganization(sam, org) on OrganizationAccess
            creating decision: AccessDecision
        then ViewOrganizationByVisibility fires
        then decision.basis = organization_visible
        sam sees org.name on VisibleOrganization in org

    ends: Limited is "members of this instance only".
}

journey TeamUnitAccessDecidesPerUnit {
    goal: Tom is in a team of an organization that grants write on issues but
          only read on code for a private repository. He can triage issues
          and read code, but cannot push.

    cast:
        tom:    SignedInUser
        org:    organizations/Organization
        orepo:  repositories/Repository
        ocode:  repositories/RepoUnit
        tracker: repositories/RepoUnit

    given:
        tom.is_admin = false
        tom.is_restricted = false
        org.visibility = public
        orepo.owner_user = null
        orepo.owner_org = org
        orepo.is_private = true
        orepo.is_archived = false
        orepo.is_mirror = false
        orepo.is_empty = false
        ocode.repository = orepo
        ocode.kind = code
        ocode.enabled = true
        ocode.is_external = false
        ocode.everyone_can_write = false
        tracker.repository = orepo
        tracker.kind = issues
        tracker.enabled = true
        tracker.is_external = false
        tracker.everyone_can_write = false
        grant: RepoAccess { user: tom, repository: orepo, mode: write }

    1. the team grants write on issues and read on code
        stipulate explicit_unit_mode(tom, orepo, issues) = write
        stipulate explicit_unit_mode(tom, orepo, code) = read

    2. Tom triages issues
        tom does UserWritesUnit(tom, tracker, false) on RepositoryUnitAccess
            creating decision: AccessDecision
        then WriteUnitByExplicitGrant fires

    3. reads code
        tom does UserReadsUnit(tom, ocode) on RepositoryUnitAccess

    4. but cannot push
        tom cannot do UserWritesUnit(tom, ocode, true) on RepositoryUnitAccess

    ends: On organization repositories a team's unit access, not its overall
          mode, decides each unit.
}

journey AdminTeamsAdministerButOnlyOwnersDelete {
    goal: Ada is in an admin team, Otto in the owner team of the organization
          owning a repository. Both administer it; only Otto may delete or
          transfer it.

    cast:
        ada:   SignedInUser
        otto:  SignedInUser
        org:   organizations/Organization
        orepo: repositories/Repository

    given:
        ada.is_admin = false
        otto.is_admin = false
        orepo.owner_user = null
        orepo.owner_org = org
        adagrant: RepoAccess { user: ada, repository: orepo, mode: admin }
        ottogrant: RepoAccess { user: otto, repository: orepo, mode: owner }

    1. Ada administers the repository
        ada does UserAdministersRepository(ada, orepo) on RepositoryAdministration
        then AdministerRepositoryByExplicitGrant fires

    2. but cannot delete it
        ada cannot do UserPerformsOwnerAction(ada, orepo) on RepositoryAdministration

    3. Otto, in the owner team, can
        otto does UserPerformsOwnerAction(otto, orepo) on RepositoryAdministration
            creating decision: AccessDecision
        then OwnRepositoryAsOwnerTeamMember fires

    ends: Admin is everything but the irreversible ownership actions.
}

journey AFineGrainedTokenNarrowsEvenAnAdministrator {
    goal: Ash is a site administrator using a token restricted to public
          repositories. Through it he can read public code but cannot touch a
          private repository nor use administrator powers.

    cast:
        ash:   SiteAdministrator
        token: CredentialRestriction
        prepo: repositories/Repository
        pcode: repositories/RepoUnit

    given:
        ash.is_admin = true
        ash.is_restricted = false
        token.reach = public_only
        prepo.owner_user = olga
        prepo.owner_org = null
        prepo.is_private = true
        prepo.is_archived = false
        prepo.is_mirror = false
        pcode.repository = prepo
        pcode.kind = code
        pcode.enabled = true
        pcode.is_external = false
        pcode.everyone_can_write = false

    1. he reads public code through the token
        ash does UserReadsUnit(ash, code, token) on RepositoryUnitAccess

    2. a private repository is out of the token's reach
        ash cannot do UserWritesUnit(ash, pcode, true, token) on RepositoryUnitAccess

    3. and the token confers no administrator override
        ash cannot do UserActsAsSiteAdmin(ash, token) on SiteAdministration

    4. without the token he is an administrator again
        ash does UserActsAsSiteAdmin(ash) on SiteAdministration
            creating decision: AccessDecision
        then ActAsSiteAdmin fires

    ends: A credential restriction only ever narrows.
}

journey BlockedUsersCannotContribute {
    goal: Olga has blocked Sam. He can still read her public repository, but
          cannot open issues, comment or react there.

    given:
        block: accounts/UserBlock { blocker: olga, blocked: sam }

    1. Olga's block is in place
        then block exists

    2. Sam still reads
        sam does UserReadsUnit(sam, code) on RepositoryUnitAccess

    3. but cannot contribute
        sam cannot do UserContributesToRepository(sam, code) on RepositoryUnitAccess

    ends: Blocking stops participation, not reading public content.
}

journey AForkPullRequestRunIsReadOnly {
    goal: A workflow run triggered by a pull request from a fork reads the
          repository it runs in but cannot write to it; a normal run can.

    cast:
        forkrun:   RunningTask
        normalrun: RunningTask
        run:       actions/WorkflowRun
        job:       actions/Job

    given:
        run.repository = repo
        job.run = run
        forkrun.job = job
        forkrun.status = running
        forkrun.is_fork_pull_request = true
        normalrun.job = job
        normalrun.status = running
        normalrun.is_fork_pull_request = false

    1. the fork run reads
        forkrun does ActionsTaskAccessesRepository(forkrun, code, read) on ActionsTaskAccess

    2. but cannot write
        forkrun cannot do ActionsTaskAccessesRepository(forkrun, code, write) on ActionsTaskAccess

    3. the normal run writes
        normalrun does ActionsTaskAccessesRepository(normalrun, code, write) on ActionsTaskAccess
            creating decision: AccessDecision
        then TaskAccessesOwnRepository fires
        then decision.basis = own_task

    ends: Untrusted code from forks never gets write.
}
