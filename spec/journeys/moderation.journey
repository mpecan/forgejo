-- Journeys through abuse reporting and moderation.
--
-- Moderation is off by default ([moderation] ENABLED); these journeys run on an
-- instance that turned it on, except those that show what off means.

world {
    cast:
        ada:     accounts/User
        bruno:   accounts/User
        root:    accounts/User
        author:  accounts/User
        thread:  issues/Issue
        remark:  issues/Comment
        item:    ReportableContent
    given:
        moderation/config.enabled = true
        -- None of these stories is about CI: Actions is off on this instance,
        -- so deleting reported content starts no workflow.
        actions/config.actions_enabled = false
        ada.prohibit_login = false
        ada.is_active = true
        ada.is_admin = false
        bruno.prohibit_login = false
        bruno.is_active = true
        bruno.is_admin = false
        root.is_admin = true
        root.is_active = true
        root.prohibit_login = false
        remark.issue = thread
        remark.ref_comment = null
        thread.is_pull = false
        item.kind = comment
        item.reported_comment = remark
        item.reported_user = null
        item.reported_organization = null
        item.reported_repository = null
        item.reported_issue = null
        item.is_deleted = false
        item.has_user_content = true
        item.poster = author
}

journey AUserReportsAnAbusiveComment {
    goal: Ada sees a spam comment on an issue she can read and reports it. The
          report enters the moderation queue as open.

    1. Ada can read the conversation and has not reported it yet
        stipulate can_read_conversation(ada, thread) = true
        stipulate remarks_length("This comment links to a phishing site twice.") = 45

    2. she files the report
        ada does UserReportsContent(ada, item, spam, "This comment links to a phishing site twice.") on ReportAbuse
            creating report: AbuseReport
        then UserReportsContent fires
        then report.status = open
        then report.category = spam
        then report.reporter = ada

    ends: One open report from Ada sits in the queue for the comment.
}

journey NobodyReportsWhatTheyCannotSee {
    goal: Bruno cannot read the issue the comment sits in (a private
          repository he has no access to) so he cannot report it.

    1. he tries to report the comment
        stipulate can_read_conversation(bruno, thread) = false
        stipulate remarks_length("This comment links to a phishing site twice.") = 45
        bruno cannot do UserReportsContent(bruno, item, spam, "This comment links to a phishing site twice.") on ReportAbuse

    ends: Reporting never reveals or touches content the reporter cannot see.
}

journey NobodyReportsTheirOwnProfile {
    goal: Ada tries to report her own profile and is refused.

    given:
        item.kind = user
        item.reported_user = ada

    1. she reports herself
        stipulate profile_visible_to(ada, ada) = true
        stipulate remarks_length("I would like to see what happens here.") = 38
        ada cannot do UserReportsContent(ada, item, other_violations, "I would like to see what happens here.") on ReportAbuse

    ends: Self-reports never enter the queue.
}

journey AReportCannotBeFiledTwice {
    goal: Having already reported the comment, Ada cannot pile on a second open
          report of her own.

    1. she reports the comment
        stipulate can_read_conversation(ada, thread) = true
        stipulate remarks_length("This comment links to a phishing site twice.") = 45
        ada does UserReportsContent(ada, item, spam, "This comment links to a phishing site twice.") on ReportAbuse
            creating first: AbuseReport
        then first.status = open

    2. she tries again
        ada cannot do UserReportsContent(ada, item, spam, "This comment links to a phishing site twice.") on ReportAbuse

    ends: Still exactly one open report from Ada.
}

journey ReportersDoNotSeeOtherReports {
    goal: Bruno opens the report form for the same comment; he can see whether
          he himself already reported it, never what Ada wrote.

    after: AUserReportsAnAbusiveComment

    1. bruno looks at the item
        bruno sees item.kind on ReportAbuse in item
        bruno cannot see report.remarks on ReportAbuse in item

    ends: Reports stay between the reporter and the admins.
}

journey EvidenceSurvivesTheEdit {
    goal: The comment's author quietly rewrites it after being reported. The
          original text is captured before the edit, linked to Ada's report,
          and shown to the admin reviewing it.

    after: AUserReportsAnAbusiveComment

    1. the author edits the reported comment
        bruno does ReportableContentChanging(item, update) on ReportedContentLifecycle
        then PreserveEvidenceBeforeChange fires
        then ReportedContentDeleted does not fire

    2. the admin reviews the queue
        root sees report.remarks on ModerationQueue in item

    ends: The admin judges the comment as it was when reported.
}

journey DeletionLeavesATombstone {
    goal: The author deletes the reported comment. Reports and evidence remain,
          keyed to the deleted item.

    after: AUserReportsAnAbusiveComment

    1. the author deletes it
        bruno does ReportableContentChanging(item, deletion) on ReportedContentLifecycle
        then PreserveEvidenceBeforeChange fires
        then ReportedContentDeleted fires
        then item.is_deleted = true

    ends: The comment is gone; the queue still lists it with its evidence.
}

journey AnAdminDismissesTheReport {
    goal: The admin decides the comment is fine and marks every open report on
          it as ignored, without touching the comment.

    after: AUserReportsAnAbusiveComment

    1. she ignores the reports
        root does AdminResolvesReports(root, item, ignored) on ModerationQueue
        then AdminResolvesReports fires
        then CloseReportAsIgnored fires
        then report.status = ignored

    ends: The item leaves the queue; the comment is untouched.
}

journey AnAdminDeletesTheCommentAndClosesTheReport {
    goal: The admin deletes the spam comment and marks the report handled in
          one action.

    after: AUserReportsAnAbusiveComment

    1. she deletes the comment
        root does AdminDeletesReportedComment(root, item, handled) on ModerationQueue
        then AdminDeletesReportedComment fires
        then CloseReportAsHandled fires
        then report.status = handled

    ends: Deletion is requested from the issues module; the report is handled.
}

journey OnlyAdminsModerate {
    goal: Bruno, an ordinary user, cannot resolve reports.

    after: AUserReportsAnAbusiveComment

    1. bruno tries to close the report
        bruno cannot do AdminResolvesReports(bruno, item, handled) on ModerationQueue

    ends: Nothing changes.
}

journey AdminsCannotSuspendAdmins {
    goal: A report against another site admin cannot be acted on by
          suspending that admin.

    cast:
        boss:    accounts/User
        profile: ReportableContent

    given:
        boss.is_admin = true
        boss.prohibit_login = false
        profile.kind = user
        profile.reported_user = boss
        profile.is_deleted = false

    1. the admin tries to suspend
        root cannot do AdminSuspendsReportedAccount(root, profile, handled) on ModerationQueue

    ends: Admins are never suspended through moderation.
}

journey AnAdminSuspendsASpammer {
    goal: A report against an ordinary account is acted on by suspending it.

    cast:
        spammer: accounts/User
        profile: ReportableContent

    given:
        spammer.is_admin = false
        spammer.prohibit_login = false
        profile.kind = user
        profile.reported_user = spammer
        profile.is_deleted = false

    1. the admin suspends the account, leaving the report open
        root does AdminSuspendsReportedAccount(root, profile, none) on ModerationQueue
        then AdminSuspendsReportedAccount fires
        then spammer.prohibit_login = true

    ends: The spammer can no longer sign in.
}

-- Decision moderation 9: the purge is on by default with a 180-day
-- retention. The two journeys below previously asserted Forgejo's defaults
-- (task off, 7 days) and were updated to the decided ones.
journey ResolvedReportsArePurged {
    goal: Out of the box, a report ignored more than 180 days ago is deleted.

    after: AnAdminDismissesTheReport

    1. half a year and a day pass
        after 181.days
        then PurgeResolvedReport fires
        then report does not exist

    ends: Only recent resolutions remain on record.
}

journey AResolvedReportStaysWithinTheRetentionPeriod {
    goal: A week after it was ignored, the report is still on record: the
          default retention is 180 days.

    after: AnAdminDismissesTheReport

    1. a week and a day pass
        after 8.days
        then PurgeResolvedReport does not fire
        then report exists

    ends: Recently resolved reports stay for review.
}

journey AResolvedReportStaysWhileThePurgeTaskIsOff {
    goal: The admin turned the purge task off. A report ignored more than the
          retention period ago is kept.

    after: AnAdminDismissesTheReport

    given:
        moderation/config.purge_task_enabled = false

    1. half a year and a day pass
        after 181.days
        then PurgeResolvedReport does not fire
        then report exists

    ends: Resolved reports and their evidence are kept until the task is on.
}

journey WithModerationOffNothingCanBeReported {
    goal: On an instance that never turned moderation on, there is no
          "Report abuse" entry and no queue: Ada's report is refused, and the
          admin cannot act on the item either.

    given:
        moderation/config.enabled = false

    1. ada tries to report the comment
        stipulate can_read_conversation(ada, thread) = true
        stipulate remarks_length("This comment links to a phishing site twice.") = 45
        ada cannot do UserReportsContent(ada, item, spam, "This comment links to a phishing site twice.") on ReportAbuse
        ada cannot see item.kind on ReportAbuse in item

    2. nor can the admin moderate it
        root cannot do AdminDeletesReportedComment(root, item, handled) on ModerationQueue

    ends: Nothing is reported and nothing is moderated while the feature is off.
}

-- Decision moderation 4: the server refuses reports on one's own content.
journey NobodyReportsTheirOwnComment {
    goal: Ada wrote the comment herself; even with the entry hidden, a
          hand-made request to report it is refused.

    given:
        item.poster = ada

    1. she reports her own comment
        stipulate can_read_conversation(ada, thread) = true
        stipulate remarks_length("This comment links to a phishing site twice.") = 45
        ada cannot do UserReportsContent(ada, item, spam, "This comment links to a phishing site twice.") on ReportAbuse

    2. bruno, who did not write it, may
        stipulate can_read_conversation(bruno, thread) = true
        bruno does UserReportsContent(bruno, item, spam, "This comment links to a phishing site twice.") on ReportAbuse
            creating theirs: AbuseReport
        then theirs.status = open

    ends: Only other people's content enters the queue.
}

journey NobodyReportsTheirOwnRepository {
    goal: Ada administers the repository and cannot report it.

    cast:
        code: repositories/Repository
        repo_item: ReportableContent

    given:
        repo_item.kind = repository
        repo_item.reported_repository = code
        repo_item.is_deleted = false

    1. she reports her own repository
        stipulate can_read_any_unit(ada, code) = true
        stipulate is_repo_admin(ada, code) = true
        stipulate remarks_length("Nothing wrong here and just trying it out.") = 41
        ada cannot do UserReportsContent(ada, repo_item, other_violations, "Nothing wrong here and just trying it out.") on ReportAbuse

    ends: Self-reports never enter the queue.
}

-- Decision moderation 1: only actions for the reported kind apply.
journey AnActionMustMatchTheReportedKind {
    goal: The report is about a comment. The admin cannot answer it by deleting
          a repository or an account; deleting the comment is what is offered.

    after: AUserReportsAnAbusiveComment

    1. a mismatched action is refused
        root cannot do AdminDeletesReportedRepository(root, item, handled) on ModerationQueue
        root cannot do AdminDeletesReportedAccount(root, item, handled) on ModerationQueue
        root cannot do AdminSuspendsReportedAccount(root, item, handled) on ModerationQueue
        then report.status = open

    2. the matching one goes through
        root does AdminDeletesReportedComment(root, item, handled) on ModerationQueue
        then AdminDeletesReportedComment fires
        then report.status = handled

    ends: Nothing outside the reported item is touched.
}

-- Decisions moderation 2 and 8: resolving touches only open reports; each
-- reporter is told theirs was dealt with (CloseReport* emit ReportReviewed).
journey AnEarlierResolutionIsKept {
    goal: Ada's report was ignored. Bruno reports the same comment later and the
          admin marks the item handled: Bruno's report becomes handled, Ada's
          stays ignored with its original time.

    after: AnAdminDismissesTheReport

    1. bruno reports the comment
        stipulate can_read_conversation(bruno, thread) = true
        stipulate remarks_length("This comment links to a phishing site twice.") = 45
        bruno does UserReportsContent(bruno, item, spam, "This comment links to a phishing site twice.") on ReportAbuse
            creating later: AbuseReport
        then later.status = open

    2. the admin handles the item
        root does AdminResolvesReports(root, item, handled) on ModerationQueue
        then CloseReportAsHandled fires
        then CloseReportAsIgnored does not fire
        then later.status = handled
        then report.status = ignored

    ends: Each reporter hears once that their report was reviewed; Ada's
          earlier resolution is not rewritten.
}

-- Decision moderation 6: organisation deletion keeps evidence, as for users.
journey ADeletedOrganizationLeavesEvidence {
    goal: Ada reports an organization; its owner deletes it. The profile is
          captured for the report before it goes, and the item is a tombstone.

    cast:
        acme: organizations/Organization
        org_item: ReportableContent

    given:
        acme.name = "acme"
        org_item.kind = organization
        org_item.reported_organization = acme
        org_item.reported_user = null
        org_item.is_deleted = false

    1. ada reports the organization
        stipulate organization_visible_to(acme, ada) = true
        stipulate is_org_owner(acme, ada) = false
        stipulate remarks_length("Their profile advertises stolen accounts.") = 41
        ada does UserReportsContent(ada, org_item, illegal_content, "Their profile advertises stolen accounts.") on ReportAbuse
            creating complaint: AbuseReport
        then complaint.status = open

    2. the owner deletes the organization
        stipulate is_org_owner(acme, bruno) = true
        stipulate owned_repository_count(acme) = 0
        stipulate owned_package_count(acme) = 0
        bruno does OwnerDeletesOrganization(bruno, acme, "acme") on OrganizationSettings
        then PreserveEvidenceOnOrganizationDeletion fires
        then PreserveEvidenceBeforeChange fires
        then ReportedContentDeleted fires
        then org_item.is_deleted = true
        then complaint exists

    ends: The admin still judges the organization as it was when reported.
}

-- Decision moderation 5: a duplicate is refused with an explanation; the
-- form shows the reporter their open report.
journey ADuplicateReportIsExplained {
    goal: Ada already has an open report on the comment. The form tells her so
          and a second submission is refused.

    after: AUserReportsAnAbusiveComment

    1. she opens the form again
        ada sees item.kind on ReportAbuse in item
        ada cannot do UserReportsContent(ada, item, spam, "This comment links to a phishing site twice.") on ReportAbuse

    ends: Ada knows her first report is still waiting.
}

-- decided: administration 3. Filing a report is a write.
journey NoReportsWhileTheInstanceIsReadOnly {
    goal: The instance is in maintenance. Ada's report on the spam comment is
          refused until read-only mode is switched off.

    cast:
        gate: access/InstanceWriteGate

    given:
        gate.read_only = true

    1. ada tries to report the comment
        stipulate can_read_conversation(ada, thread) = true
        stipulate remarks_length("This comment links to a phishing site twice.") = 45
        ada cannot do UserReportsContent(ada, item, spam, "This comment links to a phishing site twice.") on ReportAbuse
        then item.is_in_queue = false

    ends: Nothing entered the queue.
}
