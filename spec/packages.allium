default KindPolicy npm_policy = { kind: npm, display_name: "npm", version_mode: immutable, file_overwrite: refuse, name_case_sensitive: false, has_repository_index: false, signing: none, size_limit: config.limit_size_npm, endpoint_root: "/api/packages/{owner}/npm" }
