-- allium: 3
-- packages.allium — the package registry: per-owner registries of typed packages, versions, files and deduplicated blobs.
--
-- Scope: everything a user or organisation can publish to, download from and
--   administer in the built-in package registry, across all 23 supported
--   package kinds, plus the background housekeeping that keeps it tidy.
-- Includes:
--   - OwnerRegistry (the per-user / per-organisation package namespace), its
--     access derivation, its per-kind signing keys and Cargo git index
--   - Package, PackageVersion, PackageFile, PackageBlob (content addressed,
--     deduplicated across the whole instance), package/version/file properties
--     and metadata extracted from uploads
--   - KindPolicy: the per-kind behaviour table (version immutability, file
--     overwrite, repository indexes, signing, size limits, endpoint roots)
--   - publishing (generic path, additive versions, file overwrite), container
--     (OCI) chunked blob uploads, blob mounting, manifests, tags vs digests,
--     image auto-linking to repositories
--   - kind-specific state changes that are not wire-protocol details: Cargo
--     yank / unyank, npm dist-tags, RPM / Arch server-side signing,
--     Debian / Alpine / RPM / Arch / ALT repository index regeneration,
--     Chef client public keys, container registry bearer tokens
--   - linking / unlinking a package to a repository, the repository
--     "packages" tab
--   - download counting, deletion of versions / files / whole packages
--   - CleanupRule (keep count, keep pattern, last-download windows, remove
--     age, remove pattern, full-name matching, enable/disable, preview) and
--     the scheduled cleanup task, expired-data purge
--   - instance limits LIMIT_TOTAL_OWNER_COUNT, LIMIT_TOTAL_OWNER_SIZE,
--     LIMIT_SIZE_<KIND>, DEFAULT_RPM_SIGN_ENABLED, ENABLED
--   - owner package settings pages, site-admin package overview
-- Excludes:
--   - the per-ecosystem wire protocols (URL layouts, JSON/XML/tar formats,
--     client handshakes): implementation detail of each client adapter; only
--     endpoint roots are listed in @guidance on the client surfaces
--   - storage backend selection (STORAGE_TYPE, MINIO_*), CHUNKED_UPLOAD_PATH,
--     serve-direct redirects: infrastructure
--   - the "container.repository" owner-name property rewrite on user rename:
--     a denormalisation; image coordinates are always derived from the
--     owner's current name
--   - the v1.20 "blob missing from storage" self-heal in container uploads,
--     Conan v1 / v2 API duality, NuGet v2 OData feeds, the Gitea-compatible
--     `/api/packages` vs `/api/v1/packages` naming: legacy / compatibility
--   - quota groups and rules (owned by `quota`); this module only asks quota
--     whether the owner may store more package data
--   - token issuance and scopes (owned by `authentication`); this module only
--     states which scope a request needs
-- Emits:
--   - PackageVersionCreated(version, publisher)        -- a new version became visible
--                                                  -- (incl. every container manifest push)
--   - PackageVersionDeleted(version, package, doer)  -- `version` is already gone, so listeners read `package`; a visible version was removed by a person
--   (webhooks, actions `on: package`, notifications react to these)
-- Reacts to:
--   - repositories/RepositoryDeleted(repository, doer) -- unlink all packages linked to it
--   - accounts/UserPurged(user)                    -- remove everything in the user's registry
--   - administration/PackageCleanupDue(older_than) -- run the cleanup task now

use "./accounts.allium" as accounts
use "./organizations.allium" as organizations
use "./repositories.allium" as repositories
use "./access.allium" as access
use "./authentication.allium" as authentication
use "./administration.allium" as administration
use "./quota.allium" as quota

------------------------------------------------------------
-- Given
------------------------------------------------------------

given {
    cleanup_schedule: PackageCleanupSchedule
}

------------------------------------------------------------
-- Value Types
------------------------------------------------------------

-- A name/value pair attached to a package, version or file. Several
-- properties may share a name (e.g. npm dist-tags, container manifest
-- references). Properties are how per-kind facts (distribution, component,
-- architecture, group, provider, yanked flag, digests ...) are recorded and
-- queried; the UI shows them on the version page.
-- from: models/packages/package_property.go:30
value PackageProperty {
    name: String
    value: String
}

-- Metadata extracted from the uploaded artefact (pom.xml, package.json,
-- .nuspec, METADATA, control file, Chart.yaml, image config ...). The common
-- shape below is what the UI renders; each kind keeps its full document in
-- `kind_document`.
-- from: modules/packages/npm/metadata.go:1
value PackageMetadata {
    description: String?
    readme: String?
    license: String?
    project_url: String?
    repository_url: String?
    authors: Set<String>
    keywords: Set<String>
    dependencies: Set<String>
    kind_document: String
}

------------------------------------------------------------
-- Enumerations
------------------------------------------------------------

-- Every supported package kind.
-- from: models/packages/package.go:31
enum PackageKind {
    alpine | alt | arch | cargo | chef | composer | conan | conda | container
    | cran | debian | generic | go | helm | maven | npm | nuget | pub | pypi
    | rpm | rubygems | swift | vagrant
}

-- How a kind treats an upload naming an existing version.
--   immutable  : a version is published once, complete; re-publishing it is refused
--   additive   : further files may be added to an existing version
--   reference  : (container) a tag or digest reference is re-pointed by a new push
enum VersionMode { immutable | additive | reference }

-- How a kind treats an upload naming a file the version already has.
--   refuse          : conflict
--   replace         : the new content replaces the old file
--   replace_metadata: only registry-metadata files (maven-metadata.xml and its
--                     checksums) are replaced; other files are refused
enum FileOverwrite { refuse | replace | replace_metadata }

-- Server-held key used to sign a kind's repository metadata.
enum SigningScheme { none | pgp | rsa }

------------------------------------------------------------
-- Entities and Variants
------------------------------------------------------------

-- The package namespace of one user or one organisation. Exactly one exists
-- per owner; it comes into being with the owner and is never created by a
-- rule here. All packages, cleanup rules, signing keys and the Cargo index
-- of that owner hang off it.
-- from: services/context/package.go:16
entity OwnerRegistry {
    owner_user: accounts/User?
    owner_org: organizations/Organization?

    packages: Package with registry = this
    cleanup_rules: CleanupRule with registry = this
    signing_keys: RegistrySigningKey with registry = this
    repository_indexes: RepositoryIndex with registry = this
    container_uploads: ContainerUploadedBlob with registry = this
    cargo_index: CargoIndex with registry = this

    visible_packages: packages where is_internal = false

    -- Number of non-internal versions across all packages of this owner.
    visible_version_count: visible_version_count_of(this)
    -- Sum of the sizes of the files of all versions (internal included) of
    -- this owner. Shared blobs are counted once per file referencing them.
    stored_size: stored_size_of(this)

    owner_is_org: owner_org != null
    has_packages: visible_version_count > 0
}

-- Behaviour of one package kind. One default instance exists per kind
-- (see Defaults); rules consult it with KindPolicy{kind: k}.
-- from: services/packages/packages.go:366
entity KindPolicy {
    kind: PackageKind
    display_name: String
    version_mode: VersionMode
    file_overwrite: FileOverwrite
    -- Package names compare case-insensitively except where this is true.
    name_case_sensitive: Boolean
    -- Owner-wide index files (APKINDEX, Packages/Release, repodata, pacman db)
    -- are regenerated after every change.
    has_repository_index: Boolean
    signing: SigningScheme
    -- Maximum bytes of a single uploaded file; -1 means unlimited.
    size_limit: Integer
    -- Root under which the client protocol for this kind is served,
    -- relative to the instance URL; {owner} is the registry owner's name.
    endpoint_root: String
}

-- A named package of one kind in one registry.
-- from: models/packages/package.go:190
entity Package {
    registry: OwnerRegistry
    kind: PackageKind
    name: String
    -- Whether versions sort by semantic version (npm, helm, cargo ...).
    semver_compatible: Boolean
    -- Internal packages hold registry machinery (repository index files) and
    -- are never listed, counted or individually addressable by users.
    is_internal: Boolean
    -- the repository the package is linked to (webhooks / actions payloads
    -- read it as package.repository)
    repository: repositories/Repository?
    properties: Set<PackageProperty>
    -- convenience views used by webhooks / actions payloads
    owner_user: registry.owner_user
    owner_org: registry.owner_org
    -- container only: auto-linking is attempted once, on the first manifest
    -- push after creation
    autolink_pending: Boolean

    versions: PackageVersion with package = this
    visible_versions: versions where is_internal = false
    has_versions: versions.count > 0
    latest_version: latest_of(visible_versions)
}

-- One version of a package. Has no lifecycle status: it exists until it is
-- deleted (by a person, a cleanup rule, or owner purge).
-- from: models/packages/package_version.go:29
entity PackageVersion {
    package: Package
    creator: accounts/User
    version: String
    created_at: Timestamp
    is_internal: Boolean
    metadata: PackageMetadata?
    properties: Set<PackageProperty>
    download_count: Integer
    last_downloaded_at: Timestamp?

    -- container: true when the reference pushed was a tag (not a digest)
    is_tagged: Boolean
    -- cargo: a yanked version stays downloadable but is excluded from
    -- dependency resolution in the index
    is_yanked: Boolean
    -- npm: dist-tags pointing at this version (a tag points at one version
    -- of a package at a time)
    dist_tags: Set<String>

    files: PackageFile with version = this
    total_size: size_sum_of(files)
    -- container digest-named versions not referenced by any image index and
    -- not tagged
    is_dangling_container_digest: dangling_digest_check(this)
}

-- One file of a version. The (version, name, composite_key) triple is unique.
-- composite_key scopes a file inside a version: Debian "distribution|component",
-- RPM / ALT group, Conan recipe/package revision, Arch distribution ...
-- from: models/packages/package_file.go:34
entity PackageFile {
    version: PackageVersion
    blob: PackageBlob
    name: String
    composite_key: String?
    -- The file that represents the version (the .deb, the .tgz, the .nupkg,
    -- the .pom ...). Only lead-file downloads count as version downloads.
    is_lead: Boolean
    created_at: Timestamp
    properties: Set<PackageProperty>
}

-- Content-addressed bytes, stored once per distinct content across the
-- whole instance and shared by every file with that content.
-- from: models/packages/package_blob.go:30
entity PackageBlob {
    size: Integer
    hash_md5: String
    hash_sha1: String
    hash_sha256: String
    hash_sha512: String
    hash_blake2b: String
    created_at: Timestamp

    files: PackageFile with blob = this
    is_referenced: files.count > 0
}

-- An in-progress chunked container blob upload (OCI upload session).
-- from: models/packages/package_blob_upload.go:24
entity BlobUpload {
    registry: OwnerRegistry
    image: String
    bytes_received: Integer
    created_at: Timestamp
    updated_at: Timestamp
}

-- A blob pushed (or mounted) into an image of a registry that no manifest
-- references yet. Manifests may only reference blobs that are known here or
-- already part of the image.
-- from: services/packages/container/blob.go:49
entity ContainerUploadedBlob {
    registry: OwnerRegistry
    image: String
    blob: PackageBlob
    uploaded_at: Timestamp
}

-- Per-owner, per-kind retention policy. At most one per (owner, kind).
-- from: models/packages/package_cleanup_rule.go:25
entity CleanupRule {
    registry: OwnerRegistry
    kind: PackageKind
    enabled: Boolean
    keep_count: Integer
    keep_pattern: String
    keep_last_download_days: Integer
    remove_days: Integer
    remove_last_download_days: Integer
    remove_pattern: String
    match_full_name: Boolean
    created_at: Timestamp
    updated_at: Timestamp

    -- The versions the rule would delete if it ran now (see guidance on
    -- ApplyCleanupRule for the algorithm). The preview page shows these.
    targets: cleanup_targets_of(this)
}

-- Key pair a registry uses to sign its repository metadata for one kind
-- (Debian Release, Alpine APKINDEX, RPM repomd / packages, Arch databases /
-- packages). Generated on first need and kept forever.
-- from: services/packages/debian/repository.go:42
entity RegistrySigningKey {
    registry: OwnerRegistry
    kind: PackageKind
    scheme: SigningScheme
    public_key: String
    created_at: Timestamp
}

-- Owner-wide index files for an indexed kind, for one scope
-- (Debian distribution/component/architecture, Alpine branch/repository/
-- architecture, RPM / ALT group, Arch distribution/architecture).
-- from: services/packages/debian/repository.go:101
entity RepositoryIndex {
    registry: OwnerRegistry
    kind: PackageKind
    scope: String
    built_at: Timestamp
}

-- The Cargo sparse/git index of a registry: a git repository named
-- `_cargo-index` in the owner's namespace holding one file per crate plus
-- config.json (download URL, auth-required = owner not public).
-- from: services/packages/cargo/index.go:51
entity CargoIndex {
    registry: OwnerRegistry
    repository_name: String
    built_at: Timestamp
}

-- RSA public key a user registers for Chef client request signing.
-- from: routers/web/user/setting/packages.go:103
entity ChefClientKey {
    user: accounts/User
    public_key: String
    created_at: Timestamp
}

-- Short-lived bearer token issued to container clients (docker login).
-- from: services/packages/auth.go:28
entity RegistryBearerToken {
    -- null for an anonymous pull token
    user: accounts/User?
    scope: String?
    issued_at: Timestamp
    expires_at: Timestamp
}

-- The single schedule of the `cleanup_packages` cron task.
-- from: services/cron/tasks_basic.go:145
entity PackageCleanupSchedule {
    next_run_at: Timestamp
    last_run_at: Timestamp?
    is_due: next_run_at <= now
}

------------------------------------------------------------
-- Config
------------------------------------------------------------

config {
    -- [packages] ENABLED: the whole registry (client endpoints, UI, API)
    packages_enabled: Boolean = true
    -- [service] REQUIRE_SIGNIN_VIEW, owned by access
    require_signin_view: Boolean = access/config.require_signin_view
    -- [packages] LIMIT_TOTAL_OWNER_COUNT: max visible versions per owner, -1 unlimited
    limit_total_owner_count: Integer = -1
    -- [packages] LIMIT_TOTAL_OWNER_SIZE: max bytes stored per owner, -1 unlimited
    limit_total_owner_size: Integer = -1
    -- [packages] LIMIT_SIZE_<KIND>: max bytes of one uploaded file, -1 unlimited
    limit_size_alpine: Integer = -1
    limit_size_alt: Integer = -1
    limit_size_arch: Integer = -1
    limit_size_cargo: Integer = -1
    limit_size_chef: Integer = -1
    limit_size_composer: Integer = -1
    limit_size_conan: Integer = -1
    limit_size_conda: Integer = -1
    limit_size_container: Integer = -1
    limit_size_cran: Integer = -1
    limit_size_debian: Integer = -1
    limit_size_generic: Integer = -1
    limit_size_go: Integer = -1
    limit_size_helm: Integer = -1
    limit_size_maven: Integer = -1
    limit_size_npm: Integer = -1
    limit_size_nuget: Integer = -1
    limit_size_pub: Integer = -1
    limit_size_pypi: Integer = -1
    limit_size_rpm: Integer = -1
    limit_size_rubygems: Integer = -1
    limit_size_swift: Integer = -1
    limit_size_vagrant: Integer = -1
    -- [packages] DEFAULT_RPM_SIGN_ENABLED: sign every uploaded RPM with the
    -- owner's RPM key even when the uploader did not ask for it
    default_rpm_sign_enabled: Boolean = false
    -- [cron.cleanup_packages] ENABLED / RUN_AT_START / SCHEDULE / OLDER_THAN
    cleanup_enabled: Boolean = true
    cleanup_run_at_start: Boolean = true
    cleanup_interval: Duration = 1.day
    cleanup_older_than: Duration = 24.hours
    -- lifetime of container registry bearer tokens (capped by the lifetime of
    -- the credential used to obtain them)
    registry_token_lifetime: Duration = 24.hours
    -- [ui] PACKAGES_PAGING_NUM
    packages_paging_num: Integer = 20
    -- page size cap of the container catalog / tag list
    container_list_max: Integer = 100
}

------------------------------------------------------------
-- Defaults
------------------------------------------------------------

-- from: routers/api/packages/api.go:200 (endpoint roots) and the Create* call per kind
default KindPolicy alpine_policy = { kind: alpine, display_name: "Alpine", version_mode: additive, file_overwrite: refuse, name_case_sensitive: false, has_repository_index: true, signing: rsa, size_limit: config.limit_size_alpine, endpoint_root: "/api/packages/{owner}/alpine" }
default KindPolicy alt_policy = { kind: alt, display_name: "ALT", version_mode: additive, file_overwrite: refuse, name_case_sensitive: false, has_repository_index: true, signing: none, size_limit: config.limit_size_alt, endpoint_root: "/api/packages/{owner}/alt" }
default KindPolicy arch_policy = { kind: arch, display_name: "Arch", version_mode: additive, file_overwrite: replace, name_case_sensitive: false, has_repository_index: true, signing: pgp, size_limit: config.limit_size_arch, endpoint_root: "/api/packages/{owner}/arch" }
default KindPolicy cargo_policy = { kind: cargo, display_name: "Cargo", version_mode: immutable, file_overwrite: refuse, name_case_sensitive: false, has_repository_index: false, signing: none, size_limit: config.limit_size_cargo, endpoint_root: "/api/packages/{owner}/cargo" }
default KindPolicy chef_policy = { kind: chef, display_name: "Chef", version_mode: immutable, file_overwrite: refuse, name_case_sensitive: false, has_repository_index: false, signing: none, size_limit: config.limit_size_chef, endpoint_root: "/api/packages/{owner}/chef" }
