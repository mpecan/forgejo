default KindPolicy conan_policy = { kind: conan, display_name: "Conan", version_mode: additive, file_overwrite: replace, name_case_sensitive: false, has_repository_index: false, signing: none, size_limit: config.limit_size_conan, endpoint_root: "/api/packages/{owner}/conan" }
default KindPolicy conda_policy = { kind: conda, display_name: "Conda", version_mode: additive, file_overwrite: refuse, name_case_sensitive: false, has_repository_index: false, signing: none, size_limit: config.limit_size_conda, endpoint_root: "/api/packages/{owner}/conda" }
default KindPolicy container_policy = { kind: container, display_name: "Container", version_mode: reference, file_overwrite: refuse, name_case_sensitive: false, has_repository_index: false, signing: none, size_limit: config.limit_size_container, endpoint_root: "/v2/{owner}" }
default KindPolicy cran_policy = { kind: cran, display_name: "CRAN", version_mode: additive, file_overwrite: refuse, name_case_sensitive: false, has_repository_index: false, signing: none, size_limit: config.limit_size_cran, endpoint_root: "/api/packages/{owner}/cran" }
