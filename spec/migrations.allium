-- allium: 3
-- migrations.allium — the repository import ADDON: bring a repository (git
-- data, wiki, LFS and optionally its issue tracker history) in from another
-- forge, as a one-off import or as the seed of a pull mirror.
--
-- FRAMING: this module does NOT describe core behaviour. Data import is built
-- as an addon on top of the new system. This file specifies (a) what the
-- import addon does, and (b) the extension points the core must offer so an
-- addon can do it — declared below as `contract`s (ImportSink,
-- ImportedIdentityResolver, OutboundFetchPolicy, BackgroundJobQueue) and
-- consumed on the CoreHostBoundary surface. Anything the core does on its own
-- (repository lifecycle, issue model, pull-mirror syncing) is owned by the
-- core modules and only referenced here.
--
-- Scope: creating a repository by importing it from a remote source, the
--   Migration task that does the work, the per-source adapters and what each
--   can import, credentials handling, remote-address policy, original-author
--   preservation and later re-attribution to local accounts, dump-to-archive
--   and restore-from-archive.
-- Includes:
--   - Migration task (queued / running / finished / failed) with progress,
--     cancel, retry, discard-failed-repository
--   - SourceProfile per source kind: plain git, Forgejo, Gitea, Gogs, GitHub,
--     GitLab, GitBucket, Codebase, OneDev, Pagure, Bitbucket Data Center
--   - what can be imported: git, wiki, LFS, topics, avatar, milestones,
--     labels, releases + assets, issues, comments, pull requests, reviews,
--     reactions
--   - credentials (username+password or token), kept only while needed
--   - allowed / blocked hosts, local network, unencrypted transports, local
--     paths
--   - "migrate as mirror": creating the repository and its pull mirror
--   - ExternalAuthorship records and re-attribution (on account link, by a
--     nightly sweep)
--   - dump-repo (export to the archive format) and restore-repo (CLI and
--     private API)
-- Excludes:
--   - Ongoing pull-mirror synchronisation, push mirrors: owned by
--     repositories (this module only creates the Mirror at import time)
--   - The repository deletion mechanics, name validation, per-owner repo
--     limits: owned by repositories (referenced as black boxes)
--   - OAuth sign-in and the ExternalLogin record itself: owned by
--     authentication (this module only reacts to an account being linked)
--   - Gitea-SDK version quirks (pagination before 1.12, missing reactions
--     before 1.11, head-SHA fix-ups before 1.14): compatibility workarounds of
--     one adapter, not domain behaviour
--   - The F3 (Friendly Forge Format) driver: not present in this code base
--   - Batch sizes derived from database parameter limits: implementation
--   - The legacy `uid` field on the API request: backwards compatibility only
--   - GitHub "www.github.com" host rewriting: adapter detail
--   - Re-running a task whose repository is already ready just marks it
--     finished: crash-recovery for a non-atomic completion, not behaviour
-- Emits:
--   - MigrationQueued(migration)                 -- job queue picks it up
--   - MigrationProgressed(migration)             -- progress page refresh
--   - RepositoryMigrated(repository)             -- releases (sync tags),
--       webhooks (repository created), activity feed, notifications; the
--       doer is migrations/Migration{repository}.doer
--   - MigrationFailed(migration)                 -- progress page, notifications
--   - MigrationFailureReported(kind, description) -- kind: repository; on a
--       failed import and on dropped unsafe source data; administration
--       records it as a SystemNotice
--   - ImportCompleted(repository, remote_address, has_credentials, interval,
--       lfs_enabled, lfs_endpoint)            -- repositories finishes the
--       repository (ready; pull mirror for a mirror import)
--   - MigratedContentDiscarded(repository)       -- core wipes partially
--       imported content before a retry
--   - ExternalAuthorLinked(authorship, user)     -- imported content now
--       belongs to a local account (feeds, search re-index)
--   - RelinkSweepCompleted(outcome, message)     -- the nightly re-attribution
--       sweep finished (administration closes the update_migration_poster_id run)
-- Reacts to:
--   - authentication/ExternalLogin.created (an OAuth identity linked to an account)
--   - administration/MigrationPosterIdUpdateDue()  -- nightly re-attribution
--       (cron task update_migration_poster_id, @midnight, run at start)
--   - repositories/RepositoryDeleted(repository, doer) -- the addon's records
--       about the repository go with it
-- Every user-initiated write here is refused while the instance is read-only
-- (access/InstanceWriteGate; decided: administration 3). The operator's
-- dump-repo / restore-repo commands are not gated: they run on the server.
--
-- Black-box predicates. Qualified calls into sibling modules cannot be
-- simulated, so the predicates this module needs are named locally, each
-- delegating to its owner:
--   is_repo_admin(user, repository)        -- access/is_repo_admin
--   can_read_code(user, repository)        -- access/can_read(user, repository, code)
--   can_create_in_org(user, org)           -- organizations: Organization.lets_create_repo(user)
--   is_valid_repo_name(name)               -- repositories name rules
--   repository_name_free(owner, name)      -- repositories: no repository (or redirect) with that name
--   within_creation_limit(owner)           -- repositories/accounts per-owner repository limit
--   quota_allows_new_repository(owner)     -- quota gate_migrate_repository (size_repos_all, target owner)
--   quota_allows_retry(repository)         -- quota gate_retry_migration (size_repos_all, repository owner)
--   ghost_user()                           -- accounts: the ghost placeholder account
--   may_import_local_paths(user)           -- accounts: per-user "may import local paths" right
--   linked_account_for(kind, host, external_id) -- authentication: owner of an ExternalLogin with that provider kind, provider host and id
--   source_kind_for_provider(provider)     -- authentication: the forge kind an OAuth provider type speaks (github, gitlab, gitea, ...)
--   provider_host(source)                  -- authentication: the host an OAuth source authenticates against
--   host_of(url)                           -- the host part of a URL
--   assignable_named(repository, names)    -- issues: the local accounts with those names that can be assigned in the repository
--   resolves_to_assignee(repository, name) -- issues: that name is a local account that can be assigned in the repository
--   far_future_deadline()                  -- 9999-01-01, Forgejo's "no deadline" milestone value
--   source_is_private(request)             -- the source repository is private (what dump-repo writes to repo.yml)
--   is_allowed_remote(url, user)           -- this module's OutboundFetchPolicy, exported for mirrors
--   resolve_author(migration, identity)    -- ImportedIdentityResolver.resolve / resolve_same_instance
--   first_present(a, b, c)                 -- the first non-absent timestamp, else now
--   - (job queue) MigrationDequeued(migration) via CoreHostBoundary

use "./accounts.allium" as accounts
use "./organizations.allium" as organizations
use "./repositories.allium" as repositories
use "./access.allium" as access
use "./authentication.allium" as authentication
use "./issues.allium" as issues
use "./pulls.allium" as pulls
use "./releases.allium" as releases
use "./quota.allium" as quota
use "./administration.allium" as administration

------------------------------------------------------------
-- External Entities
------------------------------------------------------------

-- The per-source adapter process (one "downloader" per source kind) that
-- talks to the remote forge and feeds items into the import.
-- from: modules/migration/downloader.go:55
external entity SourceAdapterProcess {
    source_kind: SourceKind
    active: Boolean
}

-- The core system hosting the addon (job queue, storage, sinks).
-- from: services/task/task.go:43
external entity CoreRuntime {
    addon_installed: Boolean
}

-- Someone with shell access to the server running `forgejo dump-repo` /
-- `forgejo restore-repo` (the latter goes through the private API).
-- from: cmd/restore_repo.go:19
external entity OperatorShell {
    has_server_access: Boolean
}

------------------------------------------------------------
-- Value Types
------------------------------------------------------------

-- A remote address as typed by the user. Credentials are never accepted
-- inside the URL; they travel separately in SourceCredentials.
-- from: services/forms/repo_form.go:98
value RemoteAddress {
    url: String
    scheme: AddressScheme
    host: String
    embeds_credentials: Boolean
    is_encrypted: scheme in {https, local_path}
}

-- from: modules/migration/options.go:15
value SourceCredentials {
    username: String?
    password: String?
    -- GitHub accepts several comma-separated tokens and rotates between them
    -- to spread rate limits.
    token: String?
    kind: CredentialKind
}

-- What a user submits on the migration form / POST /repos/migrate.
-- from: modules/structs/repo.go:376
value MigrationRequest {
    source: SourceProfile
    address: RemoteAddress
    credentials: SourceCredentials
    repo_name: String
    description: String
    private: Boolean
    mirror: Boolean
    -- Pull-mirror interval; the form pre-fills [mirror] DEFAULT_INTERVAL;
    -- 0 means "never sync automatically". Ignored unless mirror.
    mirror_interval: Duration
    wiki: Boolean
    lfs: Boolean
    lfs_endpoint: RemoteAddress?
    -- Selected content. The form offers milestones, labels, issues, pull
    -- requests and releases; choosing issues or pull requests also selects
    -- comments and reactions, pull requests also selects reviews, releases
    -- also selects release assets.
    wanted: Set<ContentKind>
}

-- What to restore from an archive. Empty units means everything archived.
-- from: cmd/restore_repo.go:42
value RestoreSelection {
    units: Set<ContentKind>
    validate: Boolean
}

-- The identity of a person on the source forge, as carried by imported data.
-- from: models/user/external_login_user.go (ExternalUserMigrated)
value ImportedIdentity {
    -- Opaque: numeric or not, it is matched as a string.
    -- decided: non-numeric external ids are re-attributed too (migrations 6)
    external_id: String
    name: String
    email: String?
}

-- from: modules/migration/repo.go:7
value ImportedRepositoryInfo {
    name: String
    owner_name: String
    description: String
    website: String?
    default_branch: String
    original_url: String
    clone_address: RemoteAddress
    avatar_url: String?
}

-- from: modules/migration/milestone.go:9
value ImportedMilestone {
    title: String
    description: String
    deadline: Timestamp?
    created_at: Timestamp?
    updated_at: Timestamp?
    closed_at: Timestamp?
    is_closed: Boolean
}

-- from: modules/migration/label.go:7
value ImportedLabel {
    name: String
    color: String
    description: String
    exclusive: Boolean
}

-- from: modules/migration/reaction.go:7
value ImportedReaction {
    author: ImportedIdentity
    content: String
}

-- from: modules/migration/release.go:13
value ImportedReleaseAsset {
    name: String
    size: Integer
    download_count: Integer
    created_at: Timestamp?
}

-- from: modules/migration/release.go:29
value ImportedRelease {
    tag_name: String
    target: String
    name: String
    body: String
    is_draft: Boolean
    is_prerelease: Boolean
    publisher: ImportedIdentity
    created_at: Timestamp?
    published_at: Timestamp?
    assets: List<ImportedReleaseAsset>
}

-- from: modules/migration/issue.go:9
value ImportedIssue {
    number: Integer
    author: ImportedIdentity
    title: String
    content: String
    ref: String?
    milestone_title: String?
    label_names: Set<String>
    is_closed: Boolean
    is_locked: Boolean
    created_at: Timestamp?
    updated_at: Timestamp?
    closed_at: Timestamp?
    reactions: List<ImportedReaction>
    assignee_names: Set<String>
}

-- from: modules/migration/pullrequest.go:85
value PullRequestEndpoint {
    clone_url: String?
    ref: String?
    sha: String?
    owner_name: String
    repo_name: String
}

-- from: modules/migration/pullrequest.go:16
value ImportedPullRequest {
    number: Integer
    author: ImportedIdentity
    title: String
    content: String
    milestone_title: String?
    label_names: Set<String>
    is_closed: Boolean
    is_locked: Boolean
    is_draft: Boolean
    merged: Boolean
    merged_at: Timestamp?
    merge_commit_sha: String?
    -- Who merged it on the source, when the source says.
    merged_by: ImportedIdentity?
    assignee_names: Set<String>
    head: PullRequestEndpoint
    base: PullRequestEndpoint
    created_at: Timestamp?
    updated_at: Timestamp?
    closed_at: Timestamp?
    reactions: List<ImportedReaction>
    is_fork_pull: Boolean
    -- Set by the adapter after it validated clone URL, refs and SHAs.
    ensured_safe: Boolean
}

-- from: modules/migration/comment.go:16
value ImportedComment {
    issue_number: Integer
    source_index: Integer
    kind: String
    author: ImportedIdentity
    content: String
    created_at: Timestamp?
    updated_at: Timestamp?
    reactions: List<ImportedReaction>
    reply_to_index: Integer?
}

-- from: modules/migration/review.go:55
value ImportedReviewComment {
    author: ImportedIdentity?
    content: String
    tree_path: String
    diff_hunk: String?
    line: Integer
    extra_lines: Integer
    commit_sha: String?
    created_at: Timestamp?
    reactions: List<ImportedReaction>
}

-- from: modules/migration/review.go:37
value ImportedReview {
    issue_number: Integer
    reviewer: ImportedIdentity
    official: Boolean
    commit_sha: String?
    content: String
    created_at: Timestamp?
    state: ImportedReviewState
    comments: List<ImportedReviewComment>
}

------------------------------------------------------------
-- Contracts
------------------------------------------------------------

-- What every source adapter ("downloader") implements. Each fetch may answer
-- "not supported", which the import treats as "nothing to import", never as
-- a failure.
-- from: modules/migration/downloader.go:55
contract SourceDownloader {
    get_repo_info: () -> ImportedRepositoryInfo
    get_topics: () -> List<String>
    get_milestones: () -> List<ImportedMilestone>
    get_labels: () -> List<ImportedLabel>
    get_releases: () -> List<ImportedRelease>
    get_issues: (page: Integer, per_page: Integer) -> List<ImportedIssue>
    get_comments: (issue_number: Integer) -> List<ImportedComment>
    get_all_comments: (page: Integer, per_page: Integer) -> List<ImportedComment>
    supports_repository_wide_comments: () -> Boolean
    supports_comment_replies: () -> Boolean
    get_pull_requests: (page: Integer, per_page: Integer) -> List<ImportedPullRequest>
    get_reviews: (pull_number: Integer) -> List<ImportedReview>
    format_clone_address: (address: RemoteAddress, credentials: SourceCredentials) -> RemoteAddress

    @invariant NotSupportedIsEmpty
        -- A fetch the source cannot answer yields "not supported"; the
        -- import skips that content kind and carries on.

    @invariant SafePullRequests
        -- Before yielding a pull request the adapter clears any head clone
        -- URL that does not share the source's base URL (no open redirect),
        -- clears SHAs that are not valid object ids and refs that are not
        -- valid ref names, records each such drop as a notice, and marks the
        -- pull request ensured_safe. The sink refuses unmarked pull requests.

    @invariant BoundedRetries
        -- Every remote call is retried on transient failure up to
        -- config.max_attempts times, waiting config.retry_backoff between
        -- attempts. Rate-limit responses wait until the limit resets (GitHub
        -- rotates between multiple tokens, picking the one with the most
        -- remaining quota).

    @invariant OutboundPolicyApplies
        -- Every HTTP request an adapter makes (API calls, asset downloads,
        -- avatar fetches) goes through OutboundFetchPolicy, so allow/block
        -- lists and the local-network ban hold for redirects and secondary
        -- URLs too, not only for the address the user typed.
}

-- The core extension point through which the addon writes imported data.
-- In Forgejo this is the "local uploader".
-- from: services/migrations/gitea_uploader.go:63
contract ImportSink {
    create_repository_shell: (request: MigrationRequest) -> ImportedRepositoryInfo
    import_git_data: (info: ImportedRepositoryInfo, wiki: Boolean, lfs: Boolean, lfs_endpoint: RemoteAddress?, mirror: Boolean, mirror_interval: Duration?) -> Boolean
    save_topics: (topics: List<String>) -> Boolean
    create_milestones: (items: List<ImportedMilestone>) -> Boolean
    create_labels: (items: List<ImportedLabel>) -> Boolean
    create_releases: (items: List<ImportedRelease>) -> Boolean
    sync_tags_to_releases: () -> Boolean
    create_issues: (items: List<ImportedIssue>) -> Boolean
    create_comments: (items: List<ImportedComment>) -> Boolean
    create_pull_requests: (items: List<ImportedPullRequest>) -> Boolean
    create_reviews: (items: List<ImportedReview>) -> Boolean
    reattribute: (source_kind: SourceKind, source_host: String, external_id: String, user: accounts/User) -> Boolean
    discard_imported_content: (repository: repositories/Repository) -> Boolean
    finish: (repository: repositories/Repository) -> Boolean

    @invariant PreservesOriginalAuthorship
        -- Every imported issue, pull request, comment, review, review
        -- comment, release and reaction is attributed either to a resolved
        -- local account (ImportedIdentityResolver) or to the ghost
        -- placeholder user while carrying the original author's name and
        -- external id, so it can be re-attributed later.

    @invariant PreservesTimestampsAndNumbers
        -- Imported items keep the source's creation, update, close and
        -- merge timestamps and the source's issue / pull request numbers.
        -- After the import the repository's next-number counter is set past
        -- the highest imported number. Missing timestamps fall back to:
        -- issue created <- closed <- now; comment created <- parent issue
        -- created; release created <- published <- now.

    @invariant NoLiveSideEffects
        -- Writing imported content does not emit the core's live domain
        -- events (no IssueOpened, no mention notifications, no webhooks per
        -- item, no activity feed entries). Only the final RepositoryMigrated
        -- is announced.

    @invariant RefusesUnsafePullRequests
        -- create_pull_requests rejects any pull request not marked
        -- ensured_safe by its adapter.

    @invariant StatsRecalculatedOnFinish
        -- finish recomputes repository counters (issues, pulls, milestones,
        -- releases, size) and sets the repository status to ready.
}

-- Resolves a source identity to a local account.
-- from: services/migrations/gitea_uploader.go:1065
contract ImportedIdentityResolver {
    resolve: (source_kind: SourceKind, identity: ImportedIdentity) -> accounts/User
    resolve_same_instance: (identity: ImportedIdentity) -> accounts/User

    @invariant ResolutionOrder
        -- When the source is this same instance (original URL starts with
        -- the instance's own URL) an author resolves to the local account
        -- with that id only if the name also matches. Otherwise it resolves
        -- to the local account that has linked an external login whose
        -- provider speaks this source kind, whose provider host is the
        -- source's host, and whose external id equals the author's id
        -- (compared as opaque strings). Otherwise it does not resolve.
        -- decided: match on kind + host + external id; the OAuth source's
        -- name no longer has to equal the forge kind (migrations 5, 6)
}

-- The core's outbound-HTTP gate for addon traffic.
-- from: services/migrations/allowlist/is_migrate_allowed.go:68
contract OutboundFetchPolicy {
    is_address_allowed: (address: RemoteAddress, doer: accounts/User) -> Boolean

    @invariant AllowBlockSemantics
        -- A host is refused if it (or any address it resolves to) matches
        -- the blocked list. If an allowed list is configured, a host is
        -- refused unless it (or a resolved address) matches it. With no
        -- allowed list, only external (non-private, non-loopback) addresses
        -- are allowed, unless config.allow_local_networks.

    @invariant DialTimeCheck
        -- The check is repeated at connection time against the address
        -- actually dialled, so DNS rebinding cannot reach a blocked host.
}

-- from: services/task/task.go:61
contract BackgroundJobQueue {
    enqueue: (migration: Migration) -> Boolean

    @invariant SurvivesRestart
        -- Queued migrations persist across restarts and are picked up again.
}

------------------------------------------------------------
-- Enumerations
------------------------------------------------------------

-- from: modules/structs/repo.go:324
enum SourceKind {
    plain_git | forgejo | gitea | gogs | github | gitlab | gitbucket
    | codebase | onedev | pagure | bitbucket_dc
}

-- Issue-tracker content that can be imported besides git data.
-- from: modules/migration/options.go:30
enum ContentKind {
    milestones | labels | release_items | release_assets | issue_items | comments
    | pull_requests | reviews | reactions
}

enum AddressScheme { http | https | git | ssh | local_path | other }

enum CredentialKind { anonymous | username_password | token }

-- What kind of imported item an authorship record is about.
enum AuthoredContent { on_issue | on_comment | on_reaction | on_release | on_review | on_merge }

-- The progress messages shown while a migration runs.
-- from: services/migrations/migrate.go:151
enum ImportStage {
    git | topics | milestones | labels | release_items | issue_items | pull_requests
    | comments | finalizing
}

-- from: modules/migration/review.go:28
enum ImportedReviewState { pending | approved | changes_requested | commented | review_requested }

-- from: services/task/migrate.go:208, routers/web/repo/migrate.go:74
enum FailureReason {
    canceled | authentication_failed | remote_error | rate_limited
    | two_factor_required | address_not_allowed | name_conflict
    | repository_limit_reached | quota_exceeded | invalid_source_data
    | internal_error
}

------------------------------------------------------------
-- Entities and Variants
------------------------------------------------------------

-- What a source kind can supply. One default per kind below.
-- from: modules/structs/repo.go:417
entity SourceProfile {
    kind: SourceKind
    supports: Set<ContentKind>
    credential_kinds: Set<CredentialKind>
    imports_topics: Boolean
    imports_avatar: Boolean
    -- Comments carry "in reply to" links (rendered as a quote header).
    comment_replies: Boolean
    -- Comments are fetched repository-wide rather than per issue.
    repository_wide_comments: Boolean
}

-- One repository import. Created together with the target repository, which
-- sits in status being_migrated until the import finishes.
-- from: models/admin/task.go:23
entity Migration {
    doer: accounts/User
    repository: repositories/Repository
    source: SourceProfile
    -- Where it came from, with any credentials removed. Kept forever.
    original_url: String
    -- The source forge's host; imported identities are matched within it.
    source_host: String
    -- true when restored from a dump archive rather than fetched live.
    from_archive: Boolean
    validate_archive: Boolean
    wiki: Boolean
    lfs: Boolean
    lfs_endpoint: RemoteAddress?
    mirror: Boolean
    mirror_interval: Duration
    content_scope: Set<ContentKind>
    -- Numbers of the issues and pull requests imported so far; comments and
    -- reviews may only attach to these.
    imported_numbers: Set<Integer>
    status: queued | running | finished | failed
    -- The address and credentials, encrypted at rest, and only while they
    -- may still be needed (a failed migration can be retried).
    source_address: RemoteAddress when status = queued | running | failed
    credentials: SourceCredentials when status = queued | running | failed
    stage: ImportStage?
    -- While git data is being cloned: when the clone gives up.
    git_deadline: Timestamp?
    items_processed: Integer
    message: String?
    failure_reason: FailureReason when status = failed
    created_at: Timestamp
    started_at: Timestamp?
    ended_at: Timestamp when status = finished | failed

    transitions status {
        queued -> running
        queued -> failed
        running -> finished
        running -> failed
        failed -> queued
        terminal: finished
    }

    -- Derived
    is_active: status in {queued, running}
    can_be_retried: status = failed
}

-- The original author of one imported item that could not be attributed to
-- a local account. The item itself is attributed to the ghost placeholder
-- (or has no publisher, for releases) and shows "originally by <name>";
-- once the source identity is linked to a local account the item is handed
-- over to it. The core content entities carry no import fields: this record
-- is the addon's.
-- from: models/issues/issue_update.go:634 (original_author / original_author_id)
entity ExternalAuthorship {
    repository: repositories/Repository
    source_kind: SourceKind
    -- decided: identities are scoped by source host (migrations 5)
    source_host: String
    external_id: String
    external_name: String
    content: AuthoredContent
    issue: issues/Issue?
    comment: issues/Comment?
    reaction: issues/Reaction?
    release: releases/Release?
    review: pulls/Review?
    -- on_merge: the pull request whose merger this is.
    pull_request: pulls/PullRequest?
    status: unlinked | linked
    linked_user: accounts/User when status = linked

    transitions status {
        unlinked -> linked
        terminal: linked
    }
}

-- An assignee named by the source who is not a local account that can be
-- assigned here. Kept by name and shown on the issue; not re-attributed.
-- decided: assignees resolving to local users with access are imported,
-- the rest kept as external names (migrations 11)
-- from: modules/migration/issue.go:27 (Assignees)
entity ExternalAssignee {
    repository: repositories/Repository
    issue: issues/Issue
    external_name: String
}

-- A repository exported to the migration archive format on disk.
-- from: services/migrations/dump.go:53
entity DumpArchive {
    directory: String
    owner_name: String
    repo_name: String
    source_kind: SourceKind
    original_url: String
    source_host: String
    -- The source repository's visibility (repo.yml is_private).
    is_private: Boolean
    includes_wiki: Boolean
    contents: Set<ContentKind>
    status: writing | complete | discarded

    transitions status {
        writing -> complete
        writing -> discarded
        terminal: complete, discarded
    }
}

------------------------------------------------------------
-- Config
------------------------------------------------------------

config {
    -- [security] IMPORT_LOCAL_PATHS (admins, or users granted the right, may
    -- import from a directory on the server)
    import_local_paths: Boolean = false
    -- [migrations] MAX_ATTEMPTS
    max_attempts: Integer = 3
    -- [migrations] RETRY_BACKOFF (seconds)
    retry_backoff: Duration = 3.seconds
    -- [migrations] ALLOWED_DOMAINS (comma-separated host globs / CIDRs; empty
    -- means "any external host")
    allowed_domains: String = ""
    -- [migrations] BLOCKED_DOMAINS
    blocked_domains: String = ""
    -- [migrations] ALLOW_LOCALNETWORKS
    allow_local_networks: Boolean = false
    -- [migrations] SKIP_TLS_VERIFY
    skip_tls_verify: Boolean = false
    -- [migrations] ALLOW_UNENCRYPTED (http:// and git:// sources)
    allow_unencrypted: Boolean = false
    -- [migrations] AVATAR_FETCH_TIMEOUT
    avatar_fetch_timeout: Duration = 60.seconds
    -- [git.timeout] MIGRATE (clone of repository and wiki)
    git_clone_timeout: Duration = 600.seconds
    -- How often a running migration checks whether it was cancelled.
    cancel_check_interval: Duration = 2.seconds
    -- Settings owned by repositories that gate an import. Repeated here
    -- (qualified config cannot be simulated); each must equal the
    -- repositories/config value of the same name.
    -- [repository] DISABLE_MIGRATIONS
    disable_migrations: Boolean = false
    -- [repository] FORCE_PRIVATE
    force_private: Boolean = false
    -- [mirror] ENABLED
    mirror_enabled: Boolean = true
    -- [mirror] DISABLE_NEW_PULL
    disable_new_pull_mirrors: Boolean = false
    -- [mirror] MIN_INTERVAL
    mirror_min_interval: Duration = 10.minutes
    -- [mirror] DEFAULT_INTERVAL
    mirror_default_interval: Duration = 8.hours
    -- [lfs] LFS_START_SERVER (LFS import is ignored while it is off)
    lfs_server_enabled: Boolean = false
    -- Domain limits users hit
    max_repo_name_length: Integer = 100
    max_description_length: Integer = 2048
    max_title_length: Integer = 255
    max_topics: Integer = 25
}

