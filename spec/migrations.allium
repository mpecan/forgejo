------------------------------------------------------------
-- Rules
------------------------------------------------------------

-- ===== Requesting a migration =====

-- A signed-in user imports a repository into their own namespace (or, as a
-- site admin, into any user's).
-- from: routers/web/repo/migrate.go:155
rule UserRequestsMigration {
    when: UserRequestsMigration(doer, owner, request)

    requires: not (exists access/InstanceWriteGate{read_only: true})   -- decided: administration 3 (read-only mode refuses every write)

    requires: not config.disable_migrations
    requires: owner = doer or doer.is_admin
    requires: not request.mirror or (config.mirror_enabled and not config.disable_new_pull_mirrors)
    -- A mirror is a git-level copy: issue tracker content is not offered.
    -- decided: content selections on a mirror import are refused as a
    -- validation error rather than silently cleared (migrations 4)
    requires: not request.mirror or request.wanted.count = 0
    -- 0 disables periodic sync; otherwise at least the minimum interval.
    requires: request.mirror_interval = 0.seconds
        or request.mirror_interval >= config.mirror_min_interval
    requires: is_valid_repo_name(request.repo_name)
    requires: length(request.repo_name) <= config.max_repo_name_length
    requires: length(request.description) <= config.max_description_length
    requires: repository_name_free(owner, request.repo_name)
    requires: doer.is_admin or within_creation_limit(owner)
    requires: quota_allows_new_repository(owner)
    -- Remote address policy
    requires: not request.address.embeds_credentials
    requires: request.address.scheme in {http, https, git, local_path}
    requires: request.address.scheme not in {http, git} or config.allow_unencrypted
    requires: request.address.scheme != local_path
        or (config.import_local_paths
            and (doer.is_admin or may_import_local_paths(doer))
            and is_existing_server_directory(request.address))
    requires: request.address.scheme = local_path or is_allowed_remote(request.address.url, doer)
    requires: request.lfs_endpoint = null or is_allowed_remote(request.lfs_endpoint.url, doer)

    ensures:
        let repository = repositories/Repository.created(
            name: request.repo_name,
            owner_user: owner,
            owner_org: null,
            description: request.description,
            website: "",
            original_url: sanitized_url(request.address),
            is_private: request.private or config.force_private,
            is_archived: false,
            is_mirror: request.mirror,
            is_fork: false,
            fork_of: null,
            is_template: false,
            generated_from: null,
            is_empty: true,
            is_fsck_enabled: not request.mirror,
            close_issues_via_commit_in_any_branch: repositories/config.default_close_issues_via_commits_in_any_branch,
            default_branch: repositories/config.default_branch,
            wiki_branch: repositories/config.default_branch,
            object_format: repositories/config.default_object_format,
            trust_model: default,
            avatar: null,
            git_size: 0,
            lfs_size: 0,
            status: being_migrated,
            created_at: now,
            updated_at: now
        )
        let migration = Migration.created(
            doer: doer,
            repository: repository,
            source: request.source,
            original_url: sanitized_url(request.address),
            source_host: request.address.host,
            from_archive: false,
            validate_archive: false,
            source_address: request.address,
            credentials: request.credentials,
            wiki: request.wiki,
            lfs: request.lfs and config.lfs_server_enabled,
            lfs_endpoint: request.lfs_endpoint,
            mirror: request.mirror,
            mirror_interval: request.mirror_interval,
            content_scope: request.wanted - (request.wanted - request.source.supports),
            imported_numbers: {},
            status: queued,
            items_processed: 0,
            created_at: now
        )
        MigrationQueued(migration: migration)

    @guidance
        -- Web: GET/POST /repo/migrate?service_type=N (form per source).
        -- API: POST /repos/migrate (repo scope token), MigrateRepoOptions.
        -- decided: the API queues like the web form; it answers at once
        -- with the pending (being_migrated) repository and the task to
        -- poll, and a failure keeps the repository (migrations 1).
        -- Credentials are submitted separately from the address; a URL with
        -- user-info is rejected outright.
}

-- Same, into an organization the doer may create repositories in.
-- decided: anyone who may create repositories in the org, on the web and
-- the API alike (migrations 2)
-- from: routers/web/repo/repo.go:86 (checkContextUser), routers/api/v1/repo/migrate.go:94
rule UserRequestsOrgMigration {
    when: UserRequestsOrgMigration(doer, org, request)

    requires: not (exists access/InstanceWriteGate{read_only: true})   -- decided: administration 3 (read-only mode refuses every write)

    requires: not config.disable_migrations
    requires: can_create_in_org(doer, org)
    requires: not request.mirror or (config.mirror_enabled and not config.disable_new_pull_mirrors)
    requires: not request.mirror or request.wanted.count = 0
    -- 0 disables periodic sync; otherwise at least the minimum interval.
    requires: request.mirror_interval = 0.seconds
        or request.mirror_interval >= config.mirror_min_interval
    requires: is_valid_repo_name(request.repo_name)
    requires: length(request.repo_name) <= config.max_repo_name_length
    requires: length(request.description) <= config.max_description_length
    requires: repository_name_free(org, request.repo_name)
    requires: doer.is_admin or within_creation_limit(org)
    requires: quota_allows_new_repository(org)
    requires: not request.address.embeds_credentials
    requires: request.address.scheme in {http, https, git, local_path}
    requires: request.address.scheme not in {http, git} or config.allow_unencrypted
    requires: request.address.scheme != local_path
        or (config.import_local_paths
            and (doer.is_admin or may_import_local_paths(doer))
            and is_existing_server_directory(request.address))
    requires: request.address.scheme = local_path or is_allowed_remote(request.address.url, doer)
    requires: request.lfs_endpoint = null or is_allowed_remote(request.lfs_endpoint.url, doer)

    ensures:
        let repository = repositories/Repository.created(
            name: request.repo_name,
            owner_user: null,
            owner_org: org,
            description: request.description,
            website: "",
            original_url: sanitized_url(request.address),
            is_private: request.private or config.force_private,
            is_archived: false,
            is_mirror: request.mirror,
            is_fork: false,
            fork_of: null,
            is_template: false,
            generated_from: null,
            is_empty: true,
            is_fsck_enabled: not request.mirror,
            close_issues_via_commit_in_any_branch: repositories/config.default_close_issues_via_commits_in_any_branch,
            default_branch: repositories/config.default_branch,
            wiki_branch: repositories/config.default_branch,
            object_format: repositories/config.default_object_format,
            trust_model: default,
            avatar: null,
            git_size: 0,
            lfs_size: 0,
            status: being_migrated,
            created_at: now,
            updated_at: now
        )
        let migration = Migration.created(
            doer: doer,
            repository: repository,
            source: request.source,
            original_url: sanitized_url(request.address),
            source_host: request.address.host,
            from_archive: false,
            validate_archive: false,
            source_address: request.address,
            credentials: request.credentials,
            wiki: request.wiki,
            lfs: request.lfs and config.lfs_server_enabled,
            lfs_endpoint: request.lfs_endpoint,
            mirror: request.mirror,
            mirror_interval: request.mirror_interval,
            content_scope: request.wanted - (request.wanted - request.source.supports),
            imported_numbers: {},
            status: queued,
            items_processed: 0,
            created_at: now
        )
        MigrationQueued(migration: migration)
}

-- ===== Running =====

-- The job queue hands the migration to a worker.
-- from: services/task/migrate.go:279
rule StartMigration {
    when: MigrationDequeued(migration)

    requires: migration.status = queued

    ensures: migration.status = running
    ensures: migration.started_at = now
    ensures: migration.stage = git
    ensures: migration.git_deadline = now + config.git_clone_timeout
    ensures: MigrationProgressed(migration: migration)
}

-- The adapter reports which stage it is in; shown as the progress message.
-- Stages run in order: git (repository, wiki, LFS, avatar), topics,
-- milestones, labels, releases (then remaining tags become releases),
-- issues (with their comments), pull requests (with comments and reviews),
-- repository-wide comments, finalizing.
-- from: services/migrations/migrate.go:151
rule ImportAdvancesStage {
    when: ImportStageReached(migration, stage)

    requires: migration.status = running

    ensures: migration.stage = stage
    ensures: migration.git_deadline = null
    ensures: migration.items_processed = 0
    ensures: MigrationProgressed(migration: migration)
}

-- Cloning the repository (or its wiki) that runs past the git timeout is
-- abandoned and the migration fails.
-- from: services/repository/migrate.go:44
rule GitCloneTimesOut {
    when: migration: Migration.git_deadline <= now

    requires: migration.status = running
    requires: migration.stage = git

    ensures: migration.status = failed
    ensures: migration.failure_reason = remote_error
    ensures: migration.message = "cloning the repository timed out"
    ensures: migration.ended_at = now
    ensures: migration.git_deadline = null
    ensures: MigrationFailed(migration: migration)
    ensures: MigrationFailureReported(kind: repository, description: migration.message)
}

-- "N issues / pull requests migrated so far".
-- from: services/migrations/migrate.go:310
rule ImportCountsItems {
    when: ImportItemsProcessed(migration, count)

    requires: migration.status = running
    requires: count >= migration.items_processed

    ensures: migration.items_processed = count
    ensures: MigrationProgressed(migration: migration)
}

-- The adapter may rewrite the clone address (e.g. to add credentials). The
-- rewritten address is re-checked; a switch from a remote source to a local
-- path is refused.
-- from: services/migrations/migrate.go:129
rule RejectRewrittenCloneAddress {
    when: SourceRewroteCloneAddress(migration, address)

    requires: migration.status = running
    requires: not migration.from_archive
    requires: not is_allowed_remote(address.url, migration.doer)
        or (address.scheme = local_path and migration.source_address.scheme != local_path)

    ensures: migration.status = failed
    ensures: migration.failure_reason = address_not_allowed
    ensures: migration.message = "the source redirected to a disallowed address"
    ensures: migration.ended_at = now
    ensures: MigrationFailed(migration: migration)
    ensures: MigrationFailureReported(kind: repository, description: migration.message)
}

-- ===== What gets imported =====

-- Topics: invalid ones dropped, the rest truncated to the per-repo limit.
-- from: services/migrations/gitea_uploader.go:192
rule ImportTopics {
    when: SourceYieldsTopics(migration, topics)

    requires: migration.status = running
    requires: migration.source.imports_topics or migration.from_archive

    let valid = valid_topics(topics)

    ensures: TopicsImported(
        repository: migration.repository,
        topics: first_n(valid, config.max_topics)
    )
}

-- A milestone without a deadline gets the far-future deadline Forgejo uses
-- for "no deadline".
-- decided: far-future deadline 9999-01-01, as Forgejo stores it (migrations 10)
-- from: services/migrations/gitea_uploader.go:208
rule ImportMilestone {
    when: SourceYieldsMilestone(migration, item)

    requires: migration.status = running

    ensures: issues/Milestone.created(
        repository: migration.repository,
        name: item.title,
        description: item.description,
        status: if item.is_closed: closed else: open,
        closed_at: item.closed_at,
        deadline: if item.deadline = null: far_future_deadline() else: item.deadline,
        created_at: first_present(item.created_at, item.updated_at, item.deadline),
        updated_at: first_present(item.updated_at, item.created_at, null)
    )
}

-- Invalid colours become white rather than failing the import.
-- from: services/migrations/gitea_uploader.go:259
rule ImportLabel {
    when: SourceYieldsLabel(migration, item)

    requires: migration.status = running

    ensures: issues/Label.created(
        repository: migration.repository,
        organization: null,
        name: item.name,
        description: item.description,
        color: if is_valid_color(item.color): normalized_color(item.color) else: "#ffffff",
        is_exclusive: item.exclusive,
        created_at: now
    )
}

-- Invalid tag / target ref names are blanked. Assets are downloaded through
-- the outbound policy and stored on this instance. Once all releases are in,
-- tags without a release get tag-only records (releases reacts to
-- RepositoryMigrated).
-- from: services/migrations/gitea_uploader.go:289
rule ImportRelease {
    when: SourceYieldsRelease(migration, item)

    requires: migration.status = running

    let publisher = resolve_author(migration, item.publisher)

    ensures:
        let release = releases/Release.created(
            repository: migration.repository,
            tag_name: if is_valid_ref_name(item.tag_name): item.tag_name else: "",
            target: if is_valid_ref_name(item.target): item.target else: "",
            title: item.name,
            note: item.body,
            publisher: publisher,
            original_author: if publisher = null: item.publisher.name else: null,
            state: if item.is_draft: draft else: published,
            is_prerelease: item.is_prerelease,
            hide_archive_links: false,
            num_commits: 0,
            created_at: first_present(item.created_at, item.published_at, null)
        )
        for asset in item.assets:
            issues/Attachment.created(
                repository: migration.repository,
                uploader: if publisher = null: ghost_user() else: publisher,
                name: asset.name,
                size: asset.size,
                issue: null,
                comment: null,
                release: release,
                external_url: null,
                download_count: asset.download_count,
                created_at: first_present(asset.created_at, release.created_at, null)
            )
        if publisher = null:
            ExternalAuthorship.created(
                repository: migration.repository,
                source_kind: migration.source.kind,
                source_host: migration.source_host,
                external_id: item.publisher.external_id,
                external_name: item.publisher.name,
                content: on_release,
                release: release,
                status: unlinked
            )
}

-- Issues keep their number, state, lock, timestamps, labels (matched by
-- name among imported labels) and milestone (matched by title); reactions
-- come along. Titles longer than the limit are truncated. Assignees that
-- are local accounts able to be assigned here are assigned; the others are
-- kept by name.
-- decided: assignees imported when they resolve to local users with access,
-- others kept as external names (migrations 11)
-- from: services/migrations/gitea_uploader.go:401
rule ImportIssue {
    when: SourceYieldsIssue(migration, item)

    requires: migration.status = running

    let author = resolve_author(migration, item.author)

    ensures: migration.imported_numbers = migration.imported_numbers + {item.number}
    ensures:
        let issue = issues/Issue.created(
            repository: migration.repository,
            index: item.number,
            poster: if author = null: ghost_user() else: author,
            title: truncate(item.title, config.max_title_length),
            content: item.content,
            content_version: 0,
            is_pull: false,
            status: if item.is_closed: closed else: open,
            closed_at: item.closed_at,
            is_locked: item.is_locked,
            ref: if is_valid_ref_name(item.ref): item.ref else: null,
            milestone: milestone_titled(migration.repository, item.milestone_title),
            labels: labels_named(migration.repository, item.label_names),
            assignees: assignable_named(migration.repository, item.assignee_names),
            created_at: first_present(item.created_at, item.closed_at, null),
            updated_at: first_present(item.updated_at, item.closed_at, null)
        )
        for name in item.assignee_names:
            if not resolves_to_assignee(migration.repository, name):
                ExternalAssignee.created(
                    repository: migration.repository,
                    issue: issue,
                    external_name: name
                )
        if author = null:
            ExternalAuthorship.created(
                repository: migration.repository,
                source_kind: migration.source.kind,
                source_host: migration.source_host,
                external_id: item.author.external_id,
                external_name: item.author.name,
                content: on_issue,
                issue: issue,
                status: unlinked
            )
        for r in item.reactions:
            ImportedReactionOn(migration: migration, issue: issue, comment: null, reaction: r)
}

-- Pull requests become an issue (is_pull) plus a pull request whose head and
-- base are both this repository. An open pull request from a fork has its
-- head branch fetched from the fork (only if the fork's clone URL shares the
-- source's base URL) into a branch "<fork owner>/<ref>"; otherwise only the
-- head commit is pinned. Drafts get the work-in-progress title prefix. A
-- merged pull request keeps its merge time, merge commit and original
-- merger: a resolved local account, else the ghost placeholder with an
-- ExternalAuthorship (on_merge) so it is re-attributed later, else (the
-- source names no merger) the ghost placeholder alone. Assignees are
-- handled as for issues. Imported pull requests are then checked for
-- mergeability like any other.
-- decided: the merger is the original merger as an external identity, not
-- the migration doer (migrations 9); assignees imported (migrations 11)
-- from: services/migrations/gitea_uploader.go:787
rule ImportPullRequest {
    when: SourceYieldsPullRequest(migration, item)

    requires: migration.status = running
    requires: item.ensured_safe

    let author = resolve_author(migration, item.author)

    ensures: migration.imported_numbers = migration.imported_numbers + {item.number}
    ensures:
        let issue = issues/Issue.created(
            repository: migration.repository,
            index: item.number,
            poster: if author = null: ghost_user() else: author,
            title: truncate(with_draft_prefix(item.title, item.is_draft), config.max_title_length),
            content: item.content,
            content_version: 0,
            is_pull: true,
            status: if item.is_closed: closed else: open,
            closed_at: item.closed_at,
            is_locked: item.is_locked,
            milestone: milestone_titled(migration.repository, item.milestone_title),
            labels: labels_named(migration.repository, item.label_names),
            assignees: assignable_named(migration.repository, item.assignee_names),
            created_at: first_present(item.created_at, item.closed_at, item.merged_at),
            updated_at: first_present(item.updated_at, item.created_at, null)
        )
        for name in item.assignee_names:
            if not resolves_to_assignee(migration.repository, name):
                ExternalAssignee.created(
                    repository: migration.repository,
                    issue: issue,
                    external_name: name
                )
        if item.merged:
            let merger = if item.merged_by = null: null else: resolve_author(migration, item.merged_by)
            let pr = pulls/PullRequest.created(
                issue: issue,
                flow: branch,
                head_repository: migration.repository,
                head_branch: imported_head_branch(item),
                base_repository: migration.repository,
                base_branch: present_or_empty(item.base.ref),
                head_commit_sha: present_or_empty(item.head.sha),
                merge_base_sha: if item.base.sha = null: merge_base_of(migration.repository, item.base.ref, item.head.sha) else: item.base.sha,
                created_at: issue.created_at,
                status: merged,
                -- the source does not say which style was used
                merge_style: merge,
                merged_commit_sha: present_or_empty(item.merge_commit_sha),
                merger: if merger = null: ghost_user() else: merger,
                merged_at: first_present(item.merged_at, issue.updated_at, null),
                merged_automatically: false,
                conflicted_files: {},
                changed_protected_files: {},
                commits_ahead: 0,
                commits_behind: 0,
                allow_maintainer_edit: false
            )
            if item.merged_by != null and merger = null:
                ExternalAuthorship.created(
                    repository: migration.repository,
                    source_kind: migration.source.kind,
                    source_host: migration.source_host,
                    external_id: item.merged_by.external_id,
                    external_name: item.merged_by.name,
                    content: on_merge,
                    pull_request: pr,
                    status: unlinked
                )
        else:
            pulls/PullRequest.created(
                issue: issue,
                flow: branch,
                head_repository: migration.repository,
                head_branch: imported_head_branch(item),
                base_repository: migration.repository,
                base_branch: present_or_empty(item.base.ref),
                head_commit_sha: present_or_empty(item.head.sha),
                merge_base_sha: if item.base.sha = null: merge_base_of(migration.repository, item.base.ref, item.head.sha) else: item.base.sha,
                created_at: issue.created_at,
                -- queued for pulls/CheckMergeability like any new pull request
                status: checking,
                check_requested_at: now,
                conflicted_files: {},
                changed_protected_files: {},
                commits_ahead: commits_ahead_of(migration.repository, imported_head_branch(item), migration.repository, present_or_empty(item.base.ref)),
                commits_behind: commits_behind_of(migration.repository, imported_head_branch(item), migration.repository, present_or_empty(item.base.ref)),
                allow_maintainer_edit: false
            )
        if author = null:
            ExternalAuthorship.created(
                repository: migration.repository,
                source_kind: migration.source.kind,
                source_host: migration.source_host,
                external_id: item.author.external_id,
                external_name: item.author.name,
                content: on_issue,
                issue: issue,
                status: unlinked
            )
        for r in item.reactions:
            ImportedReactionOn(migration: migration, issue: issue, comment: null, reaction: r)
}

-- The adapter yielded a pull request it had not validated: refused.
-- from: services/migrations/gitea_uploader.go:671
rule RefuseUnsafePullRequest {
    when: SourceYieldsPullRequest(migration, item)

    requires: migration.status = running
    requires: not item.ensured_safe

    ensures: migration.status = failed
    ensures: migration.failure_reason = invalid_source_data
    ensures: migration.message = "pull request was not checked for safety"
    ensures: migration.ended_at = now
    ensures: MigrationFailed(migration: migration)
    ensures: MigrationFailureReported(kind: repository, description: migration.message)
}

-- Comments attach to an already imported issue / pull request. Close,
-- reopen, merge and auto-merge events keep their kind but drop text. A
-- reply gets a quote header linking the parent comment.
-- from: services/migrations/gitea_uploader.go:485
rule ImportComment {
    when: SourceYieldsComment(migration, item)

    requires: migration.status = running

    requires: item.issue_number in migration.imported_numbers

    let parent = issues/Issue{repository: migration.repository, index: item.issue_number}
    let author = resolve_author(migration, item.author)

    ensures:
        let comment = issues/Comment.created(
            issue: parent,
            poster: if author = null: ghost_user() else: author,
            kind: comment_kind_named(item.kind),
            content: imported_comment_content(item),
            content_version: 0,
            created_at: first_present(item.created_at, parent.created_at, null),
            updated_at: first_present(item.updated_at, item.created_at, parent.created_at)
        )
        if author = null:
            ExternalAuthorship.created(
                repository: migration.repository,
                source_kind: migration.source.kind,
                source_host: migration.source_host,
                external_id: item.author.external_id,
                external_name: item.author.name,
                content: on_comment,
                comment: comment,
                status: unlinked
            )
        for r in item.reactions:
            ImportedReactionOn(migration: migration, issue: parent, comment: comment, reaction: r)
}

-- A comment for an issue that was not imported fails the import.
-- from: services/migrations/gitea_uploader.go:492
rule RefuseOrphanComment {
    when: SourceYieldsComment(migration, item)

    requires: migration.status = running

    requires: not (item.issue_number in migration.imported_numbers)

    ensures: migration.status = failed
    ensures: migration.failure_reason = invalid_source_data
    ensures: migration.message = "comment belongs to an issue that was not imported"
    ensures: migration.ended_at = now
    ensures: MigrationFailed(migration: migration)
    ensures: MigrationFailureReported(kind: repository, description: migration.message)
}

-- Reviews attach to an imported pull request. Code comments are kept only
-- when they carry a diff hunk and the pull request has a merge base; their
-- patch context is recomputed locally; an invalid commit id is replaced by
-- the pull request head. A code comment without its own author inherits the
-- reviewer.
-- from: services/migrations/gitea_uploader.go:911
rule ImportReview {
    when: SourceYieldsReview(migration, item)

    requires: migration.status = running

    requires: item.issue_number in migration.imported_numbers

    let conversation = issues/Issue{repository: migration.repository, index: item.issue_number}
    let reviewer = resolve_author(migration, item.reviewer)
    -- Drafts and bare review requests are not imported as reviews.
    requires: item.state in {approved, changes_requested, commented}

    ensures:
        let review = pulls/Review.created(
            pull_request: pulls/PullRequest{issue: conversation},
            reviewer: if reviewer = null: ghost_user() else: reviewer,
            status: submitted,
            kind: if item.state = approved: approve else if item.state = changes_requested: request_changes else: comment,
            body: item.content,
            commit_sha: present_or_empty(item.commit_sha),
            is_official: item.official,
            is_stale: false,
            is_dismissed: false,
            created_at: first_present(item.created_at, conversation.created_at, null),
            submitted_at: first_present(item.created_at, conversation.created_at, null)
        )
        if reviewer = null:
            ExternalAuthorship.created(
                repository: migration.repository,
                source_kind: migration.source.kind,
                source_host: migration.source_host,
                external_id: item.reviewer.external_id,
                external_name: item.reviewer.name,
                content: on_review,
                review: review,
                status: unlinked
            )
}

-- from: services/migrations/gitea_uploader.go:463
rule ImportReaction {
    when: ImportedReactionOn(migration, issue, comment, reaction)

    let author = resolve_author(migration, reaction.author)

    ensures:
        let created = issues/Reaction.created(
            user: if author = null: ghost_user() else: author,
            issue: issue,
            comment: comment,
            emoji: reaction.content,
            created_at: now
        )
        if author = null:
            ExternalAuthorship.created(
                repository: migration.repository,
                source_kind: migration.source.kind,
                source_host: migration.source_host,
                external_id: reaction.author.external_id,
                external_name: reaction.author.name,
                content: on_reaction,
                reaction: created,
                status: unlinked
            )
}

-- Data the adapter had to drop (bad SHA, bad ref, foreign clone URL) is
-- recorded for administrators; the import continues.
-- from: services/migrations/common.go:16
rule FlagDroppedSourceData {
    when: SourceDataDropped(migration, detail)

    requires: migration.status = running

    ensures: MigrationFailureReported(kind: repository, description: detail)
}

-- ===== Finishing =====

-- Success: counters recomputed, repository ready, secrets gone. A plain
-- import detaches the source remote (so no credentials survive anywhere); a
-- mirror import creates the pull mirror, which keeps the remote and its
-- credentials for future syncs.
-- from: services/task/migrate.go:229, models/admin/task.go:235
rule CompleteMigration {
    when: SourceImportFinished(migration)

    requires: migration.status = running
    -- Git data is in: the adapter has moved past the clone stage.
    requires: migration.stage != git

    let address = migration.source_address
    let creds = migration.credentials

    ensures: migration.status = finished
    ensures: migration.stage = finalizing
    ensures: migration.git_deadline = null
    ensures: migration.ended_at = now
    ensures: migration.source_address = null
    ensures: migration.credentials = null
    ensures: migration.message = null
    ensures: ImportCompleted(
        repository: migration.repository,
        remote_address: sanitized_url(address),
        has_credentials: creds.kind != anonymous,
        interval: migration.mirror_interval,
        lfs_enabled: migration.lfs,
        lfs_endpoint: url_of(migration.lfs_endpoint)
    )
    ensures: RepositoryMigrated(repository: migration.repository)
    -- Restoring an archive immediately re-attributes what it can.
    ensures:
        if migration.from_archive:
            RelinkPassRequested(scope: migration.repository)
}

-- Failure: the repository is kept (still being_migrated) so its admins can
-- read the reason, retry or delete it. The message never contains
-- credentials.
-- from: services/task/migrate.go:239
rule FailMigration {
    when: SourceImportFailed(migration, reason, detail)

    requires: migration.status = running

    ensures: migration.status = failed
    ensures: migration.failure_reason = reason
    ensures: migration.git_deadline = null
    ensures: migration.message = strip_credentials(detail)
    ensures: migration.ended_at = now
    ensures: MigrationFailed(migration: migration)
    ensures: MigrationFailureReported(
        kind: repository,
        description: migration_failure_notice(migration.original_url, strip_credentials(detail))
    )
}

-- ===== Cancel, retry, discard =====

-- A repository admin stops a migration. A running import notices within
-- config.cancel_check_interval and stops; a queued one never starts.
-- decided: queued and running migrations can both be cancelled (migrations 3)
-- from: routers/web/repo/migrate.go:296
rule RepoAdminCancelsMigration {
    when: RepoAdminCancelsMigration(admin, migration)

    requires: not (exists access/InstanceWriteGate{read_only: true})   -- decided: administration 3 (read-only mode refuses every write)

    requires: is_repo_admin(admin, migration.repository)
    requires: migration.status in {queued, running}

    ensures: migration.status = failed
    ensures: migration.failure_reason = canceled
    ensures: migration.message = "canceled"
    ensures: migration.git_deadline = null
    ensures: migration.ended_at = now
    ensures: MigrationFailed(migration: migration)

    @guidance
        -- Web: POST /{owner}/{repo}/settings/migrate/cancel (repo admin).
}

-- A repository admin, or the user who requested the migration, retries a
-- failed migration. Partially imported data is wiped first; the repository
-- record (and its name) is kept. Refused while the owner is over its
-- repository-size quota.
-- decided: the requester or a repository admin may retry (migrations 12)
-- from: services/task/task.go:138, routers/web/repo/migrate.go:270
rule RepoAdminRetriesMigration {
    when: RepoAdminRetriesMigration(admin, migration)

    requires: not (exists access/InstanceWriteGate{read_only: true})   -- decided: administration 3 (read-only mode refuses every write)

    requires: is_repo_admin(admin, migration.repository) or admin = migration.doer
    requires: migration.status = failed
    requires: quota_allows_retry(migration.repository)

    ensures: MigratedContentDiscarded(repository: migration.repository)
    ensures: migration.status = queued
    ensures: migration.failure_reason = null
    ensures: migration.ended_at = null
    ensures: migration.message = null
    ensures: migration.stage = null
    ensures: migration.items_processed = 0
    ensures: migration.imported_numbers = {}
    ensures: MigrationQueued(migration: migration)

    @guidance
        -- Web: POST /{owner}/{repo}/settings/migrate/retry (repo admin or
        -- the requester; the requester also gets it from the task status).
}

-- A repository admin gives up on a failed migration and deletes the
-- half-made repository.
-- from: templates/repo/migrate/migrating.tmpl:39
rule RepoAdminDiscardsFailedMigration {
    when: RepoAdminDiscardsFailedMigration(admin, migration)

    requires: not (exists access/InstanceWriteGate{read_only: true})   -- decided: administration 3 (read-only mode refuses every write)

    requires: is_repo_admin(admin, migration.repository)
    requires: migration.status = failed

    let repository = migration.repository

    ensures: not exists migration
    ensures: not exists repository

    @guidance
        -- Web: POST /{owner}/{repo}/settings action=delete, offered on the
        -- migrating page only once the migration failed.
}

-- Deleting the repository by any route takes the addon's records about it
-- along: its migration task, authorship records and external assignees.
-- from: services/repository/delete.go:220
rule ForgetImportRecordsOfDeletedRepository {
    when: repositories/RepositoryDeleted(repository, doer)

    ensures:
        for m in Migrations where repository = repository:
            not exists m
        for a in ExternalAuthorships where repository = repository:
            not exists a
        for e in ExternalAssignees where repository = repository:
            not exists e
}

-- ===== Re-attributing imported content =====

-- When a user links an external login whose provider speaks a forge kind,
-- every imported item authored by that external id on a source of that kind
-- at the provider's host is handed over to them. Ids are opaque strings.
-- decided: match on kind + host + external id, whatever the OAuth source is
-- named (migrations 5); non-numeric ids are re-attributed too (migrations 6)
-- from: services/externalaccount/user.go:62
rule LinkAuthorshipsOnAccountLink {
    when: login: authentication/ExternalLogin.created

    ensures:
        for a in ExternalAuthorships where status = unlinked:
            if a.source_kind = source_kind_for_provider(login.provider)
                and a.source_host = provider_host(login.source)
                and a.external_id = login.external_id:
                AuthorshipClaimed(authorship: a, user: login.user)
}

-- The nightly cron task (owned and scheduled by administration) catches
-- links made by any route, and imports that ran after the link was made.
-- from: services/migrations/update.go:17
rule NightlyRelink {
    when: administration/MigrationPosterIdUpdateDue()

    ensures: RelinkPassRequested(scope: null)
    -- The sweep is reported finished to administration, which closes the
    -- update_migration_poster_id run (its CronWorkCompleted).
    ensures: RelinkSweepCompleted(outcome: finished, message: null)
}

-- One re-attribution pass: every unlinked authorship whose source identity
-- now belongs to a local account is linked.
-- from: services/migrations/update.go:30
rule RelinkPass {
    when: RelinkPassRequested(scope)

    ensures:
        for a in ExternalAuthorships where status = unlinked:
            if linked_account_for(a.source_kind, a.source_host, a.external_id) != null and (scope = null or scope = a.repository):
                AuthorshipClaimed(authorship: a, user: linked_account_for(a.source_kind, a.source_host, a.external_id))
}

-- One authorship is claimed by the local account its source identity now
-- belongs to.
-- from: services/externalaccount/user.go:76
rule ClaimAuthorship {
    when: AuthorshipClaimed(authorship, user)

    requires: authorship.status = unlinked

    ensures: authorship.status = linked
    ensures: authorship.linked_user = user
    ensures: ExternalAuthorLinked(authorship: authorship, user: user)
}

-- The imported item is handed over: the local account becomes its author.
-- from: models/issues/issue_update.go:635
rule ReattributeImportedContent {
    when: ExternalAuthorLinked(authorship, user)

    ensures:
        if authorship.content = on_issue:
            authorship.issue.poster = user
        if authorship.content = on_comment:
            authorship.comment.poster = user
        if authorship.content = on_reaction:
            authorship.reaction.user = user
        if authorship.content = on_release:
            authorship.release.publisher = user
        if authorship.content = on_review:
            authorship.review.reviewer = user
        if authorship.content = on_merge:
            authorship.pull_request.merger = user
}

-- ===== Dump and restore =====

-- `forgejo dump-repo`: fetch a repository from a source with the same
-- adapters and write it to the archive format instead of the database. The
-- allowed/blocked-hosts policy does not apply: it guards user-initiated
-- migrations, and the operator already has the server.
-- decided: operators are exempt from the host policy (migrations 8)
-- from: services/migrations/dump.go:604, cmd/dump_repo.go:28
rule OperatorDumpsRepository {
    when: OperatorDumpsRepository(operator, request, directory)

    requires: operator.has_server_access

    ensures: DumpArchive.created(
        directory: directory,
        owner_name: request.address.host,
        repo_name: request.repo_name,
        source_kind: request.source.kind,
        original_url: sanitized_url(request.address),
        source_host: request.address.host,
        is_private: source_is_private(request),
        includes_wiki: request.wiki,
        contents: request.wanted - (request.wanted - request.source.supports),
        status: writing
    )

    @guidance
        -- Archive layout (one directory per owner/repo): repo.yml,
        -- topic.yml, milestone.yml, label.yml, release.yml with
        -- release_assets/<tag>/<name>, issue.yml, pull_request.yml,
        -- comments/<issue>.yml, reviews/<issue>.yml, git/ (bare mirror),
        -- wiki/. Units flag: wiki, issues, labels, releases, release_assets,
        -- milestones, pull_requests, comments; empty means everything.
        -- Credentials are only used to fetch and are never written.
}

-- from: services/migrations/dump.go:599
rule ArchiveWriteCompletes {
    when: ArchiveWriteCompleted(archive)

    requires: archive.status = writing

    ensures: archive.status = complete
}

-- A failed dump removes the partial directory.
-- from: services/migrations/dump.go:593
rule ArchiveWriteFails {
    when: ArchiveWriteFailed(archive)

    requires: archive.status = writing

    ensures: archive.status = discarded
}

-- `forgejo restore-repo` (through the private API): import an archive into
-- a new repository. The archive is local, so the remote-address policy does
-- not apply; validation against the archive schema is optional. The import
-- runs as the instance's first site administrator. The repository keeps the
-- archive's visibility (FORCE_PRIVATE still forces private).
-- decided: restore keeps the archive's visibility (migrations 7)
-- from: services/migrations/dump.go:667, routers/private/restore_repo.go:17
rule OperatorRestoresRepository {
    when: OperatorRestoresRepository(operator, archive, owner, repo_name, selection)

    requires: operator.has_server_access
    requires: archive.status = complete
    requires: repository_name_free(owner, repo_name)

    ensures:
        let repository = repositories/Repository.created(
            name: repo_name,
            owner_user: owner,
            owner_org: null,
            description: "",
            website: "",
            original_url: archive.original_url,
            is_private: archive.is_private or config.force_private,
            is_archived: false,
            is_mirror: false,
            is_fork: false,
            fork_of: null,
            is_template: false,
            generated_from: null,
            is_empty: true,
            is_fsck_enabled: not false,
            close_issues_via_commit_in_any_branch: repositories/config.default_close_issues_via_commits_in_any_branch,
            default_branch: repositories/config.default_branch,
            wiki_branch: repositories/config.default_branch,
            object_format: repositories/config.default_object_format,
            trust_model: default,
            avatar: null,
            git_size: 0,
            lfs_size: 0,
            status: being_migrated,
            created_at: now,
            updated_at: now
        )
        let migration = Migration.created(
            doer: first_site_admin(),
            repository: repository,
            source: profile_for(archive.source_kind),
            original_url: archive.original_url,
            source_host: archive.source_host,
            from_archive: true,
            validate_archive: selection.validate,
            source_address: archive_address(archive),
            credentials: anonymous_credentials(),
            wiki: archive.includes_wiki,
            lfs: false,
            lfs_endpoint: null,
            mirror: false,
            mirror_interval: config.mirror_default_interval,
            content_scope: if selection.units.count = 0: archive.contents else: selection.units - (selection.units - archive.contents),
            imported_numbers: {},
            status: queued,
            items_processed: 0,
            created_at: now
        )
        MigrationQueued(migration: migration)

    @guidance
        -- Private API: POST /api/internal/restore_repo with RepoDir,
        -- OwnerName, RepoName, Units, Validation. Runs synchronously in
        -- Forgejo; here it is queued like any other migration.
}

------------------------------------------------------------
-- Invariants
------------------------------------------------------------

-- One migration per repository.
invariant OneMigrationPerRepository {
    for m in Migrations:
        (Migrations where repository = m.repository).count = 1
}

-- Until it finishes, the target repository is not usable (no git access, no
-- pages other than the progress page and settings).
invariant ActiveMigrationHoldsRepository {
    for m in Migrations:
        m.is_active implies m.repository.status = being_migrated
}

-- A finished migration's repository is ready.
invariant FinishedMigrationReleasesRepository {
    for m in Migrations:
        m.status = finished implies m.repository.status = ready
}

-- Mirrors carry no issue-tracker content.
invariant MirrorsAreGitOnly {
    for m in Migrations:
        m.mirror implies m.content_scope.count = 0
}

-- Nothing is imported that the source cannot supply.
invariant ScopeWithinSourceCapabilities {
    for m in Migrations:
        m.from_archive or m.content_scope.all(c => c in m.source.supports)
}

-- An authorship record points at exactly the kind of item it describes.
invariant AuthorshipPointsAtItsContent {
    for a in ExternalAuthorships:
        (a.content = on_issue implies a.issue != null)
        and (a.content = on_comment implies a.comment != null)
        and (a.content = on_reaction implies a.reaction != null)
        and (a.content = on_release implies a.release != null)
        and (a.content = on_review implies a.review != null)
        and (a.content = on_merge implies a.pull_request != null)
}

------------------------------------------------------------
-- Actor Declarations
------------------------------------------------------------

-- Anyone signed in: access/SignedInUser.

actor MigrationRepoAdmin {
    within: Migration
    identified_by: accounts/User where is_repo_admin(this, within.repository)
}

actor MigrationRepoReader {
    within: Migration
    identified_by: accounts/User where can_read_code(this, within.repository)
}

actor MigrationRequester {
    within: Migration
    identified_by: accounts/User where this = within.doer
}

actor SourceAdapter {
    identified_by: SourceAdapterProcess where active = true
}

actor CoreHost {
    identified_by: CoreRuntime where addon_installed = true
}

actor InstanceOperator {
    identified_by: OperatorShell where has_server_access = true
}

------------------------------------------------------------
-- Surfaces
------------------------------------------------------------

-- The "New migration" page and POST /repos/migrate.
surface MigrationForm {
    facing user: access/SignedInUser

    exposes:
        for p in SourceProfiles:
            p.kind
            p.supports
            p.credential_kinds

    provides:
        UserRequestsMigration(user, owner, request)
            when not config.disable_migrations
        UserRequestsOrgMigration(user, org, request)
            when not config.disable_migrations

    @guarantee MirrorOptionHiddenWhenDisabled
        -- When new pull mirrors are disabled the mirror option is not
        -- offered; when FORCE_PRIVATE is set the private flag is forced on;
        -- the LFS option is only offered while the LFS server is enabled.

    @guarantee CredentialsNeverInAddress
        -- Username, password and token are separate inputs. Token input is
        -- only offered for sources whose profile accepts tokens.

    @guidance
        -- Web: GET /repo/migrate (source picker), GET
        -- /repo/migrate?service_type=N&org=ID&mirror=1 (per-source form),
        -- POST /repo/migrate. API: POST /repos/migrate with service one of
        -- git, github, gitea, gitlab, gogs, onedev, gitbucket, codebase,
        -- forgejo, pagure, bitbucketdc; repo_owner names the target owner.
}

-- What anyone who can read the repository sees while it is being imported
-- (the repository home page shows this instead of the code).
surface MigrationProgressPage {
    facing reader: MigrationRepoReader
    context migration: Migration

    exposes:
        migration.status
        migration.stage
        migration.items_processed
        migration.original_url

    related:
        MigrationAdministration(migration)
            when is_repo_admin(reader, migration.repository)

    timeout:
        GitCloneTimesOut

    @guarantee RepositoryInaccessibleWhileImporting
        -- While being_migrated, every repository page other than home and
        -- settings redirects home, and git clone/push is refused.
}

-- The repository admin's controls on the progress page.
surface MigrationAdministration {
    facing admin: MigrationRepoAdmin
    context migration: Migration

    exposes:
        migration.status
        migration.stage
        migration.message
        migration.original_url
        migration.items_processed

    provides:
        RepoAdminCancelsMigration(admin, migration)
            when migration.is_active
        RepoAdminRetriesMigration(admin, migration)
            when migration.status = failed
        RepoAdminDiscardsFailedMigration(admin, migration)
            when migration.status = failed
}

-- The requester's status poll (the progress page polls this).
surface MigrationTaskStatus {
    facing requester: MigrationRequester
    context migration: Migration where doer = requester

    exposes:
        migration.status
        migration.stage
        migration.items_processed
        migration.message
        migration.repository

    provides:
        RepoAdminRetriesMigration(requester, migration)
            when migration.status = failed

    @guidance
        -- API: POST /repos/migrate answers with this task and the pending
        -- repository (decided: migrations 1).
        -- Web: GET /user/task/{id} (only the requester; others get "does
        -- not exist").
}

-- The per-source adapter feeding the import.
surface SourceAdapterBoundary {
    facing adapter: SourceAdapter

    provides:
        ImportStageReached(migration, stage)
        ImportItemsProcessed(migration, count)
        SourceRewroteCloneAddress(migration, address)
        SourceYieldsTopics(migration, topics)
        SourceYieldsMilestone(migration, item)
        SourceYieldsLabel(migration, item)
        SourceYieldsRelease(migration, item)
        SourceYieldsIssue(migration, item)
        SourceYieldsPullRequest(migration, item)
        SourceYieldsComment(migration, item)
        SourceYieldsReview(migration, item)
        SourceDataDropped(migration, detail)
        SourceImportFinished(migration)
            when adapter.source_kind = migration.source.kind
        SourceImportFailed(migration, reason, detail)
            when adapter.source_kind = migration.source.kind
        ArchiveWriteCompleted(archive)
        ArchiveWriteFailed(archive)

    contracts:
        demands SourceDownloader

    @guarantee OnlyScopedContent
        -- The adapter is only asked for, and only yields, content kinds in
        -- the migration's content_scope: no milestones unless milestones are
        -- in scope, no reactions on items unless reactions are, no release
        -- assets unless release_assets are, and so on. Topics and the
        -- repository avatar are always fetched where the source has them.

    @guarantee ContentOrder
        -- Items arrive in stage order: topics, milestones, labels, releases,
        -- issues (each batch followed by its comments), pull requests (each
        -- batch followed by comments and reviews), repository-wide comments.
        -- Labels and milestones therefore exist before the issues that
        -- reference them, and issues before their comments.
}

-- What the core must provide to host the addon.
surface CoreHostBoundary {
    facing core: CoreHost

    provides:
        MigrationDequeued(migration)
            when core.addon_installed

    contracts:
        demands ImportSink
        demands ImportedIdentityResolver
        demands OutboundFetchPolicy
        demands BackgroundJobQueue

    @guarantee BeingMigratedStatus
        -- The core supports a repository status "being_migrated" that blocks
        -- git transport and all pages except home/settings, shows the
        -- addon's progress page on home, and leaves the repository visible
        -- to those who could read it.

    @guarantee GhostAndOriginalAuthor
        -- The core's issues, comments, reviews, releases and reactions can
        -- carry an original author name for content attributed to the ghost
        -- placeholder, and render it as "originally by <name> on <source>".
}

-- `forgejo dump-repo` and `forgejo restore-repo`.
surface RepositoryArchiveConsole {
    facing operator: InstanceOperator

    exposes:
        for a in DumpArchives:
            a.directory
            a.status
            a.contents

    provides:
        OperatorDumpsRepository(operator, request, directory)
        OperatorRestoresRepository(operator, archive, owner, repo_name, selection)
}

------------------------------------------------------------
-- Deferred Specifications
------------------------------------------------------------

deferred SourceDownloader.get_issues    -- see: one adapter spec per source (services/migrations/<source>.go)
deferred is_allowed_remote              -- see: OutboundFetchPolicy.AllowBlockSemantics


------------------------------------------------------------
-- Requests to other modules
------------------------------------------------------------

-- REQUEST repositories: this module creates the being_migrated Repository record itself (it needs the record to attach the Migration to) rather than emitting ImportReservesRepository; either drop ImportReservesRepository or have it return the record. Owners may be organizations.
-- REQUEST repositories/ImportFailed: a failed import must leave the repository being_migrated (not broken) so the progress page, retry and discard keep working; retry needs no repository status change. migrations does not emit ImportFailed.
-- REQUEST repositories: react to MigratedContentDiscarded(repository) by wiping imported git data, wiki, issues, pull requests and releases while keeping the record.
-- REQUEST repositories: react to TopicsImported(repository, topics) by replacing the repository's topics.
-- REQUEST repositories: deleting a repository by any route also removes its migrations/Migration and ExternalAuthorship records.
-- REQUEST repositories/is_valid_repo_name, repository_name_free, within_creation_limit: exported as callable predicates (currently local black boxes).
-- REQUEST repositories: use migrations/is_allowed_remote(url, user) for mirror remotes (already requested the other way round; this module exposes it as a black box backed by OutboundFetchPolicy).
-- REQUEST accounts: a shared ghost placeholder account (ghost_user()) that unattributed imported content points at.
-- REQUEST accounts/User.allow_import_local (read through may_import_local_paths(user)): per-user right to import from server paths.
-- REQUEST authentication: linked_account_for(source_kind, host, external_id) — the local account holding an ExternalLogin whose provider speaks that source kind, whose source authenticates against that host (provider_host(source): custom URL host, or the public host such as github.com / gitlab.com) and whose external_id equals it as a string; also source_kind_for_provider(provider). The OAuth source's name plays no part (decided: migrations 5, 6).
-- REQUEST issues/Issue, issues/Comment, issues/Reaction: render "originally by <name> on <source>" when a migrations/ExternalAuthorship points at the item (the core keeps no import fields of its own). (pulls/Review: done, pulls PullRequestPage guidance.)
-- REQUEST quota: quota_account_of(user or org) and quota_account_of_owner(repository) helpers to reach the QuotaAccount for gate_migrate_repository / gate_retry_migration.
-- REQUEST administration: dispatch MigrationPosterIdUpdateDue() (already done) — migrations reacts with NightlyRelink; report completion via CronWorkCompleted needs the task, so administration should treat the run as finished once the trigger is handled.
-- REQUEST releases: react to RepositoryMigrated(repository) (already done) — imported releases arrive first, remaining tags become tag-only records.
-- REQUEST webhooks / notifications: react to migrations/RepositoryMigrated(repository) (webhooks currently listens to repositories/RepositoryMigrated, which nobody emits) as a repository-created event; the actor is migrations/Migration{repository}.doer.
-- REQUEST issues/Issue: show migrations/ExternalAssignee names alongside the assignees; expose assignable_named(repository, names) / resolves_to_assignee(repository, name) over can_be_assigned (decided: migrations 11).
-- REQUEST repositories: deleting a repository also removes its migrations/ExternalAssignee records.
-- REQUEST webhooks: migrations imports repositories only, never stored webhooks, so mapping Forgejo `gitea` / `gogs` hooks onto `forgejo` belongs to whichever addon imports instance data (webhooks 10), not here.
-- REQUEST administration: react to migrations/RelinkSweepCompleted(outcome, message) by closing the update_migration_poster_id run as CronWorkCompleted does (supersedes the line above about treating the run as finished on dispatch).
-- REQUEST repositories: the removal of the addon's records on deletion is now done here (ForgetImportRecordsOfDeletedRepository on repositories/RepositoryDeleted); the two "deleting a repository ... removes its migrations/..." lines above can be dropped.
